<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.61.0</Version>
    <Product>Lab Control Bridge</Product>
    <!-- The desktop app references this project (build-only) and publishes itself
         framework-dependent. A RID passed on the publish command line flows into this
         project too, and an Exe with a RID would otherwise default to self-contained,
         which the SDK refuses to let a framework-dependent app reference (NETSDK1151).
         The bridge is deployed framework-dependent anyway (its LabBridge payload is
         the .dll + .deps.json + .runtimeconfig.json), so pin it explicitly. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VotschVc3.Core\VotschVc3.Core.csproj" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="bridge.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ten istý dôvod ako v aplikácii: bežiaci agent zamyká vlastný build výstup.
       Ukonči iba proces spustený presne z $(OutDir), nič iné. -->
  <Target Name="StopRunningBridgeAgent" BeforeTargets="PrepareForBuild"
          Condition="'$(OS)' == 'Windows_NT' AND Exists('$(OutDir)$(AssemblyName).exe')">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\Stop-BridgeAgent.ps1&quot; -Path &quot;$(OutDir)$(AssemblyName).exe&quot;"
          ContinueOnError="true" StandardOutputImportance="high" />
  </Target>
</Project>
