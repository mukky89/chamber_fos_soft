<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>VotschVc3.Core</RootNamespace>
    <AssemblyName>VotschVc3.Core</AssemblyName>
  </PropertyGroup>

  <!-- Production FBG calibration uses the parallel minimum-time/WIKA/FBG gate implementation. -->
  <ItemGroup>
    <Compile Remove="Calibration\CalibrationOrchestrator.cs" />
    <Compile Remove="Calibration\CalibrationProfileRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
