<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         Vector icon library — outline (stroked) glyphs on a 24×24 grid, in
         the thin, rounded style modern dashboards use. Every icon is an
         *open* path drawn with a pen, not a filled silhouette, which is why
         they stay light and legible on the dark theme even at 16 px.

         Use as button/label content:

             <StackPanel Orientation="Horizontal">
                 <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Edit}" />
                 <TextBlock Style="{StaticResource IconLabel}" Text="Upraviť" />
             </StackPanel>

         The stroke follows the owning Button's Foreground, so icons recolour
         on hover / disabled exactly like the text label next to them.

         Adding an icon: draw it on the same 24×24 grid, keep the shape open
         (no filled areas), and stay roughly 2 units away from the edges so it
         optically matches the rest.
         ================================================================== -->

    <!-- Base icon glyph: 16×16, scaled uniformly, coloured from the parent Button.
         Fill stays transparent – these are outlines; round caps and joins are what
         gives them the soft, drawn look instead of a technical wireframe. -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- Transport glyphs (play / pause / stop / skip) on a device card stay solid:
         a run control has to read as a single filled shape from a step back, which is
         also how every media control is drawn. -->
    <Style x:Key="TransportIcon" TargetType="Path">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- Label sitting next to an icon inside a button.  The explicit binding is
         important: the global TextBlock style sets its own Foreground, which otherwise
         wins over WPF property inheritance and made labels on accent buttons unreadable. -->
    <Style x:Key="IconLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

