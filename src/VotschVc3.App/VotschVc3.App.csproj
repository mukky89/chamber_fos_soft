<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VotschVc3.App</RootNamespace>
    <AssemblyName>VotschVc3.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!--
      Versioning policy:
      - 1.76 is the product/version line.
      - The patch number is generated from the Git commit count, so every new
        commit produces a newer application version automatically.
      - 98 is only a fallback for source archives/build environments without Git metadata.
    -->
    <VersionPrefix>1.76</VersionPrefix>
    <VersionFallbackRevision>142</VersionFallbackRevision>
    <Version>$(VersionPrefix).$(VersionFallbackRevision)</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <Product>Riadenie laboratórnych zariadení</Product>
  </PropertyGroup>

  <!-- Resolve the final application version as late as possible, immediately before
       SDK assembly attributes are generated. This keeps local builds, dotnet run and
       CI builds on the exact same automatic versioning rule. -->
  <Target Name="SetAutomaticGitVersion" BeforeTargets="GenerateAssemblyInfo">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitRevisionOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitRevisionExitCode" />
    </Exec>

    <Exec Command="git rev-parse --short=8 HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitHashOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitHashExitCode" />
    </Exec>

    <PropertyGroup>
      <GitRevision Condition="'$(_GitRevisionExitCode)' == '0' and '@(_GitRevisionOutput)' != ''">@(_GitRevisionOutput)</GitRevision>
      <GitRevision Condition="'$(GitRevision)' == ''">$(VersionFallbackRevision)</GitRevision>
      <GitShortHash Condition="'$(_GitHashExitCode)' == '0' and '@(_GitHashOutput)' != ''">@(_GitHashOutput)</GitShortHash>

      <Version>$(VersionPrefix).$(GitRevision)</Version>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion Condition="'$(GitShortHash)' != ''">$(Version)+g$(GitShortHash)</InformationalVersion>
      <InformationalVersion Condition="'$(GitShortHash)' == ''">$(Version)</InformationalVersion>
    </PropertyGroup>

    <Message Importance="High" Text="VotschVc3.App version: $(Version) ($(InformationalVersion))" />
  </Target>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Compile Remove="Views\CalibrationWindow.OperatorUxV6.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VotschVc3.Core\VotschVc3.Core.csproj" />
    <ProjectReference Include="..\VotschVc3.Agent\VotschVc3.Agent.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <Target Name="StopRunningBridgeAgent" BeforeTargets="CopyBridgeAgent"
          Condition="'$(OS)' == 'Windows_NT' AND Exists('$(OutDir)LabBridge\VotschVc3.Agent.exe')">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\Stop-BridgeAgent.ps1&quot; -Path &quot;$(OutDir)LabBridge\VotschVc3.Agent.exe&quot;"
          ContinueOnError="true" StandardOutputImportance="high" />
  </Target>

  <Target Name="CopyBridgeAgent" AfterTargets="Build">
    <ItemGroup>
      <BridgeAgentFiles Include="..\VotschVc3.Agent\bin\$(Configuration)\net8.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeAgentFiles)"
          DestinationFiles="@(BridgeAgentFiles->'$(OutDir)LabBridge\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="seed-profiles.zip" LogicalName="seed-profiles.zip" />
    <EmbeddedResource Include="seed-profiles-manifest.json" LogicalName="seed-profiles-manifest.json" />
    <EmbeddedResource Include="..\VotschVc3.Agent\bridge.example.json" LogicalName="bridge.example.json" />
  </ItemGroup>
</Project>
