<Window x:Class="VotschVc3.App.Views.Cth7000DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIKA CTH7000 — RAW USB debug"
        Width="1320" Height="900" MinWidth="1050" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / safety notice -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="#553A2A13" BorderBrush="#FFB7791F"
                        BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="14,0,0,0">
                    <TextBlock Foreground="#FFF6C56B" FontFamily="Segoe UI Semibold" FontSize="12"
                               Text="RAW režim: po otvorení COM sa NEODOŠLE žiadny príkaz." />
                </Border>
                <StackPanel>
                    <TextBlock Text="WIKA CTH7000 — RAW USB / SCPI debug" FontSize="20" FontFamily="Segoe UI Semibold" />
                    <TextBlock x:Name="DeviceText" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Účel: krok po kroku zistiť, po ktorom presnom TX sa prístroj prestane ozývať. Bez automatického IDN, REMOTE, retry alebo reconnectu." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Serial configuration -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Baud" Style="{StaticResource Label}" />
                    <ComboBox x:Name="BaudCombo" SelectedIndex="0">
                        <ComboBoxItem Content="9600" />
                        <ComboBoxItem Content="19200" />
                        <ComboBoxItem Content="38400" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="DTR" Style="{StaticResource Label}" />
                    <CheckBox x:Name="DtrCheck" Content="Enabled" IsChecked="True" VerticalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="RTS" Style="{StaticResource Label}" />
                    <CheckBox x:Name="RtsCheck" Content="Enabled" IsChecked="True" VerticalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Terminator" Style="{StaticResource Label}" />
                    <ComboBox x:Name="TerminatorCombo" SelectedIndex="0">
                        <ComboBoxItem Content="CR" />
                        <ComboBoxItem Content="CRLF" />
                        <ComboBoxItem Content="LF" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Delay / znak (ms)" Style="{StaticResource Label}" />
                    <ComboBox x:Name="InterDelayCombo" SelectedIndex="2">
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="25" />
                        <ComboBoxItem Content="50" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="RX timeout (ms)" Style="{StaticResource Label}" />
                    <ComboBox x:Name="TimeoutCombo" SelectedIndex="4">
                        <ComboBoxItem Content="500" />
                        <ComboBoxItem Content="1000" />
                        <ComboBoxItem Content="2000" />
                        <ComboBoxItem Content="4000" />
                        <ComboBoxItem Content="8000" />
                        <ComboBoxItem Content="12000" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,10,0">
                    <CheckBox x:Name="PurgeBeforeSendCheck" Content="Pred query zahodiť staré RX dáta" IsChecked="True" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="8 data bits · parity none · 1 stop bit · flow control none" />
                </StackPanel>
                <Button x:Name="PaliPresetButton" Grid.Column="7" VerticalAlignment="Bottom"
                        Content="Pali / AutoOptical preset" Click="PaliPreset_Click" Padding="10,6" Margin="4,0,0,0"
                        ToolTip="Nastaví parametre podľa pôvodného AutoOptical WikaTempProbe.py: 9600, CR, 25 ms medzi bajtmi. DTR/RTS zostanú aktívne, hardware flow control je vypnutý." />
            </Grid>
        </Border>

        <!-- Manual command buttons -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="OpenButton" Content="1  Otvoriť COM" Style="{StaticResource AccentButton}" Click="Open_Click" />
                        <Button x:Name="PurgeButton" Content="Purge RX/TX" Click="Purge_Click" IsEnabled="False" />
                        <Button x:Name="ListenButton" Content="Listen 2 s" Click="Listen_Click" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="EmergencyButton" Content="LOCAL + zavrieť COM" Style="{StaticResource DangerButton}"
                                Click="Emergency_Click" IsEnabled="False"
                                ToolTip="Best-effort odošle SYSTEM:LOCAL s vybraným terminátorom a potom port zavrie." />
                        <Button x:Name="HardCloseButton" Content="Hard close" Click="HardClose_Click" IsEnabled="False"
                                ToolTip="Zavrie COM bez odoslania ďalších dát." />
                    </StackPanel>
                </DockPanel>

                <Separator Margin="0,10,0,9" Background="{StaticResource BorderBrush}" />

                <WrapPanel>
                    <Button x:Name="IdnButton" Content="2  *IDN?" Style="{StaticResource AccentButton}" Click="Idn_Click" IsEnabled="False"
                            ToolTip="Najprv testuj iba identifikáciu. Ak neodpovie, nepokračuj na REMOTE." />
                    <Button x:Name="RemoteButton" Content="3  SYSTEM:REMOTE" Click="Remote_Click" IsEnabled="False" />
                    <Button x:Name="MeasureAButton" Content="4A  MEASURE:CHANNEL? 1" Click="MeasureA_Click" IsEnabled="False" />
                    <Button x:Name="MeasureBButton" Content="4B  MEASURE:CHANNEL? 2" Click="MeasureB_Click" IsEnabled="False" />
                    <Button x:Name="LocalButton" Content="5  SYSTEM:LOCAL" Click="Local_Click" IsEnabled="False" />
                </WrapPanel>

                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Bežný RAW test: Open → *IDN? → až keď IDN odpovie, SYSTEM:REMOTE → Measure A → SYSTEM:LOCAL." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="#FFF6C56B"
                           Text="AutoOptical/Pali porovnávací test po fyzickom resete: klikni Pali preset → Open → SYSTEM:REMOTE → počkaj aspoň 1 s → Measure A → SYSTEM:LOCAL. V pôvodnom kóde sa pri bežnom meraní *IDN? neposielalo." />
            </StackPanel>
        </Border>

        <!-- Raw transcript -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,7">
                    <TextBlock DockPanel.Dock="Left" Text="RAW transcript — ASCII + HEX + timing" Style="{StaticResource Heading}" />
                    <Button DockPanel.Dock="Right" Content="Vyčistiť" Click="Clear_Click" Padding="8,3" />
                    <Button DockPanel.Dock="Right" Content="Kopírovať celý log" Click="Copy_Click" Padding="8,3" Margin="0,0,7,0" />
                </DockPanel>
                <TextBox x:Name="TranscriptBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="12.5" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource BackgroundBrush}" Padding="10" />
            </Grid>
        </Border>

        <!-- Custom command -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Vlastný SCPI príkaz" Style="{StaticResource Label}" />
                    <TextBox x:Name="CustomCommandBox" FontFamily="Consolas" Text="*IDN?" MinHeight="31" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,5,0,0" Text="RAW debug pripravený. COM ešte nie je otvorený." />
                </StackPanel>
                <CheckBox x:Name="CustomExpectResponseCheck" Grid.Column="1" Content="Čakať RX" IsChecked="True"
                          VerticalAlignment="Center" Margin="12,18,12,0" />
                <Button x:Name="CustomSendButton" Grid.Column="2" Content="Odoslať RAW" Style="{StaticResource AccentButton}"
                        VerticalAlignment="Center" Margin="0,18,0,0" Click="CustomSend_Click" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
