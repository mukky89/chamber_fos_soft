<Window x:Class="VotschVc3.App.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VotschVc3.App.Views"
        Title="{Binding SelectedChamber.Config.Name, StringFormat=FBG kalibrácia · {0}}"
        Height="940" Width="1500" MinHeight="700" MinWidth="1080"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <!-- Run controls stay solid glyphs, like the transport buttons on a device card. -->
        <Style x:Key="RunGlyph" TargetType="Path" BasedOn="{StaticResource TransportIcon}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>
        <SolidColorBrush x:Key="CalibrationPendingRowBrush" Color="#FF302837" />
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header: what this window is + what you can do with it =====
             The run controls are one group, set apart from "Uložiť zapojenie" so a stop is
             never a neighbour of a save. -->
        <StackPanel Grid.Row="0">
            <Border Margin="6,0,6,8" Padding="10" CornerRadius="7" Background="#332919" BorderBrush="#E8AA42" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="?" FontWeight="Bold" FontSize="18" Margin="12,0"
                                   ToolTip="Voliteľný dohľad pre tento beh. Pri timeoute WIKA, strate dát alebo nepotvrdenej odozve sa postup pozastaví a odošle jeden e-mail pre danú udalosť. Operátor má 30 minút na rozhodnutie; potom sa uloží beh a odošle STOP komore. Predĺženie pridá 15/30 minút. Nový pokus obnoví meranie rozpracovaných senzorov. Po rozhodnutí sa WIKA a rozpracované meracie okná overia odznova. Preskočenie nie je úspešná kalibrácia. Ak je trace log zapnutý, pokračuje aj počas čakania. Pri chybe komunikácie sú dostupné nový pokus a STOP; predĺženie platí pre WIKA/FBG. Timeout samotnej wavelength po vyčerpaní stabilizácie automaticky spustí finálny odber s problémovým označením, bez čakania na rozhodnutie. Dohľad vyžaduje zapnuté e-maily kalibrácie a adresáta v Administrácii. Každé rozhodnutie a jeho dôvod sa uložia." />
                        <CheckBox Content="Operátorský dohľad – pri probléme vyžadovať moje rozhodnutie"
                                  IsChecked="{Binding OperatorSupervisionEnabled}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}"
                                  FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0"
                               Visibility="{Binding OperatorSupervisionEnabled, Converter={StaticResource BoolToVisibility}}">
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="9" Background="#554321" Margin="0,0,9,0">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,2 L21,6 L21,12 C21,17 17,21 12,23 C7,21 3,17 3,12 L3,6 Z"
                                          Stroke="#FFD27D" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                    <Path Data="M12,7 L12,13 M12,17 L12,17.2" Stroke="#FFD27D" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{Binding OperatorSupervisionLabel}" Foreground="#FFD27D" FontWeight="Bold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>                    <Border Margin="0,8,0,0" Padding="12" CornerRadius="6" Background="#54262D" BorderBrush="#FF6474" BorderThickness="2"
                            Visibility="{Binding HasOperatorDecision, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                <TextBlock views:StatusCheckIcons.Source="{Binding OperatorDecisionMessage}" TextWrapping="Wrap" Foreground="#FFFFFF" FontWeight="SemiBold" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding OperatorDecisionCountdown}" Foreground="#FFD27D" FontWeight="Bold" Margin="0,6" TextWrapping="Wrap" />
                            <DockPanel>
                                <TextBlock Text="Dôvod rozhodnutia (povinný):" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="OperatorDecisionReasonInput" Text="{Binding OperatorDecisionReason, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" IsEnabled="{Binding HasOperatorDecision}" IsReadOnly="False" ToolTip="Povinný dôvod pre predĺženie, nový pokus alebo preskočenie. Napríklad: Predlžujem čas na dokončenie stability WIKA." />
                            </DockPanel>
                            <TextBlock Text="Vyplňte dôvod vyššie — sprístupní predĺženie, nový pokus a preskočenie. STOP je dostupný aj bez dôvodu." TextWrapping="Wrap" Foreground="#FFD27D" Margin="0,5,0,0" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Predĺžiť o 15 min" Command="{Binding ExtendOperator15Command}" Margin="0,0,8,0" />
                                <Button Content="Predĺžiť o 30 min" Command="{Binding ExtendOperator30Command}" Margin="0,0,8,0" />
                                <Button Content="Nový pokus" Command="{Binding RetryOperatorCommand}" Margin="0,0,8,0" />
                                <Button Content="Preskočiť – nepotvrdené" Command="{Binding SkipOperatorCommand}" Margin="0,0,8,0" />
                                <Button Content="Ukončiť a STOP komory" Command="{Binding StopOperatorCommand}" Style="{StaticResource DangerButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        <DockPanel Margin="6,4,6,12">
            <StackPanel DockPanel.Dock="Left" MaxWidth="310" Margin="0,0,16,0">
                <TextBlock Text="FBG teplotná kalibrácia" FontSize="24" FontFamily="Segoe UI Semibold" />
                <TextBlock Text="Live prehľad kalibračného procesu"
                           Style="{StaticResource Caption}" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse Width="7" Height="7" Fill="{Binding SetupSaveColor}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding SetupSaveStatus}" Foreground="{Binding SetupSaveColor}"
                               VerticalAlignment="Center" FontSize="12" ToolTip="{Binding SetupSaveDetail}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding SaveSetupCommand}"
                            Margin="5,0,0,0" Padding="7" ToolTip="{Binding SetupSaveDetail}"
                            AutomationProperties.Name="Uložiť zapojenie okamžite">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" />
                    </Button>
                </StackPanel>

                <!-- Run controls, visually one block. -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="5,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding StartCalibrationCommand}" Margin="0,0,6,0"
                                Visibility="{Binding HasResumableCalibration, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                ToolTip="Spustí kalibračný beh: komora prejde plata a pri každom sa čaká na stabilnú vlnovú dĺžku.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource RunGlyph}" Data="{StaticResource Icon.Play}" />
                                <TextBlock Text="Spustiť kalibráciu" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ResumeCalibrationCommand}" Margin="0,0,6,0"
                                Visibility="{Binding HasResumableCalibration, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{Binding ResumeCalibrationDetail}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource RunGlyph}" Data="{StaticResource Icon.Play}" />
                                <TextBlock Text="{Binding ResumeCalibrationLabel}" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding PauseResumeCommand}" Margin="0,0,6,0"
                                ToolTip="Pozastaví alebo obnoví prebiehajúci beh.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource RunGlyph}" Data="{StaticResource Icon.Pause}" />
                                <TextBlock Text="Pauza" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ForceNextStepCommand}" Margin="0,0,6,0"
                                ToolTip="Vynechá čakanie na stabilitu iba pre aktuálne plato a pokračuje na stabilizáciu FBG. Akcia sa zapíše ako upozornenie do výsledku.">
                            <TextBlock Text="Vynútiť ďalší krok" Style="{StaticResource IconLabel}" />
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding StopCalibrationCommand}" Margin="0"
                                ToolTip="{Binding StopCalibrationDetail}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource RunGlyph}" Data="{StaticResource Icon.Stop}" />
                                <TextBlock Text="{Binding StopCalibrationLabel}" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Button Content="Ukončiť a začať odznova" Command="{Binding ResetCalibrationCommand}" Style="{StaticResource AccentOutlineButton}" Margin="10,0,0,0" Padding="12,8" ToolTip="Zastaví komoru a zruší pokračovanie rozpracovaného behu. Merania zostanú v histórii; nový beh začne od prvého bodu." />
                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="12,8"
                        Click="CloseButton_Click" ToolTip="Skryje okno. Prebiehajúca kalibrácia a pripojené zariadenia zostanú aktívne.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}" />
                        <TextBlock Text="Zavrieť" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </DockPanel>

        </StackPanel>
        <Border Grid.Row="2" Margin="6,0,6,8" Padding="10,6" CornerRadius="7"
                Background="#15283A" BorderBrush="#315477" BorderThickness="1"
                Visibility="{Binding HasResumableCalibration, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                        Command="{Binding ApplyCurrentDefaultsToResumeCommand}" Margin="12,0,0,0" Padding="10,5"
                        ToolTip="Po potvrdení nahradí pôvodný snapshot aktuálnymi administrátorskými predvoľbami. Dokončené plata a zapojenie zostanú zachované.">
                    <TextBlock Text="Použiť aktuálne predvoľby" Style="{StaticResource IconLabel}" />
                </Button>
                <TextBlock Text="OBNOVA KALIBRÁCIE" Foreground="#7DBDFF" FontSize="10" FontWeight="SemiBold"
                           Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ResumeCalibrationDetail}" TextWrapping="Wrap" Foreground="#D8E9FC"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ===== Zostava: čo sa kalibruje, čím sa meria a proti čomu =====
             Three boxed groups instead of one row of loose controls: the previous layout put
             the connect button in its own grid column, which left a hand-sized hole in the
             middle of the card and made nothing look like it belonged together. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="6,0,6,10">
            <StackPanel>
                <TextBlock Text="Zostava kalibrácie" Style="{StaticResource Heading}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <!-- ① Čo sa kalibruje -->
                    <Border Grid.Column="0" Style="{StaticResource PanelGroup}">
                        <StackPanel>
                            <TextBlock Text="Profil a komora" Style="{StaticResource Heading}" />
                            <StackPanel Style="{StaticResource FieldStack}" Margin="0,8,0,9">
                                <TextBlock Text="Kalibračný profil" Style="{StaticResource Label}" />
                                <views:ProfilePicker ItemsSource="{Binding Profiles}"
                                                     SelectedProfile="{Binding SelectedProfile, Mode=TwoWay}"
                                                     Placeholder="Vyber kalibračný profil"
                                                     ToolTip="Vyber teplotný profil – v náhľade uvidíš graf, rozsah, celkový čas a podrobný prehľad plat. Kalibračné body sú jeho plata." />
                                <Border Background="#10243A" BorderBrush="#315477" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,7,0,0">
                                    <StackPanel>
                                        <DockPanel><TextBlock Text="HISTÓRIA PROFILU" Foreground="#7DBDFF" FontSize="10" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="● LIVE ODHAD" Foreground="#55D6A7" FontSize="9"/></DockPanel>
                                        <TextBlock Text="{Binding ProfileUsageSummary}" Foreground="#D8E9FC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ProfileDurationSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Komora" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Chambers}" SelectedItem="{Binding SelectedChamber}"
                                          DisplayMemberPath="DisplayName" MinHeight="32" IsEnabled="False"
                                          ToolTip="Toto kalibračné okno patrí iba tomuto zariadeniu. Inú komoru otvor cez jej vlastné tlačidlo FBG Kalibrácia." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ② Čím sa merajú vlnové dĺžky -->
                    <Border Grid.Column="2" Style="{StaticResource PanelGroup}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="PeakLogger (interrogátor)" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                                <CheckBox DockPanel.Dock="Right" Content="Simulátor" IsChecked="{Binding UseSimulator}"
                                          VerticalAlignment="Center" FontSize="12"
                                          ToolTip="Beh bez pripojeného prístroja – generuje vlnové dĺžky podľa zvoleného scenára." />
                            </DockPanel>

                            <StackPanel Style="{StaticResource FieldStack}" Margin="0,8,0,9"
                                        Visibility="{Binding UseSimulator, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Scenár simulátora" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding SimulatorScenarios}" SelectedItem="{Binding SimulatorScenario}" MinHeight="30" />
                            </StackPanel>

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding UseSimulator, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding PeakLoggerHost, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding PeakLoggerPort, UpdateSourceTrigger=LostFocus}" MinHeight="30" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,7,0,0"
                                        Visibility="{Binding UseSimulator, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Vyhľadať API" Style="{StaticResource GhostButton}"
                                            Margin="7,0,0,0" Padding="9,4" Command="{Binding DiscoverPeakLoggerApisCommand}"
                                            ToolTip="Na localhoste preverí všetky aktívne TCP porty z Windows a rezervných 64 portov od zadanej hodnoty. Hľadá /api/v1/peaks aj staršie /peaks." />
                                    <ComboBox ItemsSource="{Binding PeakLoggerInstances}"
                                              SelectedItem="{Binding SelectedPeakLoggerInstance, Mode=TwoWay}"
                                              DisplayMemberPath="Display" MinHeight="30"
                                              ToolTip="Vyber nájdenú PeakLogger API inštanciu; host a port sa doplnia automaticky." />
                                </DockPanel>
                                <TextBlock Text="{Binding PeakLoggerDiscoverySummary}" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding PeakLoggerStatus}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="8,5"
                                        Command="{Binding RefreshSensorsCommand}"
                                        ToolTip="Znovu načítať PeakLogger zariadenia, kanály a peaky">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Content="Pripojiť" Style="{StaticResource AccentButton}" Margin="0"
                                        Command="{Binding ConnectPeakLoggerCommand}"
                                        ToolTip="Pripojí PeakLogger a načíta jeho kanály a peaky." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ③ Proti čomu sa kalibruje -->
                    <Border Grid.Column="4" Style="{StaticResource PanelGroup}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding ReferenceThermometerTitle}" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3" Margin="0"
                                        Command="{Binding RefreshF100PortsCommand}"
                                        ToolTip="Znovu načíta USB/sériové porty a dostupné referenčné teplomery.">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Content="USB diagnostika" Style="{StaticResource GhostButton}"
                                        Padding="8,3" Margin="0,0,6,0" Command="{Binding ToggleUsbDiagnosticsCommand}"
                                        ToolTip="Zobrazí COM porty, stav USB/PnP zariadenia, ovládač a Windows chybový kód." />
                            </DockPanel>
                            <StackPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding SelectedF100.DeviceTypeLabel}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SelectedF100.Identity, StringFormat=Identifikácia: {0}}"
                                           Style="{StaticResource Caption}" ToolTip="Úplná odpoveď zariadenia na príkaz *IDN?" />
                            </StackPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Port" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding F100Devices}" SelectedItem="{Binding SelectedF100, Mode=TwoWay}"
                                              DisplayMemberPath="Display" MinHeight="32"
                                              ToolTip="USB COM port vybraného referenčného teplomera." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kanál sondy" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding F100Channels}" SelectedItem="{Binding SelectedF100Channel, Mode=TwoWay}"
                                              MinHeight="32" ToolTip="Automaticky zistený fyzický vstup sondy; v prípade potreby ho môžeš zmeniť na A alebo B." />
                                </StackPanel>
                                <Button Grid.Column="4" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="0"
                                        Command="{Binding CheckF100Command}"
                                        ToolTip="Pripojí vybraný USB teplomer, identifikuje model a načíta čerstvú teplotu z dostupnej sondy.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Thermometer}" />
                                        <TextBlock Text="Načítať teplotu" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Content="Odpojiť teplomer" Command="{Binding SelectedF100.DisconnectCommand}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0"
                                    ToolTip="Uvoľní COM port pre inú aplikáciu a vypne automatické pripájanie aj po reštarte. Pripojenie obnovíte tlačidlom Načítať teplotu. Priradenie ku komore zostane zachované." />
                            <!-- Live reference reading: the number the whole calibration is measured
                                 against, so it gets Metric weight and its own row. -->
                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Referenčná teplota" Style="{StaticResource Caption}" />
                                    <TextBlock FontSize="26" FontFamily="Segoe UI Light">
                                        <Run Text="{Binding SelectedF100.Temperature, Mode=OneWay, TargetNullValue=—, StringFormat={}{0:F3}}" />
                                        <Run Text=" °C" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedF100.ConnectionState, TargetNullValue=Teplomer nie je vybraný}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding F100ChartButtonText}" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Bottom" Margin="0"
                                        Command="{Binding ToggleF100ChartCommand}"
                                        ToolTip="Zobrazí/skryje priebeh teploty nameranej WIKA CTH7000 v čase." />
                            </DockPanel>

                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="9" Margin="0,9,0,0"
                                    Visibility="{Binding ShowUsbDiagnostics, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,7">
                                        <Button Content="Znovu analyzovať" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                Command="{Binding AnalyzeUsbCommand}" />
                                        <Button Content="Pasívny test starého teplomera" Style="{StaticResource AccentOutlineButton}" Margin="0,0,6,0"
                                                Command="{Binding DiagnoseF100TalkOnlyCommand}"
                                                ToolTip="Nanovo načíta USB/COM porty a iba počúva talk-only dáta pri 4800/9600/19200 bd. Do F100 neodošle ani jeden príkaz. Test môže trvať približne 10 sekúnd." />
                                        <Button Content="Vynútiť pripojenie" Style="{StaticResource AccentOutlineButton}" Margin="0,0,10,0"
                                                Command="{Binding ForceReconnectF100Command}"
                                                ToolTip="Zatvorí spojenie tejto aplikácie, znovu otvorí vybraný COM port a skúsi načítať WIKA CTH7000." />
                                        <TextBox Width="72" Text="{Binding ManualF100Port, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" ToolTip="Ručný COM port, napríklad COM4." />
                                        <Button Content="Pridať port" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                                Command="{Binding AddManualF100PortCommand}" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding UsbDiagnostics}" MaxHeight="210">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                           TextWrapping="WrapWithOverflow" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="WIKA CTH7000: aplikácia automaticky identifikuje zariadenie a nájde sondu na vstupe A alebo B. Ak je port obsadený, zatvor inú aplikáciu používajúcu rovnaký COM port. Pasívny Talk Only test je určený iba pre staršie pasívne teplomery."
                                               Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Reference-temperature trace, folded away until the operator asks for it. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="6,0,6,10"
                Visibility="{Binding ShowF100Chart, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Priebeh USB referenčnej teploty"
                               Style="{StaticResource Heading}" Margin="0,0,16,0"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap">
                            <Run Text="Port: " /><Run Text="{Binding SelectedF100.PortName, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <Run Text="  ·  kanál " /><Run Text="{Binding SelectedF100Channel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                    </Border>
                </Grid>
                <views:ChartView Grid.Row="1" Series="{Binding SelectedF100.LiveSeries}" Unit=" °C"
                                 EmptyText="Stlač Načítať teplotu alebo spusti kalibráciu…"
                                 ChartTitle="USB referenčný teplomer" />
            </Grid>
        </Border>

        <TabControl x:Name="CalibrationTabs" Grid.Row="4" Margin="6,0,6,8">
            <TabItem Header="Zapojenie">
                <TabItem.Resources>
                    <Style x:Key="WiringFilterChip" TargetType="RadioButton">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="#253A5D" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="WiringCountBadge" TargetType="Border">
                        <Setter Property="Background" Value="#263A5D" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="Margin" Value="8,0,0,0" />
                    </Style>
                </TabItem.Resources>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#111C2B" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✣  Navrhnúť 1 peak / kanál" Style="{StaticResource GhostButton}"
                                        Padding="12,6" Command="{Binding SelectSuggestedPeaksCommand}"
                                        ToolTip="Za každý kanál označí jeden najsilnejší peak." />
                                <Button Content="☑  Vybrať všetky peaky" Style="{StaticResource GhostButton}"
                                        Padding="12,6" Margin="8,0,16,0" Click="SelectAllPeaks_Click" />
                                <TextBlock Text="{Binding PeakSelectionSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="270" Margin="0,0,10,0">
                                    <TextBox Padding="28,6,28,6" Text="{Binding PeakSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Hľadať podľa kanála, peaku, indexu, SN, zákazky alebo poznámky" />
                                    <TextBlock Text="⌕" FontSize="18" Margin="9,0,0,1" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                                    <TextBlock Text="Hľadať v zapojení…" Margin="30,0,32,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding PeakSearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="×" Command="{Binding ClearPeakSearchCommand}" Style="{StaticResource GhostButton}"
                                            Padding="4,0" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <RadioButton GroupName="PeakFilter" IsChecked="{Binding PeakFilterAll}" Style="{StaticResource WiringFilterChip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Všetky" /><Border Style="{StaticResource WiringCountBadge}"><TextBlock Text="{Binding PeakTotalCount}" /></Border></StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PeakFilter" IsChecked="{Binding PeakFilterSelected}" Style="{StaticResource WiringFilterChip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Vybrané" /><Border Style="{StaticResource WiringCountBadge}"><TextBlock Text="{Binding PeakSelectedCount}" /></Border></StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PeakFilter" IsChecked="{Binding PeakFilterErrors}" Style="{StaticResource WiringFilterChip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Chyby" /><Border Style="{StaticResource WiringCountBadge}" Background="#512A38"><TextBlock Text="{Binding PeakErrorCount}" /></Border></StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Empty state: an empty grid with 15 headers and nothing under them says
                         nothing about what the operator is supposed to do next. -->
                    <TextBlock Grid.Row="1" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" Panel.ZIndex="1"
                               Text="Zatiaľ žiadne peaky. Pripoj PeakLogger (alebo zapni Simulátor) a stlač ↻ – načítajú sa kanály a nájdené peaky, ktoré potom označíš na kalibráciu.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Peaks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding PeaksView}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" HeadersVisibility="Column" EnableRowVirtualization="True"
                              AlternationCount="2" RowHeight="31" ColumnHeaderHeight="36" FontSize="12"
                              MaxHeight="548"
                              FrozenColumnCount="6" GridLinesVisibility="All" VerticalGridLinesBrush="#414C60"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Padding" Value="6,6" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="6,0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding NeedsSensorSerialNumber}" Value="True">
                                        <Setter Property="ToolTip" Value="Nový peak – doplň FBG sensor SN. Po vyplnení červené zvýraznenie zmizne." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSerialNumberWarning}" Value="True">
                                        <Setter Property="ToolTip" Value="{Binding SerialNumberWarning}" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF293958" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Kalibrovať" Binding="{Binding Selected, Mode=TwoWay}" Width="72" />
                            <DataGridTextColumn Header="Kanál" Binding="{Binding Channel}" IsReadOnly="True" Width="56" />
                            <DataGridTextColumn Header="Peak ID" Binding="{Binding PeakId}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="FBG index" Binding="{Binding PeakIndex}" IsReadOnly="True" Width="78" />
                            <DataGridTextColumn Header="Aktuálna λ [nm]" Binding="{Binding CurrentWavelengthNm, StringFormat=F3}" IsReadOnly="True" Width="96" />
                            <DataGridTextColumn Header="Intenzita [dBm]" Binding="{Binding Intensity, StringFormat=F3}" IsReadOnly="True" Width="108" />
                            <DataGridTextColumn Header="Snímač" Binding="{Binding SensorType}" IsReadOnly="True" Width="112" />
                            <DataGridTextColumn Header="Typ FBG" Binding="{Binding FbgType}" IsReadOnly="True" Width="98" />
                            <DataGridTextColumn Header="FBG sensor SN (kanál)" Binding="{Binding ChannelSerialNumber, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="180" />
                            <DataGridTextColumn Header="FBG sensor SN CHAIN" Binding="{Binding ChainSerialNumber, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="185" />
                            <DataGridTextColumn Header="Poznámky" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="220" />
                            <DataGridTextColumn Header="Popis produktu" Binding="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="175" IsReadOnly="True" />
                            <DataGridTextColumn Header="Zákazka" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="2,7,0,0">
                        <TextBlock Text="{Binding SerialNumberValidationMessage}" Foreground="{StaticResource WarnBrush}"
                                   FontFamily="Segoe UI Semibold" TextWrapping="Wrap" />
                        <Border Background="#111C2B" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,3,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding PeakLoggerConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource OkBrush}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding PeakLoggerStatus}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                <TextBlock Style="{StaticResource Caption}" Text="  |  " />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding PeakTotalCount, StringFormat={}{0} peakov}" />
                                <TextBlock Style="{StaticResource Caption}" Text="  |  posledná aktualizácia teraz" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Kalibračné plata">
                <Grid Margin="8" MaxWidth="720" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" MaxWidth="850" TextWrapping="Wrap"
                                   Text="Vyber hold segmenty, ktoré sa majú použiť ako kalibračné body. Rampy sa do finálneho vyhodnotenia nezaraďujú."
                                   Style="{StaticResource Caption}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentOutlineButton}"
                                Padding="11,6" Margin="12,0,0,0" Command="{Binding MarkAllPlateausCommand}"
                                ToolTip="Označí všetky dostupné hold segmenty profilu ako kalibračné body.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Calibration}" />
                                <TextBlock Text="Vybrať všetky plata" Style="{StaticResource IconLabel}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CalibrationPoints}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Vybrať" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Použiť toto plato ako kalibračný bod" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Segment" Binding="{Binding SegmentIndex}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Názov" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Teplota [°C]" Binding="{Binding TemperatureC, StringFormat=F2}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Min. čas plata" Binding="{Binding Duration}" IsReadOnly="True" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Live monitor">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" MinWidth="190"><StackPanel><TextBlock Text="Stav" Style="{StaticResource Label}"/><TextBlock Text="{Binding RunState}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="190"><StackPanel><TextBlock Text="Plato" Style="{StaticResource Label}"/><TextBlock Text="{Binding PlateauLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="250"><StackPanel><TextBlock Text="Komora" Style="{StaticResource Label}"/><TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="190"><StackPanel><TextBlock Text="Referenčný teplomer" Style="{StaticResource Label}"/><TextBlock Text="{Binding ReferenceTemperatureLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="200"><StackPanel><TextBlock Text="Stabilné wavelengthy" Style="{StaticResource Label}"/><TextBlock Text="{Binding StableLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="2,0,0,8" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Každý riadok je konkrétne produkčné FBG SN + FBG index. Vlnová dĺžka sa počas stabilizácie aktualizuje pre všetky označené peaky paralelne." />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding TargetProgress}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FBG SN" Binding="{Binding SerialNumber}" Width="150" />
                            <DataGridTextColumn Header="Kanál" Binding="{Binding Channel}" Width="70" />
                            <DataGridTextColumn Header="Peak ID" Binding="{Binding PeakId}" Width="75" />
                            <DataGridTextColumn Header="FBG index" Binding="{Binding PeakIndex}" Width="80" />
                            <DataGridTextColumn Header="Vlnová dĺžka λ [nm]" Binding="{Binding CurrentWavelengthNm, StringFormat=F6}" Width="145" />
                            <DataGridTextColumn Header="Samples" Binding="{Binding SamplesLabel}" Width="85" />
                            <DataGridTextColumn Header="StdDev [pm]" Binding="{Binding StandardDeviationPm, StringFormat=F3}" Width="100" />
                            <DataGridTextColumn Header="Drift [pm/min]" Binding="{Binding DriftPmPerMinute, StringFormat=F3}" Width="110" />
                            <DataGridTextColumn Header="Čas" Binding="{Binding Elapsed}" Width="100" />
                            <DataGridTextColumn Header="Timeout" Binding="{Binding Timeout}" Width="100" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="130" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Nastavenia stability">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Meranie a priebežný log" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox Content="Priemerovať wavelength vzorky" IsChecked="{Binding EnableWavelengthAveraging}" VerticalAlignment="Center" Margin="0,0,18,12" />
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Počet vzoriek na priemer" Style="{StaticResource Label}"/><TextBox Width="160" Text="{Binding WavelengthAveragingSamples, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <CheckBox Content="Zapisovať samostatný wavelength log" IsChecked="{Binding EnableWavelengthTraceLogging}" VerticalAlignment="Center" Margin="0,0,18,12" />
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Interval logu [s]" Style="{StaticResource Label}"/><TextBox Width="140" Text="{Binding WavelengthTraceIntervalSeconds, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Stabilita wavelength" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Počet stabilných samples" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding RequiredStableSamples, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Max range [pm] · 0 = vyp." Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding MaxRangePm, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Max StdDev [pm] · 0 = vyp." Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding MaxStdDevPm, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Max drift [pm/min] · 0 = vyp." Style="{StaticResource Label}"/><TextBox Width="160" Text="{Binding MaxDriftPmPerMinute, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Stabilita komory" Style="{StaticResource Heading}" Margin="0,10,0,8" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Tolerance [°C]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ChamberToleranceC, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Stabilný čas [min]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ChamberStableMinutes, UpdateSourceTrigger=LostFocus}"/></StackPanel>
<StackPanel Margin="0,0,18,12"><CheckBox Content="Najprv ustáliť komoru" IsChecked="{Binding ChamberEntryEnabled, Mode=TwoWay}" ToolTip="Pred WIKA vyžaduje samostatné okno stability vnútornej sondy komory. WIKA sa stále číta a loguje, ale jej stabilita sa začne počítať až potom. Timeout teplotnej fázy platí pre obe fázy spolu."/></StackPanel><StackPanel Margin="0,0,18,12"><TextBlock Text="Komora: tolerancia [°C]" Style="{StaticResource Label}" /><views:NumericStepper Width="150" Value="{Binding ChamberEntryToleranceC, Mode=TwoWay}" Minimum="0.01" Maximum="20" Step="0.1" ToolTip="Vstupné ustálenie komory pred WIKA. Odporúčanie z 92 historických plat: ±0,5 °C; okno 120 s; rozsah do 0,5 °C; drift do 0,1 °C/min."/></StackPanel><StackPanel Margin="0,0,18,12"><TextBlock Text="Komora: stabilné okno [s]" Style="{StaticResource Label}" /><views:NumericStepper Width="150" Value="{Binding ChamberEntryStableSeconds, Mode=TwoWay}" Minimum="1" Maximum="3600" Step="30" ToolTip="Vstupné ustálenie komory pred WIKA. Odporúčanie z 92 historických plat: ±0,5 °C; okno 120 s; rozsah do 0,5 °C; drift do 0,1 °C/min."/></StackPanel><StackPanel Margin="0,0,18,12"><TextBlock Text="Komora: rozsah [°C]" Style="{StaticResource Label}" /><views:NumericStepper Width="150" Value="{Binding ChamberEntryRangeC, Mode=TwoWay}" Minimum="0.01" Maximum="20" Step="0.1" ToolTip="Vstupné ustálenie komory pred WIKA. Odporúčanie z 92 historických plat: ±0,5 °C; okno 120 s; rozsah do 0,5 °C; drift do 0,1 °C/min."/></StackPanel><StackPanel Margin="0,0,18,12"><TextBlock Text="Komora: drift [°C/min]" Style="{StaticResource Label}" /><views:NumericStepper Width="150" Value="{Binding ChamberEntryDriftCPerMinute, Mode=TwoWay}" Minimum="0.001" Maximum="10" Step="0.01" ToolTip="Vstupné ustálenie komory pred WIKA. Odporúčanie z 92 historických plat: ±0,5 °C; okno 120 s; rozsah do 0,5 °C; drift do 0,1 °C/min."/></StackPanel>

                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Default sensor timeout [min]" Style="{StaticResource Label}"/><TextBox Width="180" Text="{Binding SensorTimeoutMinutes, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Kontrola odozvy na teplotu" Style="{StaticResource Heading}" Margin="0,10,0,8" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Min ΔT [°C]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ValidationMinimumDeltaTemperatureC, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Min Δλ [pm]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ValidationMinimumResponsePm, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        </WrapPanel>
                        <CheckBox Content="Povoliť override pri zlyhaní temperature-response validácie" IsChecked="{Binding AllowValidationOverride}" Margin="0,6,0,6" />
                        <TextBlock Text="Dôvod override" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding ValidationOverrideReason, UpdateSourceTrigger=PropertyChanged}" Width="650" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" />
                        <TextBlock Text="Override používaj iba po vedomom overení správneho SN/peaku. Dôvod sa uloží do warningu kalibračného runu." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="História">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="↻ Obnoviť zoznam" Style="{StaticResource GhostButton}" Command="{Binding RefreshHistoryCommand}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Pokračovať od vybraného behu" Style="{StaticResource AccentOutlineButton}" Margin="0,0,8,0"
                                    Command="{Binding RestoreSelectedRunCommand}"
                                    ToolTip="Znovu vytvorí checkpoint z dokončených plat vybraného prerušeného behu. Rozpracované plato sa zmeria nanovo." />
                            <Button Content="Export koeficientov" Style="{StaticResource AccentOutlineButton}" Margin="0,0,8,0"
                                    Command="{Binding ExportCalibrationCoefficientsCommand}"
                                    ToolTip="Exportuje λTref, citlivosť, koeficienty, maximálnu chybu, R² a PASS/FAIL vybraného behu." />
                            <Button Content="Export summary CSV" Style="{StaticResource AccentButton}" Command="{Binding ExportSelectedRunCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Analýza vybraného profilu" Style="{StaticResource Heading}"/><TextBlock Text="{Binding ProfileUsageSummary}" Foreground="#CBE2FF"/><TextBlock Text="{Binding ProfileDurationSummary}" Foreground="#66DDB0" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding ProfileDurationRange}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
                                <Border Grid.Column="1" Background="#17362F" BorderBrush="#43C99A" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Top"><TextBlock Text="Odhad sa učí z dokončených behov" Foreground="#69E1B4" FontSize="11"/></Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ProfilePlateauAnalysis}" Margin="0,11,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Background="#101C2B" BorderBrush="#2A4664" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,6" MinWidth="205"><StackPanel><DockPanel><TextBlock Text="{Binding Number}" Foreground="#7DBDFF" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="{Binding Target}" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Typical}" Foreground="#66DDB0" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Average}" Style="{StaticResource Caption}" Margin="0,2,0,0"/><TextBlock Text="{Binding Range, StringFormat=rozsah {0}}" Foreground="#748AA4" FontSize="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="Kalibračné koeficienty vybraného behu" Style="{StaticResource Heading}" Margin="0,0,0,7" />
                            <DataGrid ItemsSource="{Binding SelectedHistoryRun.CalibrationResults}" Height="180"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FBG SN" Binding="{Binding SerialNumber}" Width="140" />
                                    <DataGridTextColumn Header="Kanál / peak" Binding="{Binding Identity}" Width="170" />
                                    <DataGridTextColumn Header="Kalibrácia" Binding="{Binding CalibrationType}" Width="105" />
                                    <DataGridTextColumn Header="Body" Binding="{Binding PointCount}" Width="55" />
                                    <DataGridTextColumn Header="λTref [nm]" Binding="{Binding LambdaTRefNm, StringFormat=F6}" Width="110" />
                                    <DataGridTextColumn Header="Citlivosť [pm/°C]" Binding="{Binding SensitivityPmPerC, StringFormat=F4}" Width="125" />
                                    <DataGridTextColumn Header="s1" Binding="{Binding CoefficientS1, StringFormat=G8}" Width="105" />
                                    <DataGridTextColumn Header="s2" Binding="{Binding CoefficientS2, StringFormat=G8}" Width="105" />
                                    <DataGridTextColumn Header="A" Binding="{Binding CoefficientA, StringFormat=G8}" Width="105" />
                                    <DataGridTextColumn Header="B" Binding="{Binding CoefficientB, StringFormat=G8}" Width="105" />
                                    <DataGridTextColumn Header="C" Binding="{Binding CoefficientC, StringFormat=G8}" Width="105" />
                                    <DataGridTextColumn Header="D" Binding="{Binding CoefficientD, StringFormat=G8}" Width="105" />
                                    <DataGridTextColumn Header="Max. chyba [°C]" Binding="{Binding MaxErrorC, StringFormat=F4}" Width="115" />
                                    <DataGridTextColumn Header="Limit [°C]" Binding="{Binding ErrorToleranceC, StringFormat=F3}" Width="90" />
                                    <DataGridTextColumn Header="R²" Binding="{Binding RSquared, StringFormat=F6}" Width="85" />
                                    <DataGridTextColumn Header="Stabilizácia" Binding="{Binding StabilityStatus}" Width="105" />
                                    <DataGridTextColumn Header="Problém stabilizácie" Binding="{Binding StabilityProblem}" Width="220" />
                                    <DataGridTextColumn Header="Teplota z koef. [°C]" Binding="{Binding FinalCalculatedTemperatureC, StringFormat=F3, TargetNullValue=N/A}" Width="160" />
                                    <DataGridTextColumn Header="Kontrola 25 °C" Binding="{Binding FinalCheckStatus}" Width="120" />
                                    <DataGridTextColumn Header="WIKA kontroly [°C]" Binding="{Binding FinalReferenceTemperatureC, StringFormat=F3}" Width="130" />
                                    <DataGridTextColumn Header="λ meraná [nm]" Binding="{Binding FinalMeasuredLambdaNm, StringFormat=F6}" Width="125" />
                                    <DataGridTextColumn Header="λ vypočítaná [nm]" Binding="{Binding FinalExpectedLambdaNm, StringFormat=F6}" Width="130" />
                                    <DataGridTextColumn Header="Rozdiel [pm]" Binding="{Binding FinalLambdaErrorPm, StringFormat=F3}" Width="100" />
                                    <DataGridTextColumn Header="Chyba [°C]" Binding="{Binding FinalTemperatureErrorC, StringFormat=F3}" Width="100" />
                                    <DataGridTextColumn Header="Problém kontroly" Binding="{Binding FinalCheckProblem}" Width="260" />
                                    <DataGridTextColumn Header="Výsledok" Binding="{Binding Result}" Width="85" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryRun}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Začiatok" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                            <DataGridTextColumn Header="Koniec" Binding="{Binding CompletedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                            <DataGridTextColumn Header="RunId" Binding="{Binding RunId}" Width="220" />
                            <DataGridTextColumn Header="Profil" Binding="{Binding ProfileName}" Width="*" />
                            <DataGridTextColumn Header="Komora" Binding="{Binding ChamberName}" Width="180" />
                            <DataGridTextColumn Header="CTH7000 port" Binding="{Binding ReferenceThermometerPort}" Width="90" />
                            <DataGridTextColumn Header="CTH7000 kanál" Binding="{Binding ReferenceThermometerChannel}" Width="100" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="160" />
                            <DataGridTextColumn Header="Plata" Binding="{Binding Plateaus.Count}" Width="70" />
                            <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings.Count}" Width="80" />
                            <DataGridTextColumn Header="Operátor" Binding="{Binding Operator}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="5" Margin="6,0,6,4" Padding="12,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.Header, ElementName=CalibrationTabs}" Value="Zapojenie">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontFamily="Segoe UI Semibold" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
