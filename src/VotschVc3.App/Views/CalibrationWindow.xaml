<Window x:Class="VotschVc3.App.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VotschVc3.App.Views"
        Title="FBG teplotná kalibrácia · PeakLogger"
        Height="940" Width="1500" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <!-- Run controls stay solid glyphs, like the transport buttons on a device card. -->
        <Style x:Key="RunGlyph" TargetType="Path" BasedOn="{StaticResource TransportIcon}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header: what this window is + what you can do with it =====
             The run controls are one group, set apart from "Uložiť zapojenie" so a stop is
             never a neighbour of a save. -->
        <DockPanel Grid.Row="0" Margin="6,4,6,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="FBG teplotná kalibrácia" FontSize="24" FontFamily="Segoe UI Semibold" />
                <TextBlock Text="Komora + PeakLogger + ASL F100 referencia + automatické vyhodnotenie stability wavelength"
                           Style="{StaticResource Caption}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding SaveSetupCommand}" Margin="0,0,14,0"
                        ToolTip="Uloží zapojenie (vybrané peaky, SN, poznámky) pre ďalší beh.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" />
                        <TextBlock Text="Uložiť zapojenie" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>

                <!-- Run controls, visually one block. -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="5,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding StartCalibrationCommand}" Margin="0,0,6,0"
                                ToolTip="Spustí kalibračný beh: komora prejde plata a pri každom sa čaká na stabilnú vlnovú dĺžku.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource RunGlyph}" Data="{StaticResource Icon.Play}" />
                                <TextBlock Text="Spustiť kalibráciu" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding PauseResumeCommand}" Margin="0,0,6,0"
                                ToolTip="Pozastaví alebo obnoví prebiehajúci beh.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource RunGlyph}" Data="{StaticResource Icon.Pause}" />
                                <TextBlock Text="Pauza" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding StopCalibrationCommand}" Margin="0"
                                ToolTip="Zastaví beh kalibrácie.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource RunGlyph}" Data="{StaticResource Icon.Stop}" />
                                <TextBlock Text="Stop" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ===== Zostava: čo sa kalibruje, čím sa meria a proti čomu =====
             Three boxed groups instead of one row of loose controls: the previous layout put
             the connect button in its own grid column, which left a hand-sized hole in the
             middle of the card and made nothing look like it belonged together. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="6,0,6,10">
            <StackPanel>
                <TextBlock Text="Zostava kalibrácie" Style="{StaticResource Heading}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <!-- ① Čo sa kalibruje -->
                    <Border Grid.Column="0" Style="{StaticResource PanelGroup}">
                        <StackPanel>
                            <TextBlock Text="Profil a komora" Style="{StaticResource Heading}" />
                            <StackPanel Style="{StaticResource FieldStack}" Margin="0,8,0,9">
                                <TextBlock Text="Kalibračný profil" Style="{StaticResource Label}" />
                                <views:ProfilePicker ItemsSource="{Binding Profiles}"
                                                     SelectedProfile="{Binding SelectedProfile, Mode=TwoWay}"
                                                     Placeholder="Vyber kalibračný profil"
                                                     ToolTip="Vyber teplotný profil – v náhľade uvidíš graf, rozsah, celkový čas a podrobný prehľad plat. Kalibračné body sú jeho plata." />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Komora" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Chambers}" SelectedItem="{Binding SelectedChamber}"
                                          DisplayMemberPath="DisplayName" MinHeight="32"
                                          ToolTip="Zariadenie, ktoré počas kalibrácie riadi teplotu." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ② Čím sa merajú vlnové dĺžky -->
                    <Border Grid.Column="2" Style="{StaticResource PanelGroup}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="PeakLogger (interrogátor)" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                                <CheckBox DockPanel.Dock="Right" Content="Simulátor" IsChecked="{Binding UseSimulator}"
                                          VerticalAlignment="Center" FontSize="12"
                                          ToolTip="Beh bez pripojeného prístroja – generuje vlnové dĺžky podľa zvoleného scenára." />
                            </DockPanel>

                            <StackPanel Style="{StaticResource FieldStack}" Margin="0,8,0,9"
                                        Visibility="{Binding UseSimulator, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Scenár simulátora" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding SimulatorScenarios}" SelectedItem="{Binding SimulatorScenario}" MinHeight="30" />
                            </StackPanel>

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding UseSimulator, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding PeakLoggerHost, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding PeakLoggerPort, UpdateSourceTrigger=LostFocus}" MinHeight="30" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,7,0,0"
                                        Visibility="{Binding UseSimulator, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Vyhľadať API" Style="{StaticResource GhostButton}"
                                            Margin="7,0,0,0" Padding="9,4" Command="{Binding DiscoverPeakLoggerApisCommand}"
                                            ToolTip="Na localhoste preverí všetky aktívne TCP porty z Windows a rezervných 64 portov od zadanej hodnoty. Hľadá /api/v1/peaks aj staršie /peaks." />
                                    <ComboBox ItemsSource="{Binding PeakLoggerInstances}"
                                              SelectedItem="{Binding SelectedPeakLoggerInstance, Mode=TwoWay}"
                                              DisplayMemberPath="Display" MinHeight="30"
                                              ToolTip="Vyber nájdenú PeakLogger API inštanciu; host a port sa doplnia automaticky." />
                                </DockPanel>
                                <TextBlock Text="{Binding PeakLoggerDiscoverySummary}" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding PeakLoggerStatus}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="8,5"
                                        Command="{Binding RefreshSensorsCommand}"
                                        ToolTip="Znovu načítať PeakLogger zariadenia, kanály a peaky">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Content="Pripojiť" Style="{StaticResource AccentButton}" Margin="0"
                                        Command="{Binding ConnectPeakLoggerCommand}"
                                        ToolTip="Pripojí PeakLogger a načíta jeho kanály a peaky." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ③ Proti čomu sa kalibruje -->
                    <Border Grid.Column="4" Style="{StaticResource PanelGroup}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Referenčný teplomer ASL F100" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3" Margin="0"
                                        Command="{Binding RefreshF100PortsCommand}"
                                        ToolTip="Znovu načíta USB/sériové porty a dostupné ASL F100 zariadenia.">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Content="USB diagnostika" Style="{StaticResource GhostButton}"
                                        Padding="8,3" Margin="0,0,6,0" Command="{Binding ToggleUsbDiagnosticsCommand}"
                                        ToolTip="Zobrazí COM porty, stav USB/PnP zariadenia, ovládač a Windows chybový kód." />
                            </DockPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Port" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding F100Devices}" SelectedItem="{Binding SelectedF100, Mode=TwoWay}"
                                              DisplayMemberPath="Display" MinHeight="32"
                                              ToolTip="USB COM port vybraného ASL F100 teplomera." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kanál sondy" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding F100Channels}" SelectedItem="{Binding SelectedF100Channel, Mode=TwoWay}"
                                              MinHeight="32" ToolTip="Fyzický vstup sondy na F100: A alebo B." />
                                </StackPanel>
                                <Button Grid.Column="4" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="0"
                                        Command="{Binding CheckF100Command}"
                                        ToolTip="Pripojí vybraný F100 (ak treba) a vyčíta jednu čerstvú teplotu zo zvoleného kanála.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Thermometer}" />
                                        <TextBlock Text="Kontrola" Style="{StaticResource IconLabel}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Live reference reading: the number the whole calibration is measured
                                 against, so it gets Metric weight and its own row. -->
                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Referenčná teplota" Style="{StaticResource Caption}" />
                                    <TextBlock FontSize="26" FontFamily="Segoe UI Light">
                                        <Run Text="{Binding SelectedF100.Temperature, Mode=OneWay, TargetNullValue=—, StringFormat={}{0:F3}}" />
                                        <Run Text=" °C" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding F100ConnectionLabel}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding F100ChartButtonText}" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Bottom" Margin="0"
                                        Command="{Binding ToggleF100ChartCommand}"
                                        ToolTip="Zobrazí/skryje priebeh teploty nameranej F100 v čase." />
                            </DockPanel>

                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="9" Margin="0,9,0,0"
                                    Visibility="{Binding ShowUsbDiagnostics, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,7">
                                        <Button Content="Znovu analyzovať" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                Command="{Binding AnalyzeUsbCommand}" />
                                        <Button Content="Pasívny test F100" Style="{StaticResource AccentOutlineButton}" Margin="0,0,6,0"
                                                Command="{Binding DiagnoseF100TalkOnlyCommand}"
                                                ToolTip="Nanovo načíta USB/COM porty a iba počúva talk-only dáta pri 4800/9600/19200 bd. Do F100 neodošle ani jeden príkaz. Test môže trvať približne 10 sekúnd." />
                                        <Button Content="Vynútiť pripojenie" Style="{StaticResource AccentOutlineButton}" Margin="0,0,10,0"
                                                Command="{Binding ForceReconnectF100Command}"
                                                ToolTip="Zatvorí spojenie tejto aplikácie, znovu otvorí vybraný COM port a skúsi načítať F100." />
                                        <TextBox Width="72" Text="{Binding ManualF100Port, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" ToolTip="Ručný COM port, napríklad COM4." />
                                        <Button Content="Pridať port" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                                Command="{Binding AddManualF100PortCommand}" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding UsbDiagnostics}" MaxHeight="210">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Ak je port obsadený, zatvor FOS4X alebo inú aplikáciu. Ak sa port otvorí, ale neprídu žiadne dáta, na F100 nastav Menu → Options → Talk Only → On. Toto nastavenie zostáva uložené aj po vypnutí."
                                               Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Reference-temperature trace, folded away until the operator asks for it. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="6,0,6,10"
                Visibility="{Binding ShowF100Chart, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Priebeh referenčnej teploty ASL F100" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Run Text="Port: " /><Run Text="{Binding SelectedF100.PortName, Mode=OneWay, TargetNullValue=—}" />
                        <Run Text=" · kanál " /><Run Text="{Binding SelectedF100Channel, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <views:ChartView Grid.Row="1" Series="{Binding SelectedF100.LiveSeries}" Unit=" °C"
                                 EmptyText="Stlač Kontrola alebo spusti kalibráciu…"
                                 ChartTitle="ASL F100 — referenčná teplota" />
            </Grid>
        </Border>

        <TabControl Grid.Row="3" Margin="6,0,6,8">
            <TabItem Header="Zapojenie">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Navrhnúť 1 peak / kanál" Style="{StaticResource GhostButton}"
                                Margin="10,0,0,0" Command="{Binding SelectSuggestedPeaksCommand}"
                                ToolTip="Za každý kanál označí jeden najsilnejší peak – rýchly štart, keď je na kanáli jeden senzor." />
                        <TextBlock Text="PeakLogger deviceSN je SN interrogátora. Produkčné FBG SN zadaj alebo naskenuj samostatne; live identita je PeakLogger SN + kanál + PeakId."
                                   Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- Empty state: an empty grid with 15 headers and nothing under them says
                         nothing about what the operator is supposed to do next. -->
                    <TextBlock Grid.Row="1" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" Panel.ZIndex="1"
                               Text="Zatiaľ žiadne peaky. Pripoj PeakLogger (alebo zapni Simulátor) a stlač ↻ – načítajú sa kanály a nájdené peaky, ktoré potom označíš na kalibráciu.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Peaks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Peaks}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" HeadersVisibility="Column" EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsSensorSerialNumber}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PendingRowBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="BorderThickness" Value="4,0,0,1" />
                                        <Setter Property="ToolTip" Value="Nový peak – doplň FBG sensor SN. Po vyplnení červené zvýraznenie zmizne." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSerialNumberWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                        <Setter Property="BorderThickness" Value="4,0,0,1" />
                                        <Setter Property="ToolTip" Value="{Binding SerialNumberWarning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Kalibrovať" Binding="{Binding Selected, Mode=TwoWay}" Width="90" />
                            <DataGridTextColumn Header="PeakLogger SN" Binding="{Binding PeakLoggerDeviceSerialNumber}" IsReadOnly="True" Width="125" />
                            <DataGridTextColumn Header="Kanál" Binding="{Binding Channel}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Žila 1" Binding="{Binding Core1, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="65" />
                            <DataGridTextColumn Header="Žila 2" Binding="{Binding Core2, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="65" />
                            <DataGridTextColumn Header="FBG sensor SN (kanál)" Binding="{Binding ChannelSerialNumber, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="175" />
                            <DataGridTextColumn Header="FBG sensor SN CHAIN" Binding="{Binding ChainSerialNumber, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="180" />
                            <DataGridTextColumn Header="Peak ID" Binding="{Binding PeakId}" IsReadOnly="True" Width="75" />
                            <DataGridTextColumn Header="FBG index" Binding="{Binding PeakIndex}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Aktuálna λ [nm]" Binding="{Binding CurrentWavelengthNm, StringFormat=F6}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Intenzita" Binding="{Binding Intensity, StringFormat=F2}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="Timeout [min]" Binding="{Binding TimeoutMinutes, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="95" />
                            <DataGridTextColumn Header="Poznámky" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="160" />
                            <DataGridTextColumn Header="Popis produktu" Binding="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="180" />
                            <DataGridTextColumn Header="Zákazník" Binding="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="150" />
                            <DataGridTextColumn Header="Zákazka" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource DataGridEditTextBox}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="2,7,0,0">
                        <TextBlock Text="{Binding SerialNumberValidationMessage}" Foreground="{StaticResource WarnBrush}"
                                   FontFamily="Segoe UI Semibold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Bežné SN sa prenesie na všetky peaky rovnakého kanála. Pri CHAIN zapojení zadaj odlišné SN do stĺpca CHAIN pri konkrétnom peaku; CHAIN má prednosť. Očakávaný formát je XXXXXX/XXXX, iný text sa uloží s upozornením. Zmeny sa ukladajú priebežne." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Kalibračné plata">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Iba označené hold segmenty sa použijú ako kalibračné body. Rampy sa nikdy nevyhodnocujú ako finálne kalibračné body." Style="{StaticResource Caption}" />
                        <Button DockPanel.Dock="Right" Content="Označiť všetky plata" Style="{StaticResource GhostButton}" Command="{Binding MarkAllPlateausCommand}" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CalibrationPoints}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Kalibračný bod" Binding="{Binding Selected, Mode=TwoWay}" Width="130" />
                            <DataGridTextColumn Header="Segment" Binding="{Binding SegmentIndex}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Názov" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Teplota [°C]" Binding="{Binding TemperatureC, StringFormat=F2}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Min. čas plata" Binding="{Binding Duration}" IsReadOnly="True" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Live monitor">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" MinWidth="190"><StackPanel><TextBlock Text="Stav" Style="{StaticResource Label}"/><TextBlock Text="{Binding RunState}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="190"><StackPanel><TextBlock Text="Plato" Style="{StaticResource Label}"/><TextBlock Text="{Binding PlateauLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="250"><StackPanel><TextBlock Text="Komora" Style="{StaticResource Label}"/><TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="190"><StackPanel><TextBlock Text="ASL F100" Style="{StaticResource Label}"/><TextBlock Text="{Binding ReferenceTemperatureLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" MinWidth="200"><StackPanel><TextBlock Text="Stabilné wavelengthy" Style="{StaticResource Label}"/><TextBlock Text="{Binding StableLabel}" Style="{StaticResource Heading}"/></StackPanel></Border>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="2,0,0,8" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Každý riadok je konkrétne produkčné FBG SN + FBG index. Vlnová dĺžka sa počas stabilizácie aktualizuje pre všetky označené peaky paralelne." />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding TargetProgress}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FBG SN" Binding="{Binding SerialNumber}" Width="150" />
                            <DataGridTextColumn Header="Kanál" Binding="{Binding Channel}" Width="70" />
                            <DataGridTextColumn Header="Peak ID" Binding="{Binding PeakId}" Width="75" />
                            <DataGridTextColumn Header="FBG index" Binding="{Binding PeakIndex}" Width="80" />
                            <DataGridTextColumn Header="Vlnová dĺžka λ [nm]" Binding="{Binding CurrentWavelengthNm, StringFormat=F6}" Width="145" />
                            <DataGridTextColumn Header="Samples" Binding="{Binding SamplesLabel}" Width="85" />
                            <DataGridTextColumn Header="StdDev [pm]" Binding="{Binding StandardDeviationPm, StringFormat=F3}" Width="100" />
                            <DataGridTextColumn Header="Drift [pm/min]" Binding="{Binding DriftPmPerMinute, StringFormat=F3}" Width="110" />
                            <DataGridTextColumn Header="Čas" Binding="{Binding Elapsed}" Width="100" />
                            <DataGridTextColumn Header="Timeout" Binding="{Binding Timeout}" Width="100" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="130" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Nastavenia stability">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Stabilita wavelength" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Počet stabilných samples" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding RequiredStableSamples, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Max range [pm] · 0 = vyp." Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding MaxRangePm, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Max StdDev [pm] · 0 = vyp." Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding MaxStdDevPm, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Max drift [pm/min] · 0 = vyp." Style="{StaticResource Label}"/><TextBox Width="160" Text="{Binding MaxDriftPmPerMinute, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Stabilita komory" Style="{StaticResource Heading}" Margin="0,10,0,8" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Tolerance [°C]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ChamberToleranceC, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Stabilný čas [min]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ChamberStableMinutes, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Default sensor timeout [min]" Style="{StaticResource Label}"/><TextBox Width="180" Text="{Binding SensorTimeoutMinutes, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Kontrola odozvy na teplotu" Style="{StaticResource Heading}" Margin="0,10,0,8" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Min ΔT [°C]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ValidationMinimumDeltaTemperatureC, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="Min Δλ [pm]" Style="{StaticResource Label}"/><TextBox Width="150" Text="{Binding ValidationMinimumResponsePm, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        </WrapPanel>
                        <CheckBox Content="Povoliť override pri zlyhaní temperature-response validácie" IsChecked="{Binding AllowValidationOverride}" Margin="0,6,0,6" />
                        <TextBlock Text="Dôvod override" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding ValidationOverrideReason, UpdateSourceTrigger=PropertyChanged}" Width="650" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" />
                        <TextBlock Text="Override používaj iba po vedomom overení správneho SN/peaku. Dôvod sa uloží do warningu kalibračného runu." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="História">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="↻ Obnoviť" Style="{StaticResource GhostButton}" Command="{Binding RefreshHistoryCommand}" />
                        <Button DockPanel.Dock="Right" Content="Export summary CSV" Style="{StaticResource AccentButton}" Command="{Binding ExportSelectedRunCommand}" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryRun}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Začiatok" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                            <DataGridTextColumn Header="RunId" Binding="{Binding RunId}" Width="220" />
                            <DataGridTextColumn Header="Profil" Binding="{Binding ProfileName}" Width="*" />
                            <DataGridTextColumn Header="Komora" Binding="{Binding ChamberName}" Width="180" />
                            <DataGridTextColumn Header="F100 port" Binding="{Binding ReferenceThermometerPort}" Width="90" />
                            <DataGridTextColumn Header="F100 kanál" Binding="{Binding ReferenceThermometerChannel}" Width="90" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="160" />
                            <DataGridTextColumn Header="Plata" Binding="{Binding Plateaus.Count}" Width="70" />
                            <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings.Count}" Width="80" />
                            <DataGridTextColumn Header="Operátor" Binding="{Binding Operator}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="6,0,6,4" Padding="12,8">
            <StackPanel>
                <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontFamily="Segoe UI Semibold" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
