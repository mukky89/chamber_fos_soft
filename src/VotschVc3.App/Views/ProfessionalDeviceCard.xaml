<UserControl x:Class="VotschVc3.App.Views.ProfessionalDeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VotschVc3.App.Views"
             x:Name="Root">
    <!--
        Compact, capability-based device card for the Professional dashboard.
        Bound directly to a ChamberViewModel (DataContext) — every value and
        command below is the same real backend state/command the Classic
        dashboard uses; nothing here is mocked. Humidity, SIKA and POL-EKO
        specific bits only appear when the bound device actually supports
        them (SupportsHumidity / IsSika / IsPolEko), per the capability model.
    -->
    <UserControl.Resources>
        <Style x:Key="ProBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProSection" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Width="360" Margin="5" Padding="13" VerticalAlignment="Top">
        <StackPanel>

            <!-- ===== Header: connection + name + Detail ===== -->
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToBrush}}"
                             ToolTip="{Binding ConnectionState}" />
                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="14.5"
                               Margin="7,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="190"
                               ToolTip="{Binding Name}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Detail →" Style="{StaticResource GhostButton}"
                        Padding="8,3" FontSize="12" Margin="0"
                        Command="{Binding Shell.OpenChamberCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        ToolTip="Otvoriť plné nastavenia a ovládanie (pripojenie, profily, graf, alarmy, záznam, admin)." />
                <Button DockPanel.Dock="Right" Content="◈" Style="{StaticResource GhostButton}"
                        Padding="8,3" FontSize="12" Margin="0,0,6,0"
                        Click="Calibration_Click"
                        ToolTip="FBG teplotná kalibrácia s týmto zariadením predvoleným." />
                <Button DockPanel.Dock="Right" Content="🌐" Style="{StaticResource GhostButton}"
                        Padding="8,3" FontSize="12" Margin="0,0,6,0"
                        Command="{Binding OpenDeviceWebCommand}"
                        ToolTip="Otvoriť webové rozhranie zariadenia." />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Margin="0,0,6,0"
                        Command="{Binding ToggleLockCommand}">
                    <TextBlock><Run Text="{Binding LockGlyph, Mode=OneWay}" /></TextBlock>
                </Button>
            </DockPanel>

            <!-- Badges: kind, run state, control mode, alarm -->
            <WrapPanel Margin="0,7,0,0">
                <Border Style="{StaticResource ProBadge}">
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}" />
                </Border>
                <Border Style="{StaticResource ProBadge}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding IsActive, Converter={StaticResource BoolToBrush}}" />
                        <TextBlock Text="{Binding StateLabel}" Margin="5,0,0,0" FontFamily="Segoe UI Semibold" FontSize="11.5"
                                   Foreground="{Binding IsActive, Converter={StaticResource BoolToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="7,3" Margin="0,0,5,0" VerticalAlignment="Center"
                        Visibility="{Binding HasControlMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ControlModeBadge}" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="11.5" />
                </Border>
                <Border Background="{StaticResource DangerBrush}" CornerRadius="6" Padding="7,3" VerticalAlignment="Center"
                        Visibility="{Binding IsAlarm, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{Binding AlarmMessage}">
                    <TextBlock Text="⚠ ALARM" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="11.5" />
                </Border>
            </WrapPanel>

            <!-- Offline hint: last known value instead of a broken-looking card. -->
            <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Run Text="● OFFLINE — " Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI Semibold" />
                <Run Text="posledná hodnota nižšie, komunikácia sa skúša obnoviť automaticky." />
            </TextBlock>
            <!-- SIKA Remote Control: shown for every SIKA device (green = writes accepted). -->
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal"
                        Visibility="{Binding ShowSikaRemoteControl, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSikaRemoteControlOn}" Value="False">
                                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding SikaRemoteControlStatus}" Margin="6,0,0,0"
                           FontFamily="Segoe UI Semibold" FontSize="11.5" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSikaRemoteControlOn}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="⇅" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="7,1" FontSize="11"
                        Command="{Binding ForceSikaRemoteControlCommand}"
                        Visibility="{Binding IsSikaRemoteControlOn, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                        ToolTip="Skúsi zapnúť Remote Control cez sieť (Com_ExternWriteFlag = 1)." />
            </StackPanel>

            <!-- Locked banner + inline unlock (compact version of the Classic prompt). -->
            <Border CornerRadius="8" Padding="9,6" Margin="0,7,0,0"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding LockStateLabel}" FontFamily="Segoe UI Semibold" FontSize="12"
                               Foreground="{StaticResource DangerBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding IsUnlockPromptOpen, Converter={StaticResource BoolToVisibility}}">
                        <PasswordBox x:Name="UnlockPass" Width="120" Height="28" VerticalContentAlignment="Center"
                                     Background="{StaticResource SurfaceAltBrush}" Padding="7,0"
                                     KeyDown="UnlockPassword_KeyDown" />
                        <Button Content="Odomknúť" Style="{StaticResource AccentButton}" Margin="7,0,0,0" Padding="10,3"
                                Tag="{Binding ElementName=UnlockPass}" Click="Unlock_Click" />
                        <Button Content="Zrušiť" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="10,3"
                                Command="{Binding CancelUnlockCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Live values: temperature (+ delta) and, capability-permitting, humidity ===== -->
            <Border Style="{StaticResource ProSection}">
                <WrapPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Teplota" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MetricSmall}"
                                       Text="{Binding MeasuredTemperature, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0}" />
                            <TextBlock Text="°C" VerticalAlignment="Bottom" Margin="2,0,0,3" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Setpoint" Style="{StaticResource Caption}" />
                        <TextBlock Style="{StaticResource MetricSub}" Foreground="{StaticResource WarnBrush}"
                                   Text="{Binding MeasuredTemperatureSetpoint, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Odchýlka" Style="{StaticResource Caption}" />
                        <TextBlock FontFamily="Segoe UI Semibold" FontSize="15" VerticalAlignment="Bottom">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Delta}" ConverterParameter=" °C">
                                    <Binding Path="MeasuredTemperature" />
                                    <Binding Path="MeasuredTemperatureSetpoint" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Visibility="{Binding SupportsHumidity, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Vlhkosť RH" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MetricSmall}"
                                       Text="{Binding MeasuredHumidity, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0}" />
                            <TextBlock Text="%" VerticalAlignment="Bottom" Margin="2,0,6,3" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding MeasuredHumiditySetpoint, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0}"
                                       Foreground="{StaticResource WarnBrush}" FontFamily="Segoe UI Semibold" FontSize="14" VerticalAlignment="Bottom"
                                       ToolTip="Setpoint vlhkosti" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- ===== Current profile: name, step, remaining time, progress ===== -->
            <Border Style="{StaticResource ProSection}" Visibility="{Binding IsProfileRunning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ProfileName}" FontFamily="Segoe UI Semibold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileName}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProfileProgress, StringFormat={}{0:0}%, Mode=OneWay}"
                                   FontFamily="Segoe UI Semibold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <ProgressBar Style="{StaticResource ProfileProgressBar}" Height="10" Margin="0,6,0,0"
                                 Value="{Binding ProfileProgress, Mode=OneWay}" Maximum="100" />
                    <TextBlock Text="{Binding ProfileStepText}" FontFamily="Segoe UI Semibold" FontSize="12"
                               Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasProfileStep, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Aktuálny krok profilu: nábeh (rampa) alebo výdrž (plato), jeho celkové trvanie a čas do konca kroku." />
                    <TextBlock Text="{Binding ProfileTimeRemaining}" FontFamily="Segoe UI Semibold" FontSize="13"
                               Margin="0,6,0,0" Foreground="{StaticResource OkBrush}" />
                    <TextBlock Text="{Binding ProfileCompletionText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasProfileCompletion, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Button Content="{Binding PauseResumeGlyph}" Style="{StaticResource IconActionButton}" Width="36" Height="32"
                                Foreground="{StaticResource WarnBrush}" Command="{Binding PauseResumeProfileCommand}"
                                ToolTip="Pozastaviť / pokračovať" />
                        <Button Content="⏭" Style="{StaticResource IconActionButton}" Width="36" Height="32"
                                Foreground="{StaticResource AccentBrush}" Command="{Binding SkipHoldCommand}"
                                ToolTip="Ukončiť aktuálne plato a pokračovať na ďalší nábeh a plato." />
                        <Button Content="⏹" Style="{StaticResource IconActionButton}" Width="36" Height="32" Margin="0"
                                Foreground="{StaticResource ErrorBrush}" Click="StopProfile_Click"
                                ToolTip="Zastaviť profil" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Idle activity line when no profile is running. -->
            <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsProfileRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <!-- ===== Quick control: presets, custom setpoint, Stop, profile launch — disabled while locked ===== -->
            <StackPanel IsEnabled="{Binding IsUnlocked}">
                <Border Style="{StaticResource ProSection}">
                    <!-- Manual control is off while a profile runs (and the profile picker below
                         is hidden then), so the two never fight over the set point. -->
                    <StackPanel IsEnabled="{Binding IsManualControlEnabled}">
                        <ItemsControl ItemsSource="{Binding QuickPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PresetChip}" Padding="10,5" FontSize="12.5" Margin="0,0,6,6"
                                            Content="{Binding}" ContentStringFormat="{}{0:0.#} °C"
                                            ToolTip="Klikni = nastav túto teplotu a zapni komoru"
                                            Command="{Binding DataContext.QuickSetTemperatureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel LastChildFill="False" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <views:NumericStepper Width="76" VerticalAlignment="Center"
                                                      Value="{Binding QuickTemperature, Mode=TwoWay}" Step="1"
                                                      ToolTip="Vlastná teplota (°C)" />
                                <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource MutedBrush}" />
                                <Button Content="Nastaviť" Style="{StaticResource AccentButton}" Margin="0" Padding="12,6"
                                        VerticalAlignment="Center" Command="{Binding QuickSetTemperatureCommand}" />
                            </StackPanel>
                            <Button Content="Stop" Style="{StaticResource DangerButton}" DockPanel.Dock="Right" Margin="0" Padding="14,6"
                                    VerticalAlignment="Center" Click="Stop_Click"
                                    ToolTip="Vypnúť komoru (zastaví reguláciu)." />
                        </DockPanel>

                        <Border Margin="0,7,0,0" CornerRadius="7" Padding="9,6"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                Visibility="{Binding HasActionInfo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ActionInfo}" FontFamily="Segoe UI Semibold" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Profile picker + start, only when the device isn't already running one. -->
                <Border Style="{StaticResource ProSection}" Visibility="{Binding IsProfileRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <StackPanel IsEnabled="{Binding IsProfileControlEnabled}">
                        <TextBlock Text="Testovací profil" Style="{StaticResource Label}" Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <views:ProfilePicker Grid.Column="0" VerticalAlignment="Center"
                                                 ItemsSource="{Binding History}"
                                                 SelectedProfile="{Binding SelectedHistoryProfile, Mode=TwoWay}"
                                                 ToolTip="Vyber uložený profil, potom spusti ▶. V zozname sú len profily pre tento typ zariadenia (Vötsch / SIKA). Rad profilov, oneskorený štart a knižnica sú v Detail →." />
                            <Button Grid.Column="1" Content="▶" Style="{StaticResource IconActionButton}" Width="36" Height="32" Margin="8,0,0,0"
                                    Foreground="{StaticResource OkBrush}" Click="StartProfile_Click"
                                    ToolTip="Spustiť vybraný profil" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
