<UserControl x:Class="VotschVc3.App.Views.ProfileEditorChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Compact square button for the zoom bar floating over the plot. -->
        <Style x:Key="ChartZoomButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="6">
        <Grid>
            <Canvas x:Name="PlotCanvas" ClipToBounds="True" Background="Transparent"
                    MouseMove="PlotCanvas_MouseMove" MouseLeftButtonUp="PlotCanvas_MouseUp"
                    MouseLeftButtonDown="PlotCanvas_MouseDown" MouseWheel="PlotCanvas_MouseWheel"
                    MouseLeave="PlotCanvas_MouseLeave" />

            <!-- Zoom controls: the mouse wheel is still there, but a chart this dense is
                 much easier to work with when zooming does not need a scroll gesture at all. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,2,4,0" Opacity="0.92">
                <Button Content="－" Style="{StaticResource ChartZoomButton}" Click="ZoomOut_Click"
                        ToolTip="Oddialiť (koliesko myši nadol)" />
                <Button Content="＋" Style="{StaticResource ChartZoomButton}" Click="ZoomIn_Click"
                        ToolTip="Priblížiť (koliesko myši nahor)" />
                <Button Content="⤢" Style="{StaticResource ChartZoomButton}" Click="ZoomReset_Click"
                        ToolTip="Zobraziť celý profil (dvojklik do grafu)" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
