<UserControl x:Class="VotschVc3.App.Views.CalibrationStabilitySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource PanelGroup}">
            <Setter Property="Width" Value="360" />
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="15,13" />
            <Setter Property="Background" Value="#202B42" />
            <Setter Property="BorderBrush" Value="#344866" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#243149" />
                    <Setter Property="BorderBrush" Value="#527BB4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style x:Key="SettingInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Background" Value="#101A29" />
            <Setter Property="BorderBrush" Value="#405878" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#6B92C8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62" />
                    <Setter Property="Background" Value="#151D2A" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingLongInput" TargetType="TextBox" BasedOn="{StaticResource SettingInput}">
            <Setter Property="Width" Value="720" />
            <Setter Property="MaxWidth" Value="900" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly" Padding="4,4,10,14">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}">
            <Border Background="#222B3B52" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="13,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Ako aplikácia rozhoduje o kalibračnom bode" FontSize="16" FontFamily="Segoe UI Semibold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="1. Najprv čaká na stabilnú referenčnú teplotu (WIKA; bez WIKA interná sonda komory). 2. Potom vyhodnocuje všetky označené FBG paralelne. 3. Každý FBG, ktorý splní počet samples + range + StdDev + drift, začne vlastné finálne meranie. 4. Plato skončí až keď sú hotové všetky vybrané FBG. Čas hold segmentu profilu FBG kalibráciu neblokuje." />
                </StackPanel>
            </Border>

            <TextBlock Text="1 · Stabilita referenčnej teploty" Style="{StaticResource Heading}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Tieto podmienky rozhodujú, kedy sa vôbec môže začať stabilizácia FBG. Ak je priradená WIKA CTH7000, rozhoduje WIKA; interná teplota komory je iba fallback bez WIKA." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}" ToolTip="Absolútny rozdiel medzi cieľom plata a referenciou musí byť menší alebo rovný tejto hodnote. Príklad: cieľ -40 °C a tolerancia 0,5 °C znamená akceptované pásmo -40,5 až -39,5 °C.">
                    <StackPanel>
                        <TextBlock Text="Teplotná tolerancia [°C]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Povolené pásmo okolo cieľovej teploty. Mimo pásma sa FBG stabilizácia nespustí alebo sa nedokončené FBG vrátia späť do čakania." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ChamberToleranceC, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Referencia musí byť bez prerušenia stabilná aspoň tento čas. Krátke prekročenie tolerancie alebo driftu stabilný interval resetuje.">
                    <StackPanel>
                        <TextBlock Text="Požadovaný stabilný čas [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Ako dlho musí referencia súvisle spĺňať stabilitu. Až potom aplikácia otvorí FBG fázu." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ChamberStableMinutes, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="2 · Stabilita jednotlivých FBG peakov" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Každý označený peak má vlastné rolling okno a vyhodnocuje sa nezávisle. Jeden senzor už môže merať finálne samples, zatiaľ čo druhý sa ešte stabilizuje." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}" ToolTip="Počet posledných wavelength vzoriek v rolling okne. Všetky ostatné stability kritériá sa počítajú z tohto okna. Počet musí byť dosiahnutý ešte pred prechodom do finálneho merania.">
                    <StackPanel>
                        <TextBlock Text="Počet samples pre stabilitu" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Koľko posledných λ vzoriek musí mať peak k dispozícii, aby sa vôbec mohol vyhodnotiť ako stabilný. Live monitor ukazuje x/N aj počet chýbajúcich samples." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding RequiredStableSamples, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Range = maximum λ - minimum λ v aktuálnom rolling okne. Limit 0 vypne toto kritérium.">
                    <StackPanel>
                        <TextBlock Text="Max. range [pm]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Maximálny rozptyl medzi najvyššou a najnižšou wavelength v stability okne. Čím nižšie číslo, tým prísnejšia stabilita. 0 = nevynucovať." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding MaxRangePm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Smerodajná odchýlka všetkých wavelength samples v rolling okne. Limit 0 vypne toto kritérium.">
                    <StackPanel>
                        <TextBlock Text="Max. StdDev [pm]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Štatistická rozkolísanosť wavelength samples. Vysoká StdDev znamená šum alebo nestabilný senzor. 0 = nevynucovať." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding MaxStdDevPm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Lineárny trend wavelength v čase vyjadrený v pm/min. Používa absolútnu hodnotu driftu. Limit 0 vypne toto kritérium.">
                    <StackPanel>
                        <TextBlock Text="Max. drift [pm/min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Kontroluje, či wavelength stále pomaly neuteká jedným smerom. Peak môže mať malý range, ale stále driftovať. 0 = nevynucovať." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding MaxDriftPmPerMinute, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Maximálny čas aktívnej FBG fázy pre jeden peak. Riadok v Zapojení môže mať vlastný override. Po prekročení sa použije nakonfigurovaná failure policy.">
                    <StackPanel>
                        <TextBlock Text="Default FBG peak timeout [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Bezpečnostný limit, aby jeden nestabilný peak neblokoval kalibráciu donekonečna. Začína sa počítať až po stabilizácii teploty." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding SensorTimeoutMinutes, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="3 · Finálne meranie a logovanie" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Stabilizačné samples sa nikdy nepoužijú ako finálny kalibračný priemer. Po potvrdení stability začne pre konkrétny peak nové meracie okno s vlastným počtom vzoriek. Live monitor zobrazuje stabilizačné a meracie počítadlo oddelene." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}" ToolTip="Počet nových vzoriek uložených do finálneho kalibračného výsledku. Stabilizačné vzorky sa do tohto počtu nezapočítavajú.">
                    <StackPanel>
                        <TextBlock Text="Počet finálnych samples" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Koľko nových λ vzoriek každý stabilný peak nazbiera pre výsledný priemer, medián a štatistiky." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding RequiredMeasurementSamples, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Pred ďalším spracovaním sa každý live wavelength bod môže spriemerovať z posledných N raw čítaní. Znižuje šum, ale spomaľuje reakciu na skutočnú zmenu.">
                    <StackPanel>
                        <TextBlock Text="Priemerovanie wavelength" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Voliteľný pre-filter pred stability detektorom. Použi opatrne: veľké N môže opticky zlepšiť stabilitu, ale vytvorí oneskorenie." Style="{StaticResource SettingHelp}" />
                        <CheckBox Content="Priemerovať wavelength vzorky" IsChecked="{Binding EnableWavelengthAveraging}" Margin="0,2,0,8" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="N =" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <TextBox Style="{StaticResource SettingInput}" Width="110" Text="{Binding WavelengthAveragingSamples, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Samostatný časový trace wavelength umožňuje spätne vidieť celý nábeh, stabilizáciu aj meranie. Interval určuje frekvenciu zápisu do trace súboru, nie frekvenciu stability detektora.">
                    <StackPanel>
                        <TextBlock Text="Wavelength trace log" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Ukladá priebežný λ záznam pre audit a grafy. Odporúčané nechať zapnuté pri debugovaní kalibrácie." Style="{StaticResource SettingHelp}" />
                        <CheckBox Content="Zapisovať samostatný wavelength log" IsChecked="{Binding EnableWavelengthTraceLogging}" Margin="0,2,0,8" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Interval [s]" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <TextBox Style="{StaticResource SettingInput}" Width="110" Text="{Binding WavelengthTraceIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="4 · Kontrola správnej odozvy FBG na teplotu" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Po aspoň dvoch kalibračných bodoch aplikácia kontroluje, či sa wavelength pri zmene teploty reálne zmenila. Táto kontrola chráni pred nesprávnym peakom, SN alebo fyzicky nefunkčným snímačom." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}" ToolTip="Teplotný rozdiel medzi dvoma hotovými platami musí byť aspoň táto hodnota, inak sa validačný test ešte nevykoná.">
                    <StackPanel>
                        <TextBlock Text="Minimálna ΔT [°C]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Najmenšia zmena referenčnej teploty potrebná na zmysluplné overenie temperature-response." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ValidationMinimumDeltaTemperatureC, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}" ToolTip="Absolútna zmena wavelength medzi validačnými bodmi musí byť aspoň táto hodnota. Menšia odozva sa vyhodnotí ako podozrivá.">
                    <StackPanel>
                        <TextBlock Text="Minimálna Δλ [pm]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Najmenšia očakávaná wavelength odozva pri dostatočnej zmene teploty. Pomáha odhaliť zlý peak alebo nesprávne priradenie SN." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ValidationMinimumResponsePm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Background="#2A392A34" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="9" Padding="13,10" Margin="0,3,0,4">
                <StackPanel>
                    <CheckBox Content="Povoliť override pri zlyhaní temperature-response validácie"
                              IsChecked="{Binding AllowValidationOverride}" FontFamily="Segoe UI Semibold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,9"
                               Text="Override nepovažuje chybu za normálny výsledok. Použi ho iba po fyzickom overení SN, zapojenia a správneho peaku. Dôvod sa uloží do warningu kalibračného runu." />
                    <TextBlock Text="Povinný dôvod override" Style="{StaticResource SettingName}" />
                    <TextBox Style="{StaticResource SettingLongInput}" Text="{Binding ValidationOverrideReason, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Left" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Text="Počas spustenej kalibrácie sú tieto nastavenia zamknuté. Zmena limitov počas runu by zmenila rozhodovaciu logiku uprostred merania a výsledok by nebol auditovateľný." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
