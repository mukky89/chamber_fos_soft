<UserControl x:Class="VotschVc3.App.Views.CalibrationStabilitySettingsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource PanelGroup}">
            <Setter Property="Width" Value="360" />
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="13,11" />
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="Width" Value="130" />
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly" Padding="4,4,10,14">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}">
            <Border Background="#222B3B52" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="13,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Automatická teplotná kalibrácia · Pali parity" FontSize="16" FontFamily="Segoe UI Semibold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Poradie je pevné: 1. cieľ/rampa, 2. stabilná interná teplota komory, 3. stabilná WIKA/CTH7000, 4. stabilita každého FBG peaku, 5. nové finálne samples, 6. výpočet TEMP/FBGS koeficientov a PASS/FAIL. Ak sa teplota počas FBG fázy rozladí, nedokončené stability a meracie okná sa resetujú." />
                </StackPanel>
            </Border>

            <TextBlock Text="1 · Stabilita komory" Style="{StaticResource Heading}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Komora musí najprv sama dosiahnuť cieľ a stabilný interval. WIKA gate sa začne vyhodnocovať až potom." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Komora · tolerancia [°C]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Povolené pásmo internej sondy komory okolo cieľovej teploty." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ChamberToleranceC, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Komora · stabilný čas [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Ako dlho musí interná sonda bez prerušenia spĺňať toleranciu a drift." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ChamberStableMinutes, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Komora · max drift [°C/min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Maximálny absolútny lineárny trend teploty komory. 0 = nekontrolovať drift." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ChamberMaxDriftCPerMinute, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Komora · timeout [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Maximálny čas na dosiahnutie stabilnej komory po uplynutí minimálneho kalibračného hold času." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ChamberStabilityTimeoutMinutes, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Min. calibration hold [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Minimálny čas od nastavenia kalibračného bodu. 0 = rozhoduje iba meraná stabilita. Toto nie je obyčajný profile hold." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding MinimumCalibrationPointMinutes, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="2 · Stabilita referencie WIKA / CTH7000" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Ak je referencia priradená, je povinná. Chýbajúca WIKA sa nenahrádza internou sondou komory. Bez priradenej WIKA sa ako referencia použije komora." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="WIKA · tolerancia [°C]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Samostatné akceptované pásmo referenčného teplomera okolo cieľovej teploty." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ReferenceToleranceC, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="WIKA · stabilný čas [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Ako dlho musí WIKA súvisle spĺňať toleranciu a drift po stabilizácii komory." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ReferenceStableMinutes, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="WIKA · max drift [°C/min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Maximálny absolútny trend referenčnej teploty. 0 = nekontrolovať drift." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ReferenceMaxDriftCPerMinute, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="WIKA · stability timeout [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Maximálny čas na stabilizáciu WIKA po stabilizovaní komory." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ReferenceStabilityTimeoutMinutes, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="3 · Stabilita jednotlivých FBG peakov" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Každý označený peak má vlastné rolling okno. Jeden peak už môže zbierať finálne samples, zatiaľ čo druhý sa ešte stabilizuje." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Počet samples pre stabilitu" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Počet posledných λ vzoriek potrebných na vyhodnotenie range + StdDev + drift." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding RequiredStableSamples, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Max. range [pm]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Maximum λ - minimum λ v rolling okne. 0 = nevynucovať." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding MaxRangePm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Max. StdDev [pm]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Smerodajná odchýlka wavelength vzoriek. 0 = nevynucovať." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding MaxStdDevPm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Max. drift [pm/min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Absolútny lineárny trend wavelength. 0 = nevynucovať." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding MaxDriftPmPerMinute, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="FBG peak timeout [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Bezpečnostný limit aktívnej FBG fázy. Počíta sa iba počas otvoreného teplotného gate." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding SensorTimeoutMinutes, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="4 · Finálne meranie a logovanie" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Stabilizačné samples sa nikdy nepoužijú ako finálny kalibračný priemer. Po potvrdení stability sa pre daný peak začne úplne nové meracie okno." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Počet finálnych measurement samples" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Samostatné N pre finálny kalibračný priemer. Zodpovedá Paliho measured_samples a je nezávislé od stability samples." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding RequiredMeasurementSamples, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Priemerovanie wavelength" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Voliteľný pre-filter pred stability detektorom. Veľké N pridáva oneskorenie." Style="{StaticResource SettingHelp}" />
                        <CheckBox Content="Priemerovať wavelength vzorky" IsChecked="{Binding EnableWavelengthAveraging}" Margin="0,2,0,8" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="N =" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <TextBox Width="100" Text="{Binding WavelengthAveragingSamples, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Wavelength trace log" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Priebežný λ záznam pre audit a spätné grafy počas celého runu." Style="{StaticResource SettingHelp}" />
                        <CheckBox Content="Zapisovať samostatný wavelength log" IsChecked="{Binding EnableWavelengthTraceLogging}" Margin="0,2,0,8" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Interval [s]" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <TextBox Width="100" Text="{Binding WavelengthTraceIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="5 · Recovery pri výpadku zariadenia" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="PeakLogger používa produkčne WaitAndRecover. Pri chýbajúcej WIKA alebo dočasnom PeakLogger výpadku sa nedokončené FBG okná zahodia a kalibrácia skúša zariadenie znovu až do recovery timeoutu." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Device recovery timeout [min]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Ako dlho môže kalibrácia čakať na návrat WIKA/PeakLogger pred zásahom operátora." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding DeviceRecoveryTimeoutMinutes, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Recovery polling [s]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Interval medzi ďalšími pokusmi počas recovery režimu." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding DeviceRecoveryPollSeconds, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="6 · Kontrola správnej odozvy FBG na teplotu" Style="{StaticResource Heading}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Po minimálne dvoch vhodne vzdialených bodoch aplikácia kontroluje, či zvolený peak reálne reaguje na zmenu referenčnej teploty. Po skončení celého profilu nasleduje product-specific TEMP/FBGS fit, sensitivity, MaxError, R² a PASS/FAIL." />
            <WrapPanel>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Minimálna ΔT [°C]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Najmenšia zmena referenčnej teploty pre temperature-response kontrolu." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ValidationMinimumDeltaTemperatureC, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Minimálna Δλ [pm]" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Najmenšia očakávaná wavelength odozva pri dostatočnej zmene teploty." Style="{StaticResource SettingHelp}" />
                        <TextBox Style="{StaticResource SettingInput}" Text="{Binding ValidationMinimumResponsePm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Background="#2A392A34" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="13,10" Margin="0,3,0,4">
                <StackPanel>
                    <CheckBox Content="Povoliť override pri zlyhaní temperature-response validácie"
                              IsChecked="{Binding AllowValidationOverride}" FontFamily="Segoe UI Semibold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,9"
                               Text="Override musí zostať auditovateľný. Product-specific finálny PASS/FAIL sa počíta samostatne z recipe limitov." />
                    <TextBlock Text="Dôvod override" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding ValidationOverrideReason, UpdateSourceTrigger=LostFocus}"
                             MinWidth="420" MinHeight="31" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
