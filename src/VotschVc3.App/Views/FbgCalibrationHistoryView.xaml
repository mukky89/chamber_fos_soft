<UserControl x:Class="VotschVc3.App.Views.FbgCalibrationHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="560">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="4,0,4,14">
            <Button DockPanel.Dock="Right" Content="Otvoriť hlavný priečinok" Style="{StaticResource AccentButton}"
                    Command="{Binding OpenRootFolderCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Obnoviť" Command="{Binding RefreshCommand}" />
            <Button DockPanel.Dock="Left" Content="← Späť" Style="{StaticResource GhostButton}"
                    Command="{Binding DataContext.GoHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,14,0" />
            <StackPanel>
                <TextBlock Text="FBG kalibrácie" FontSize="25" FontFamily="Segoe UI Semibold" />
                <TextBlock Text="Prehľad uložených behov, priečinkov a výsledkov jednotlivých snímačov."
                           Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" MinWidth="300" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Všetky kalibrácie" Style="{StaticResource Label}" Margin="2,0,0,9" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Calibrations}" SelectedItem="{Binding SelectedCalibration}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" EnableRowVirtualization="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Začiatok" Binding="{Binding Run.StartedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="125" />
                            <DataGridTextColumn Header="Kalibrácia" Binding="{Binding Run.DisplayRunId}" Width="135" />
                            <DataGridTextColumn Header="Komora" Binding="{Binding Run.ChamberName}" Width="110" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding Run.State}" Width="90" />
                            <DataGridTextColumn Header="Snímače" Binding="{Binding SensorCount}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent" />
            <Grid Grid.Column="2" DataContext="{Binding SelectedCalibration}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Run.DisplayRunId, TargetNullValue='Vyber kalibráciu zo zoznamu'}" FontSize="18" FontFamily="Segoe UI Semibold" />
                            <TextBlock Text="{Binding ProfileDisplay}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Run.Operator, StringFormat='Operátor: {0}'}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" ToolTip="{Binding FolderPath}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Otvoriť priečinok kalibrácie" Style="{StaticResource AccentButton}"
                                Command="{Binding DataContext.OpenSelectedFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                VerticalAlignment="Top" Margin="14,0,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Výsledky snímačov" Style="{StaticResource Label}" Margin="2,0,0,9" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Run.CalibrationResults}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" FrozenColumnCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SN snímača" Binding="{Binding SerialNumber}" MinWidth="135" />
                                <DataGridTextColumn Header="Kanál" Binding="{Binding Channel}" Width="75" />
                                <DataGridTextColumn Header="Peak" Binding="{Binding PeakId}" Width="80" />
                                <DataGridTextColumn Header="Typ kalibrácie" Binding="{Binding CalibrationType}" MinWidth="125" />
                                <DataGridTextColumn Header="Body" Binding="{Binding PointCount}" Width="60" />
                                <DataGridTextColumn Header="Od [°C]" Binding="{Binding MinimumTemperatureC, StringFormat=F3}" Width="85" />
                                <DataGridTextColumn Header="Do [°C]" Binding="{Binding MaximumTemperatureC, StringFormat=F3}" Width="85" />
                                <DataGridTextColumn Header="λ Tref [nm]" Binding="{Binding LambdaTRefNm, StringFormat=F6}" Width="105" />
                                <DataGridTextColumn Header="Citlivosť [pm/°C]" Binding="{Binding SensitivityPmPerC, StringFormat=F3}" Width="125" />
                                <DataGridTextColumn Header="Max. chyba [°C]" Binding="{Binding MaxErrorC, StringFormat=F3}" Width="115" />
                                <DataGridTextColumn Header="R²" Binding="{Binding RSquared, StringFormat=F6}" Width="80" />
                                <DataGridTextColumn Header="Výsledok" Binding="{Binding Result}" Width="80" />
                                <DataGridTextColumn Header="Stabilita" Binding="{Binding StabilityStatus}" Width="85" />
                                <DataGridTextColumn Header="Problém stability" Binding="{Binding StabilityProblem}" MinWidth="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="4,10,4,0" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RunsFolder}" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
