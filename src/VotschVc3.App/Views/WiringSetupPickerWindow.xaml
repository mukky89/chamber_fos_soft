<Window x:Class="VotschVc3.App.Views.WiringSetupPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vybrať uložené zapojenie" Width="1200" Height="730" MinWidth="800" MinHeight="560"
 Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Vyberte zapojenie podľa komory, profilu a snímačov" Style="{StaticResource Heading}" TextWrapping="Wrap"/>
   <TextBlock Text="Zálohy obsahujú starší stav. Pred načítaním si skontrolujte dátum a výrobné čísla SN." Style="{StaticResource Caption}" Margin="0,8" TextWrapping="Wrap"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,4,0,12">
   <CheckBox x:Name="Backups" Content="Zobraziť aj zálohy" IsChecked="True" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
   <TextBlock Text="Hľadať komoru, profil alebo SN:" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Hľadať komoru, profil, názov snímača alebo SN"/>
  </DockPanel>
  <DataGrid x:Name="Entries" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" SelectionChanged="SelectionChanged" MouseDoubleClick="LoadDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Komora" Binding="{Binding Chamber}" Width="180"/>
    <DataGridTextColumn Header="Profil" Binding="{Binding Profile}" Width="230"/>
    <DataGridTextColumn Header="Uložené / zmenené" Binding="{Binding SavedText}" Width="155"/>
    <DataGridTextColumn Header="Druh záznamu" Binding="{Binding Kind}" Width="155"/>
    <DataGridTextColumn Header="Peaky / vybrané" Binding="{Binding CountText}" Width="150"/>
    <DataGridTextColumn Header="Snímače" Binding="{Binding Sensors}" Width="180"/>
    <DataGridTextColumn Header="Výrobné čísla SN" Binding="{Binding SerialNumbers}" Width="250"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12">
   <TextBlock x:Name="Status" Text="Načítavam uložené zapojenia…" TextWrapping="Wrap"/>
   <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Detail" TextWrapping="Wrap" Margin="0,8,0,0"/></ScrollViewer>
   <Expander Header="Umiestnenie pôvodného súboru" Margin="0,8,0,0"><TextBox x:Name="SourcePath" IsReadOnly="True" ToolTip="Pôvodný interný súbor – nie je potrebné rozpoznávať jeho ID"/></Expander>
  </StackPanel>
  <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
   <Button Content="Iný súbor…" Click="Browse_Click" Margin="0,0,8,8"/>
   <Button x:Name="ExportButton" Content="Uložiť čitateľnú kópiu…" Click="Export_Click" IsEnabled="False" Margin="0,0,8,8"/>
   <Button x:Name="LoadButton" Content="Načítať vybrané zapojenie" Click="Load_Click" Style="{StaticResource AccentButton}" IsEnabled="False" Margin="0,0,8,8"/>
   <Button Content="Zrušiť" IsCancel="True" Margin="0,0,0,8"/>
  </WrapPanel>
 </Grid>
</Window>
