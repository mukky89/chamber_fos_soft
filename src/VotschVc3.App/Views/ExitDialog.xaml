<Window x:Class="VotschVc3.App.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ukončiť aplikáciu"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <!-- High-visibility destructive confirmation, still consistent with the dark theme. -->
    <Border Margin="18" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource DangerBrush}" BorderThickness="2" Width="520"
            ClipToBounds="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel Margin="28,25,28,24">
            <StackPanel Orientation="Horizontal">
                <Border Width="58" Height="58" CornerRadius="29" Background="#2FE2555B"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="2" VerticalAlignment="Top">
                    <Viewbox Width="34" Height="34">
                        <Canvas Width="32" Height="32">
                            <Path Data="M 16,2 L 30,28 L 2,28 Z" Fill="Transparent"
                                  Stroke="{StaticResource DangerBrush}" StrokeThickness="2.2"
                                  StrokeLineJoin="Round" />
                            <Path Data="M 16,10 L 16,19" Stroke="{StaticResource DangerBrush}"
                                  StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Width="3.2" Height="3.2" Canvas.Left="14.4" Canvas.Top="22"
                                     Fill="{StaticResource DangerBrush}" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="18,1,0,0">
                    <TextBlock Text="Naozaj ukončiť aplikáciu?" FontSize="21" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,7,0,0" MaxWidth="380" HorizontalAlignment="Left"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Úplným ukončením sa zastaví riadenie aj monitorovanie všetkých zariadení." />
                </StackPanel>
            </StackPanel>

            <Border Margin="0,20,0,18" Padding="13,10" CornerRadius="8"
                    Background="#18E2555B" BorderBrush="#70E2555B" BorderThickness="1">
                <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                           Text="Ak má aplikácia ďalej riadiť komoru, zvoľte Skryť do tray." />
            </Border>

            <!-- Actions: destructive exit clearly separated from the safe options. -->
            <Grid>
                <Button Content="Zrušiť" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        MinWidth="92" MinHeight="42" Padding="16,9" Click="Cancel_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Skryť do tray" Style="{StaticResource AccentOutlineButton}"
                            MinWidth="132" MinHeight="42" Padding="17,9" Margin="0,0,10,0" Click="Tray_Click"
                            ToolTip="Skryje okno, aplikácia beží ďalej v oznamovacej oblasti." />
                    <Button Content="Áno, ukončiť" Style="{StaticResource DangerButton}"
                            MinWidth="128" MinHeight="42" Padding="18,9"
                            Click="Exit_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
