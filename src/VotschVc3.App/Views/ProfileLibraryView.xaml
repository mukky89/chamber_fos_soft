<UserControl x:Class="VotschVc3.App.Views.ProfileLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VotschVc3.App.Views"
             xmlns:vm="clr-namespace:VotschVc3.App.ViewModels"
             xmlns:core="clr-namespace:VotschVc3.Core.Profiles;assembly=VotschVc3.Core">
    <UserControl.Resources>
        <!-- Chips used for both sensors and tags in the preview -->
        <DataTemplate x:Key="ChipTemplate">
            <Border Background="{Binding Converter={StaticResource TagBrush}, ConverterParameter=bg}"
                    BorderBrush="{Binding Converter={StaticResource TagBrush}, ConverterParameter=border}"
                    BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,5,5">
                <TextBlock Text="{Binding}" FontSize="11"
                           Foreground="{Binding Converter={StaticResource TagBrush}, ConverterParameter=fg}" />
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ChipPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="6,2,6,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Domov" Command="{Binding DataContext.GoHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Zoznam profilov" FontSize="17" FontFamily="Segoe UI Semibold" />
                    <TextBlock Text="Náhľad uložených profilov. Vytváranie aj úpravy sa robia v rýchlom profile."
                               Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RefreshHistoryCommand}"
                        ToolTip="Znovu načíta uložené profily zo súboru (automaticky sa obnovia aj pri vstupe sem).">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}" />
                        <TextBlock Text="Obnoviť" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewProfileCommand}" Style="{StaticResource AccentButton}"
                        ToolTip="Otvorí rýchly profil s prázdnym (novým) profilom. Import, export aj úpravy nájdeš tam.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}" />
                        <TextBlock Text="Nový profil (rýchly profil)" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Library tree + filters -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Uložené profily" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                            <Button DockPanel.Dock="Right" Content="↻" Style="{StaticResource GhostButton}" Padding="8,1"
                                    Command="{Binding RefreshHistoryCommand}" ToolTip="Obnoviť zoznam zo súboru" />
                        </DockPanel>

                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 Margin="0,6,0,0" ToolTip="Filtruje podľa názvu, zákazníka, projektu, snímača aj tagov." />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableTags}" SelectedItem="{Binding SelectedTag}"
                                      ToolTip="Filtrovať podľa tagu." />
                            <Button Grid.Column="2" Content="✕ Filter" Style="{StaticResource GhostButton}" Padding="10,4"
                                    Command="{Binding ClearFilterCommand}" ToolTip="Zrušiť text, tag aj filter zariadenia." />
                        </Grid>
                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding DeviceKinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding DeviceKindFilter, Mode=TwoWay}"
                                  ToolTip="Filtrovať podľa zariadenia: Vötsch (rampy a plata) alebo SIKA (teploty s dobou výdrže). Univerzálny = bez filtra." />
                        <DockPanel Margin="0,6,0,2" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="⏷ Rozbaliť všetko" Style="{StaticResource GhostButton}"
                                    Padding="8,3" Command="{Binding ExpandAllCommand}" />
                            <Button DockPanel.Dock="Left" Content="⏶ Zbaliť všetko" Style="{StaticResource GhostButton}"
                                    Padding="8,3" Margin="6,0,0,0" Command="{Binding CollapseAllCommand}" />
                        </DockPanel>
                    </StackPanel>

                    <TreeView Grid.Row="1" ItemsSource="{Binding ProfileTree}" Margin="0,4,0,0"
                              Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="ProfileTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <!-- Sensor group node -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:ProfileTreeGroupViewModel}"
                                                      ItemsSource="{Binding Profiles}">
                                <TextBlock Text="{Binding DisplayHeader}" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            </HierarchicalDataTemplate>
                            <!-- Profile leaf node -->
                            <DataTemplate DataType="{x:Type core:TestProfile}">
                                <StackPanel ToolTip="Klik zobrazí náhľad profilu vpravo. Upraviť sa dá tlačidlom „✎ Upraviť v rýchlom profile“.">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" CornerRadius="5" Padding="6,1" Margin="0,0,7,0"
                                                BorderThickness="1"
                                                BorderBrush="{Binding ValidationStatus, Converter={StaticResource ProfileStatusToBrush}}"
                                                ToolTip="{Binding ValidationStatusDescription}">
                                            <TextBlock Text="{Binding ValidationStatus}" FontSize="10.5" FontFamily="Segoe UI Semibold"
                                                       Foreground="{Binding ValidationStatus, Converter={StaticResource ProfileStatusToBrush}}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="!" FontSize="15" Margin="7,0,0,0"
                                                   FontFamily="Segoe UI Semibold" Foreground="{StaticResource WarnBrush}"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding CodeAndName}" FontFamily="Segoe UI Semibold" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm', Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding DeviceKindLabel, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Segments.Count, Mode=OneWay}" />
                                        <Run Text=" segm." />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0"
                                                  ItemsPanel="{StaticResource ChipPanel}"
                                                  ItemTemplate="{StaticResource ChipTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <TextBlock Grid.Row="2" Text="{Binding TreeSummary}" Style="{StaticResource Caption}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" />

            <!-- Preview of the selected profile -->
            <Grid Grid.Column="2">
                <!-- Empty state -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Vyber profil zo zoznamu vľavo" FontSize="16" FontFamily="Segoe UI Semibold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Zobrazí sa jeho priebeh, doba trvania aj parametre. Upravovať sa dá v rýchlom profile."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Facts -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding PreviewName}" FontSize="16"
                                           FontFamily="Segoe UI Semibold" TextWrapping="Wrap" MaxWidth="620"
                                           HorizontalAlignment="Left" />
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Run Text="Trvanie: " Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding ProfileDurationText, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding PreviewMeta}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding HasPreviewOwner, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Zákazník / projekt: " Foreground="{StaticResource MutedBrush}" />
                                <Run Text="{Binding PreviewOwner, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding HasOriginalName, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Starý názov: " Foreground="{StaticResource MutedBrush}" />
                                <Run Text="{Binding OriginalName, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                            </TextBlock>
                            <TextBlock Text="{Binding CycleRegionText}" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,7,0,0">
                                <Border CornerRadius="6" Padding="8,2" BorderThickness="1"
                                        BorderBrush="{Binding PreviewValidationStatus, Converter={StaticResource ProfileStatusToBrush}}">
                                    <TextBlock Text="{Binding PreviewValidationStatus}" FontFamily="Segoe UI Semibold"
                                               Foreground="{Binding PreviewValidationStatus, Converter={StaticResource ProfileStatusToBrush}}" />
                                </Border>
                                <TextBlock Text="?" Margin="7,0,0,0" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource AccentBrush}"
                                           ToolTip="OK – všetko je v poriadku, môže sa používať.&#10;NOK – NOT OK, nepoužívať.&#10;WIP – WORK IN PROGRESS, rozpracované.&#10;TBT – TO BE TESTED, musí sa otestovať." />
                            </WrapPanel>
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource WarnBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,8,0,0"
                                    Visibility="{Binding HasPreviewWarning, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="!" FontSize="18" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource WarnBrush}" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding PreviewWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,8,0,0"
                                    Visibility="{Binding HasPreviewNotes, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Poznámka" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding PreviewNotes}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding PreviewSensors}" Margin="0,8,0,0"
                                          ItemsPanel="{StaticResource ChipPanel}" ItemTemplate="{StaticResource ChipTemplate}" />
                            <ItemsControl ItemsSource="{Binding PreviewTags}"
                                          ItemsPanel="{StaticResource ChipPanel}" ItemTemplate="{StaticResource ChipTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- The same chart the quick profile builder draws, read-only -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Náhľad priebehu (teplota)" Style="{StaticResource Label}"
                                       ToolTip="Iba náhľad – body sa tu neťahajú. Priblíženie: koliesko myši, dvojklik vráti celý profil.&#10;Pri cyklovaní je každé opakovanie tela profilu vykreslené zvlášť a očíslované (⟲ 2/4)." />
                            <views:ProfileEditorChart Grid.Row="1" MinHeight="240" IsReadOnly="True"
                                                      Segments="{Binding Segments}"
                                                      CycleStart="{Binding CycleBandStart}" CycleEnd="{Binding CycleBandEnd}"
                                                      CycleCount="{Binding Cycles}" />
                            <views:ChartView Grid.Row="2" Height="120" Margin="0,6,0,0" Unit=" %"
                                             Visibility="{Binding SupportsHumidity, Converter={StaticResource BoolToVisibility}}"
                                             Series="{Binding HumPreview}" />
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="✎ Upraviť v rýchlom profile" Style="{StaticResource AccentButton}"
                                        Command="{Binding EditProfileCommand}" Margin="0,0,8,0"
                                        ToolTip="Načíta profil do rýchleho profilu, kde sa dá upraviť, uložiť, importovať aj exportovať." />
                                <Button Content="Duplikovať (COPY)" Command="{Binding DuplicateProfileCommand}" Margin="0,0,8,0"
                                        ToolTip="Vytvorí kópiu vybraného profilu s príponou „COPY“ v názve." />
                                <Button Content="⇄ Previesť na SIKA profil" Command="{Binding ConvertToSikaCommand}" Margin="0,0,8,0"
                                        ToolTip="Z vybraného Vötsch profilu spraví SIKA profil: teploty a doby výdrže zostanú, rampy medzi nimi sa vynechajú (kúpeľ si na setpoint nabehne sám). Uloží sa ako nový profil, pôvodný zostane nezmenený." />
                                <Button Content="Zmazať" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                        Command="{Binding DeleteFromHistoryCommand}"
                                        ToolTip="Vymaže vybraný profil z knižnice (s potvrdením)." />
                                <Button Content="🗑 Vymazať všetky profily (admin)" Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteAllProfilesCommand}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Iba admin – vyžaduje heslo. Vymaže úplne celú knižnicu profilov." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="6,10,6,0" Padding="14,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
