<UserControl x:Class="VotschVc3.App.Views.ProfessionalHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VotschVc3.App.Views">
    <!--
        Professional control mode: a dense operational-center dashboard —
        alternative to HomeView, selected in Administrácia → Vzhľad a
        ovládanie → Režim ovládania. Every value/command below binds to the
        same ShellViewModel / ChamberViewModel the Classic dashboard uses.
    -->
    <UserControl.Resources>
        <Style x:Key="ProNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ProfessionalSidebarCollapsed, Converter={StaticResource BoolToGridLength}, ConverterParameter=196}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar (collapsible) ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="6,4,10,4" Padding="12,14"
                Visibility="{Binding ProfessionalSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Riadenie zariadení" FontFamily="Segoe UI Semibold" FontSize="14" TextWrapping="Wrap" />
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="7,2" Margin="0,7,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="PROFESIONÁLNY REŽIM" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="10.5" />
                    </Border>
                    <Separator Margin="0,12,0,8" Background="{StaticResource BorderBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,8,0,8" Background="{StaticResource BorderBrush}" />
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="9,6">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                            <Run Text=" · " /><Run Text="{Binding CurrentRoleLabel, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Button Style="{StaticResource ProNavButton}" Margin="0,6,0,0" Command="{Binding LogoutCommand}" Content="Odhlásiť" />
                </StackPanel>

                <StackPanel VerticalAlignment="Top">
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenProfileLibraryCommand}" Content="Zoznam profilov" />
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenQuickProfileCommand}" Content="Rýchly profil" />
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenThermometersCommand}" Content="Teplomery WIKA CTH7000" />
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenRecordingViewerCommand}" Content="Prehliadač záznamov" />
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenAuditCommand}" Content="Audit trail" />
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenAppLogCommand}" Content="App log" />
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenChangelogCommand}" Content="Changelog" />
                    <Button Style="{StaticResource ProNavButton}" Command="{Binding OpenAdminCommand}" Content="Administrácia"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Top status bar ===== -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,4,7,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="9,7" Margin="0,0,10,0"
                            Command="{Binding ToggleProfessionalSidebarCommand}" Content="☰"
                            ToolTip="Zbaliť / rozbaliť bočný panel" />
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="KLIMATICKÉ KOMORY" FontFamily="Segoe UI Semibold" FontSize="16" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="0 zariadení" />
                    </StackPanel>
                    <TextBlock x:Name="ClockText" DockPanel.Dock="Right" VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatChip}" Margin="0,0,14,0">
                        <TextBlock x:Name="AlarmChipText" Text="0 upozornení" FontFamily="Segoe UI Semibold" FontSize="12.5"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatChip}">
                        <TextBlock x:Name="ActiveChipText" Text="0 aktívne" FontFamily="Segoe UI Semibold" FontSize="12.5"
                                   Foreground="{StaticResource OkBrush}" />
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FbgCalibration.IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontFamily="Segoe UI Semibold" FontSize="12.5">
                                <Run Text="FBG · " /><Run Text="{Binding FbgCalibration.StateText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ===== Alarm center ===== -->
            <Border x:Name="AlarmPanel" Grid.Row="1" Style="{StaticResource Card}" Margin="0,7,7,0"
                    BorderBrush="{StaticResource DangerBrush}"
                    Visibility="{Binding ShowAlarmCenter, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="AlarmHeaderText" Text="⚠ 0 upozornení" FontFamily="Segoe UI Semibold" FontSize="14"
                               Foreground="{StaticResource DangerBrush}" />
                    <ItemsControl x:Name="AlarmItemsControl" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="10,7" Margin="0,0,0,5"
                                        Cursor="Hand" MouseLeftButtonUp="AlarmRow_MouseLeftButtonUp">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" TextWrapping="Wrap">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                                            <Run Text=" — " Foreground="{StaticResource MutedBrush}" />
                                            <Run Text="{Binding AlarmMessage, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Right" Text="Detail →" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoAlarmsText" Style="{StaticResource Caption}" Text="Žiadne aktívne upozornenia." />
                </StackPanel>
            </Border>

            <!-- ===== Timeline (reuses the same Gantt component as the Classic dashboard) ===== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,7,7,0"
                    Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Časová os zariadení" Style="{StaticResource Heading}" DockPanel.Dock="Left" Margin="0" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="■" Foreground="{StaticResource AccentBrush}" /><Run Text=" profil    " />
                            <Run Text="■" Foreground="{StaticResource DangerBrush}" /><Run Text=" FBG kalibrácia    " />
                            <Run Text="■" Foreground="{StaticResource OkBrush}" /><Run Text=" manuálny beh" />
                        </TextBlock>
                    </DockPanel>
                    <views:FleetGanttView Chambers="{Binding VisibleChambers}" Margin="0,8,0,0"
                                          ToolTip="Prejdi myšou po pruhu – ukáže profil a časy od–do." />
                </StackPanel>
            </Border>

            <!-- ===== Device grid ===== -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Margin="0,7,3,0">
                <ItemsControl ItemsSource="{Binding VisibleChambers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ProfessionalDeviceCard
                                Shell="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type views:ProfessionalHomeView}}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
