<UserControl x:Class="VotschVc3.App.Views.QuickProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VotschVc3.App.Views">
    <UserControl.Resources>
        <Style x:Key="QpField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- One visual group ("chlievik") of related fields. The parameter column is long
             and used to read as a single undifferentiated list of inputs; boxing each
             category makes it scannable. Nested panel colour per the design system. -->
        <Style x:Key="QpGroup" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Import / export lives here now: the profile editor screen it used to sit on is
             gone, and this is where a profile is actually built, saved and taken in or out
             of the library. Every button says in its tooltip what it does. -->
        <DockPanel Grid.Row="0" Margin="6,2,6,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="← Domov" VerticalAlignment="Center"
                    Command="{Binding DataContext.GoHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock DockPanel.Dock="Left" Text="Rýchly vytvárač profilov" FontSize="17" FontFamily="Segoe UI Semibold"
                       VerticalAlignment="Center" Margin="10,0,14,0" />
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Command="{Binding NewCommand}" Margin="0,0,6,4" Padding="10,6"
                        ToolTip="Vyprázdni vytvárač a začne nový profil od predvolených parametrov. Rozrobené neuložené úpravy sa zahodia.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}" />
                        <TextBlock Text="Nový" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportProfileCommand}" Margin="0,0,6,4" Padding="10,6"
                        ToolTip="Načíta JEDEN profil zo súboru (Vötsch/SIMPATI .dat/.prg/.b??, CSV, TXT alebo JSON) do vytvárača. Profil sa uloží do knižnice až tlačidlom „Uložiť do knižnice“.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Import}" />
                        <TextBlock Text="Import…" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding BulkImportCommand}" Margin="0,0,6,4" Padding="10,6"
                        ToolTip="Naimportuje VIAC súborov naraz. V okne vidíš každý profil, môžeš ho premenovať a zjednotiť podľa štandardu (nábeh na prvú teplotu + koniec na izbovú) a uložiť všetky naraz do knižnice.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.List}" />
                        <TextBlock Text="Hromadný import…" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportLibraryCommand}" Margin="0,0,6,4" Padding="10,6"
                        ToolTip="Pridá do knižnice všetky profily z jedného JSON súboru vytvoreného tlačidlom „Hromadný export“. Profily, ktoré už v knižnici sú, sa preskočia.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Folder}" />
                        <TextBlock Text="Import knižnice…" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportProfileCommand}" Margin="0,0,6,4" Padding="10,6"
                        ToolTip="Uloží profil práve otvorený vo vytvárači do súboru – CSV (otvoriteľné v Exceli / pre Vötsch) alebo JSON.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}" />
                        <TextBlock Text="Export…" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportLibraryCommand}" Margin="0,0,0,4" Padding="10,6"
                        ToolTip="Vyber viac profilov z knižnice a ulož ich do jedného JSON súboru – záloha alebo prenos na iný počítač (naspäť cez „Import knižnice“).">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" />
                        <TextBlock Text="Hromadný export…" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </DockPanel>

        <!-- The parameter column starts wider and can be dragged: profile names, tags and
             the sequence rows never fit in a fixed 360 px, and how much room they need
             depends on the profile being built. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" MinWidth="340" MaxWidth="900" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ===== Vstupy ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                    <Border Style="{StaticResource QpGroup}">
                        <StackPanel>
                        <TextBlock Text="Zariadenie" Style="{StaticResource Heading}" />
                        <StackPanel Style="{StaticResource QpField}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Vötsch / Weiss" IsChecked="{Binding IsVotschProfile}" VerticalAlignment="Center"
                                             ToolTip="Komora sa riadi rampou: medzi dvoma teplotami sa vygeneruje nábeh a potom plato." />
                                <RadioButton Content="SIKA TP" IsChecked="{Binding IsSikaProfile}" Margin="18,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Kúpeľ si na setpoint nabehne sám – profil je len zoznam teplôt s dobou výdrže (dwell), bez rámp." />
                            </StackPanel>
                            <TextBlock Text="{Binding DeviceKindHint}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Humidity only exists on a Vötsch VC3 (temperature + humidity); a SIKA
                         bath has no humidity channel, so the whole group is hidden for it. -->
                    <Border Style="{StaticResource QpGroup}"
                            Visibility="{Binding SupportsHumidity, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Vlhkosť" Style="{StaticResource Heading}" />
                            <CheckBox Content="Riadiť vlhkosť (komora s vlhkosťou)" IsChecked="{Binding ControlHumidity}"
                                      ToolTip="Zapni pre komoru typu VC3. Každý krok profilu potom dostane nastavenú vlhkosť a profil sa uloží ako „Teplota + vlhkosť“, takže ho teplotná komora neponúkne." />
                            <StackPanel Style="{StaticResource QpField}" Margin="0,8,0,0"
                                        Visibility="{Binding ControlHumidity, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Relatívna vlhkosť (% r.v.)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding HumidityPercent, Mode=TwoWay}" Step="5" Minimum="0" Maximum="100" />
                                <TextBlock Text="Platí pre celý profil – rovnaká vlhkosť pri každej teplote."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QpGroup}">
                        <StackPanel>
                        <TextBlock Text="Profil" Style="{StaticResource Heading}" />
                        <TextBlock Text="Načítať existujúci" Style="{StaticResource Label}" />
                        <StackPanel Style="{StaticResource QpField}">
                            <views:ProfilePicker ItemsSource="{Binding LibraryProfiles}"
                                                  SelectedProfile="{Binding SelectedLibraryProfile, Mode=TwoWay}"
                                                  Placeholder="Vyber profil"
                                                  ToolTip="Vyber uložený profil – hľadaj hore a rozbaľ stromovú štruktúru (zákazník/snímač → profily). Vybraný profil sa hneď načíta do editora aj do grafu." />
                            <TextBlock Text="Vybraný profil sa načíta hneď – graf aj parametre ukážu presne to, čo je uložené."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Button Content="↺ Načítať znovu (zahodiť úpravy)" Style="{StaticResource GhostButton}"
                                    Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Command="{Binding LoadSelectedProfileCommand}"
                                    ToolTip="Znovu načíta vybraný profil z knižnice a zahodí rozrobené úpravy – sweep sa vráti v režime „Sweep (rozsah)“ s rozsahom, krokmi a platom, ostatné ako postupnosť teplôt. Uloženie prepíše ten istý profil." />
                        </StackPanel>

                        <StackPanel Style="{StaticResource QpField}">
                            <TextBlock Text="Predpona názvu (voliteľné)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Napr. kód projektu alebo vzorky – vloží sa pred automaticky generovaný názov." />
                        </StackPanel>

                        <StackPanel Style="{StaticResource QpField}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Názov profilu" Style="{StaticResource Label}" DockPanel.Dock="Left" />
                                <Button DockPanel.Dock="Right" Content="Automaticky" Style="{StaticResource GhostButton}"
                                        Padding="8,1" Command="{Binding ResetNameCommand}"
                                        ToolTip="Znovu vygenerovať názov z parametrov sweepu." />
                            </DockPanel>
                            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding NameModeText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QpGroup}">
                        <StackPanel>
                        <TextBlock Text="Zaradenie profilu" Style="{StaticResource Heading}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Zákazník" Style="{StaticResource Label}" />
                                <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding KnownCustomers}"
                                          Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Napíš nového zákazníka, alebo vyber existujúceho zo zoznamu." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Projekt" Style="{StaticResource Label}" />
                                <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding KnownProjects}"
                                          Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Napíš nový projekt, alebo vyber existujúci zo zoznamu." />
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource QpField}">
                            <TextBlock Text="Snímače" Style="{StaticResource Label}" />
                            <views:TagEditor Items="{Binding EditorSensors, Mode=OneWay}" Suggestions="{Binding KnownSensors}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource QpField}">
                            <TextBlock Text="Tagy" Style="{StaticResource Label}" />
                            <views:TagEditor Items="{Binding EditorTags, Mode=OneWay}" Suggestions="{Binding KnownTags}" />
                        </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QpGroup}">
                        <StackPanel>
                        <TextBlock Text="Režim" Style="{StaticResource Heading}" Margin="0,4,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Sweep (rozsah)" IsChecked="{Binding IsParametricMode}"
                                         VerticalAlignment="Center"
                                         ToolTip="Symetrický sweep: od–do, počet krokov, voliteľne späť dole." />
                            <RadioButton Content="Postupnosť teplôt" IsChecked="{Binding IsSequenceMode}"
                                         Margin="16,0,0,0" VerticalAlignment="Center"
                                         ToolTip="Zoznam teplotných bodov, každý s vlastnou dĺžkou plata – medzi každou dvojicou sa vygeneruje rampa." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSequenceMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource QpField}">
                                <TextBlock Text="Rýchle pridanie (oddelené bodkočiarkou)" Style="{StaticResource Label}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewSequenceTemperatures, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Napr. 20;30,5;60 – každá hodnota sa pridá ako nový bod s aktuálnou dĺžkou plata (uprav ju potom priamo pri bode nižšie).">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddSequenceStepsFromTextCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="2" Content="＋ Pridať" Padding="10,0"
                                            Command="{Binding AddSequenceStepsFromTextCommand}"
                                            ToolTip="Pridá zadané teploty ako nové body na koniec postupnosti." />
                                </Grid>
                            </StackPanel>

                            <StackPanel Style="{StaticResource QpField}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Body postupnosti (teplota · dĺžka výdrže)" Style="{StaticResource Label}" DockPanel.Dock="Left" />
                                    <Button DockPanel.Dock="Right" Content="＋ Bod" Style="{StaticResource GhostButton}"
                                            Padding="8,1" Command="{Binding AddSequenceStepCommand}"
                                            ToolTip="Pridá bod s rovnakou teplotou ako posledný a aktuálnou dĺžkou plata." />
                                </DockPanel>

                                <!-- One row per point. The reorder buttons sit on the left, grouped with the
                                     point number and clearly apart from the ▲/▼ of the value steppers on the
                                     right – side by side the two pairs were indistinguishable. They also grey
                                     out at the ends of the list instead of silently doing nothing. -->
                                <ItemsControl ItemsSource="{Binding SequenceSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Button Content="↑" Style="{StaticResource GhostButton}" Width="26" Margin="0" Padding="0,1" FontSize="13"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                Command="{Binding DataContext.MoveSequenceStepUpCommand, RelativeSource={RelativeSource AncestorType={x:Type views:QuickProfileView}}}"
                                                                CommandParameter="{Binding}" ToolTip="Posunúť tento bod o jedno miesto vyššie" />
                                                        <TextBlock Text="{Binding Number, StringFormat={}{0}.}" TextAlignment="Center"
                                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,3" />
                                                        <Button Content="↓" Style="{StaticResource GhostButton}" Width="26" Margin="0" Padding="0,1" FontSize="13"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                Command="{Binding DataContext.MoveSequenceStepDownCommand, RelativeSource={RelativeSource AncestorType={x:Type views:QuickProfileView}}}"
                                                                CommandParameter="{Binding}" ToolTip="Posunúť tento bod o jedno miesto nižšie" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="°C" Style="{StaticResource Caption}" />
                                                        <views:NumericStepper Value="{Binding Temperature, Mode=TwoWay}" Step="1" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="plato (min)" Style="{StaticResource Caption}" />
                                                        <views:NumericStepper Value="{Binding PlateauMinutes, Mode=TwoWay}" Step="5" Minimum="0" />
                                                        <TextBlock Text="{Binding PlateauMinutes, Converter={StaticResource MinutesToHours}}"
                                                                   Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0"
                                                                   ToolTip="Prepočet na hodiny – iba vizuálna pomôcka." />
                                                    </StackPanel>

                                                    <Button Grid.Column="6" Content="✕" Style="{StaticResource GhostButton}"
                                                            Margin="0" Padding="9,7" FontSize="12" VerticalAlignment="Center"
                                                            Foreground="{StaticResource MutedBrush}"
                                                            Command="{Binding DataContext.RemoveSequenceStepCommand, RelativeSource={RelativeSource AncestorType={x:Type views:QuickProfileView}}}"
                                                            CommandParameter="{Binding}" ToolTip="Odobrať bod" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding SequenceParseError}" Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasSequenceParseError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsParametricMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Parametre sweepu" Style="{StaticResource Heading}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource QpField}">
                                <TextBlock Text="Od (°C)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding LowTemperature, Mode=TwoWay}" Step="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource QpField}">
                                <TextBlock Text="Do (°C)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding HighTemperature, Mode=TwoWay}" Step="5" />
                            </StackPanel>
                        </Grid>

                        <!-- Two ways to choose the intermediate temperatures: a fixed count of
                             steps, or a requested °C step between the endpoints (then generate). -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Počet krokov" IsChecked="{Binding UseStepCount, Mode=OneWay}"
                                         Click="UseStepCount_Click" VerticalAlignment="Center"
                                         ToolTip="Zadáš, koľko teplôt má byť medzi krajnými bodmi." />
                            <RadioButton Content="Krok teploty (°C)" IsChecked="{Binding UseTemperatureStep, Mode=TwoWay}"
                                         Margin="16,0,0,0" VerticalAlignment="Center"
                                         ToolTip="Zadáš požadovaný rozdiel medzi susednými teplotami – počet krokov sa dopočíta." />
                        </StackPanel>

                        <StackPanel Style="{StaticResource QpField}"
                                    Visibility="{Binding UseStepCount, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Počet teplôt medzi krajnými (medzikroky)" Style="{StaticResource Label}" />
                            <views:NumericStepper Value="{Binding IntermediateSteps, Mode=TwoWay}" Step="1" Minimum="0" Maximum="50" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource QpField}"
                                    Visibility="{Binding UseTemperatureStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Krok teploty medzi min a max (°C)" Style="{StaticResource Label}" />
                            <views:NumericStepper Value="{Binding TemperatureStep, Mode=TwoWay}" Step="1" Minimum="0.1" Maximum="200" />
                            <TextBlock Text="Počet krokov sa dopočíta z rozsahu a vygeneruje sa." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>

                        <CheckBox Content="Aj zostupná časť (späť dole)" IsChecked="{Binding IncludeDescending}"
                                  Margin="0,2,0,6" />
                        <CheckBox Content="Dvojitý vrchol (dva najvyššie body)" IsChecked="{Binding DoublePeak}"
                                  Margin="0,0,0,6"
                                  ToolTip="Na vrchole vytvorí dva najvyššie body a medzi nimi plato o pár °C nižšie, aby prebehla zmena teploty." />
                        <StackPanel Style="{StaticResource QpField}"
                                    Visibility="{Binding DoublePeak, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Pokles medzi vrcholmi (°C)" Style="{StaticResource Label}" />
                            <views:NumericStepper Value="{Binding PeakDipCelsius, Mode=TwoWay}" Step="1" Minimum="0" />
                        </StackPanel>
                        </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QpGroup}">
                        <StackPanel>
                        <TextBlock Text="Časy krokov" Style="{StaticResource Heading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource QpField}">
                                <TextBlock Text="Dĺžka plata (min)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding PlateauMinutes, Mode=TwoWay}" Step="5" Minimum="0"
                                                      ToolTip="V režime „Postupnosť teplôt“ prepíše dĺžku plata pri všetkých bodoch naraz. Jednotlivý bod sa dá potom nastaviť zvlášť." />
                                <TextBlock Text="{Binding PlateauMinutes, Converter={StaticResource MinutesToHours}}"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           ToolTip="Prepočet zadaných minút na hodiny – iba vizuálna pomôcka, ukladá sa hodnota v minútach." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource QpField}"
                                        Visibility="{Binding UsesRamps, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Dĺžka nábehu (min)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding RampMinutes, Mode=TwoWay}" Step="5" Minimum="0" />
                                <TextBlock Text="{Binding RampMinutes, Converter={StaticResource MinutesToHours}}"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           ToolTip="Prepočet zadaných minút na hodiny – iba vizuálna pomôcka, ukladá sa hodnota v minútach." />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Zmena tejto hodnoty nastaví rovnakú dĺžku plata všetkým bodom postupnosti vyššie."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding IsSequenceMode, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QpGroup}">
                        <StackPanel>
                        <TextBlock Text="Nábeh a koniec" Style="{StaticResource Heading}" />
                        <!-- SIKA has no ramps at all – the whole lead-in block is meaningless there. -->
                        <StackPanel Visibility="{Binding UsesRamps, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Nábeh z aktuálnej teploty" IsChecked="{Binding StartFromCurrent}"
                                  Margin="0,0,0,6"
                                  ToolTip="Na začiatku pridá rampu z aktuálnej teploty komory na prvú nastavenú teplotu, aby profil neskočil rovno na prvý setpoint." />
                        <Grid Visibility="{Binding StartFromCurrent, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource QpField}">
                                <TextBlock Text="Z teploty (°C)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding StartTemperature, Mode=TwoWay}" Step="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource QpField}">
                                <TextBlock Text="Dĺžka nábehu (min)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding StartRampMinutes, Mode=TwoWay}" Step="5" Minimum="0" />
                                <TextBlock Text="{Binding StartRampMinutes, Converter={StaticResource MinutesToHours}}"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           ToolTip="Prepočet zadaných minút na hodiny – iba vizuálna pomôcka, ukladá sa hodnota v minútach." />
                            </StackPanel>
                        </Grid>
                        </StackPanel>

                        <CheckBox Content="Ukončiť na bezpečnej teplote (min. 1 hodina)" IsChecked="{Binding EndAtSafeTemperature}"
                                  Margin="0,0,0,6"
                                  ToolTip="Na koniec profilu pridá záverečnú teplotu 25 °C na aspoň 1 hodinu (na Vötschi aj s nábehom), aby zariadenie skončilo blízko izbovej teploty pred vypnutím výkonu." />
                        <Grid Visibility="{Binding EndAtSafeTemperature, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource QpField}">
                                <TextBlock Text="Koncová teplota (°C)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding EndTemperature, Mode=TwoWay}" Step="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource QpField}">
                                <TextBlock Text="Dĺžka plata (min)" Style="{StaticResource Label}" />
                                <views:NumericStepper Value="{Binding EndHoldMinutes, Mode=TwoWay}" Step="15" Minimum="60" />
                                <TextBlock Text="{Binding EndHoldMinutes, Converter={StaticResource MinutesToHours}}"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           ToolTip="Prepočet zadaných minút na hodiny – iba vizuálna pomôcka, ukladá sa hodnota v minútach." />
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QpGroup}">
                        <StackPanel>
                        <TextBlock Text="Cyklovanie" Style="{StaticResource Heading}" Margin="0,4,0,4" />
                        <StackPanel Style="{StaticResource QpField}">
                            <TextBlock Text="Počet cyklov" Style="{StaticResource Label}" />
                            <views:NumericStepper Value="{Binding Cycles, Mode=TwoWay}" Step="1" Minimum="1" />
                            <CheckBox Content="Cyklovať len telo (nábeh a koniec len raz)" IsChecked="{Binding CycleBodyOnly}"
                                      Margin="0,6,0,0"
                                      ToolTip="Opakuje sa iba sweep; začiatočný nábeh na prvú teplotu a koncový nábeh na izbovú teplotu prebehnú len raz." />
                        </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QpGroup}" Visibility="{Binding IsParametricMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                        <StackPanel Visibility="{Binding IsParametricMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Optimalizácia" Style="{StaticResource Heading}" Margin="0,4,0,4" />
                        <StackPanel Style="{StaticResource QpField}">
                            <TextBlock Text="Skrátiť celkový čas o (hodín)" Style="{StaticResource Label}" />
                            <views:NumericStepper Value="{Binding ShortenByHours, Mode=TwoWay}" Step="0.5" Minimum="0" />
                            <TextBlock Text="Rovnomerne skráti všetky plata." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        </StackPanel>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned actions: always visible so the scroll above clearly has more. -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <!-- Primary actions stacked full-width: the icon and full label
                         always fit (a 360-wide column cannot hold both side by side). -->
                    <Button Margin="0,0,0,0" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Stretch" Command="{Binding SaveToLibraryCommand}"
                            ToolTip="Uloží (alebo aktualizuje podľa názvu) profil do zdieľanej knižnice.">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" />
                            <TextBlock Text="Uložiť do knižnice" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="0,10,0,8" Background="{StaticResource BorderBrush}" />

                    <!-- Secondary + destructive stacked full-width so long labels are never clipped. -->
                    <Button Margin="0" HorizontalAlignment="Stretch" Content="↺ Nový / začať odznova"
                            Style="{StaticResource GhostButton}" Command="{Binding NewCommand}"
                            ToolTip="Vynuluje všetky parametre na predvolené hodnoty." />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="Vymazať z knižnice"
                            Style="{StaticResource DangerButton}" Command="{Binding DeleteFromLibraryCommand}"
                            ToolTip="Vymaže z knižnice profil s aktuálnym názvom (s potvrdením)." />

                    <!-- Prominent confirmation after a successful save. -->
                    <Border Margin="0,4,0,0" CornerRadius="8" Padding="10,8"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource OkBrush}" BorderThickness="1"
                            Visibility="{Binding IsSaveSuccess, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource OkBrush}"
                                   FontFamily="Segoe UI Semibold" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding IsSaveSuccess, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource SurfaceAltBrush}" ShowsPreview="False"
                          ToolTip="Potiahni a nastav šírku ľavého panela s parametrami." />

            <!-- ===== Náhľad + výpočty ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Náhľad profilu — ťahaj body myšou (zvisle = teplota, vodorovne = trvanie)"
                                       Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="＋ / － / ⤢ · koliesko = priblíženie · Shift+koliesko = posun · dvojklik = celý profil"
                                       ToolTip="Priblížiť sa dá tlačidlami ＋ / － vpravo hore v grafe alebo kolieskom myši okolo kurzora; ⤢ (aj dvojklik) vráti celý profil.&#10;Keď je graf priblížený: Shift+koliesko alebo ťahanie prázdnej plochy posúva časovú os a prúžok pod grafom (mini-mapa) sa dá chytiť a ťahať." />
                        </DockPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>

                    <views:ProfileEditorChart Grid.Row="1" Segments="{Binding Segments}" MinHeight="240" Margin="0,8,0,8"
                                     CycleStart="{Binding CycleBandStart}" CycleEnd="{Binding CycleBandEnd}"
                                     CycleCount="{Binding Cycles}" />

                    <WrapPanel Grid.Row="2">
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Segmentov" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SegmentCount}" FontSize="20" FontFamily="Segoe UI Semibold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Nábeh" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RampRateText}" FontSize="16" FontFamily="Segoe UI Semibold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Plato po optimalizácii" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding EffectivePlateauText}" FontSize="16" FontFamily="Segoe UI Semibold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Celkový čas (základ)" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding BaseTotalText}" FontSize="16" FontFamily="Segoe UI Semibold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Celkový čas (optimalizovaný)" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding OptimizedTotalText}" FontSize="20" FontFamily="Segoe UI Semibold" />
                        </StackPanel>

                        <!-- SIKA nemá rampy: kúpeľ si na setpoint nabehne sám a výdrž sa
                             začne počítať až potom, takže tento čas ide navrch. -->
                        <StackPanel Margin="0,0,28,0" Visibility="{Binding ShowSettling, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Ustálenie (odhad)" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SettlingText}" FontSize="16" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource AccentBrush}"
                                       ToolTip="Odhadovaný čas, ktorý kúpeľ strávi nábehom na jednotlivé setpointy. Rýchlosti ohrevu/chladenia sa nastavujú v Administrácia → SIKA – odhad času ustálenia." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowSettling, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Reálny čas behu (odhad)" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RunTotalText}" FontSize="20" FontFamily="Segoe UI Semibold"
                                       ToolTip="Súčet výdrží plus odhadovaný čas nábehu na setpointy – takto dlho beh reálne trvá." />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
