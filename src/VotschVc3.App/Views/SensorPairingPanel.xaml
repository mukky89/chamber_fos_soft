<UserControl x:Class="VotschVc3.App.Views.SensorPairingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
    <Style x:Key="PairingIcon" TargetType="Path">
        <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
        <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#DCE8FF"/>
        <Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Geometry x:Key="ScanIcon">M 7,3 L 3,3 3,7 M 17,3 L 21,3 21,7 M 3,17 L 3,21 7,21 M 21,17 L 21,21 17,21 M 7,8 L 7,16 M 10,8 L 10,16 M 14,8 L 14,16 M 17,8 L 17,16</Geometry>
    <Geometry x:Key="PlugIcon">M 8,3 L 8,8 M 16,3 L 16,8 M 6,8 L 18,8 18,11 C 18,15 15,17 12,17 C 9,17 6,15 6,11 Z M 12,17 L 12,21</Geometry>
    <Geometry x:Key="CheckIcon">M 4,12 L 9,17 20,6</Geometry>
    <Geometry x:Key="InfoIcon">M 12,2 A 10,10 0 1 1 11.99,2 M 12,10 L 12,17 M 12,6 L 12,6.2</Geometry>
</UserControl.Resources>
<Border Background="#1E2435" BorderBrush="#485675" BorderThickness="1" CornerRadius="12" Padding="28">
<StackPanel>
<StackPanel Orientation="Horizontal"><Border Width="44" Height="44" Background="#2B3B60" BorderBrush="#425F96" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource PlugIcon}" Stroke="#98BBFF" Width="25" Height="25"/></Border><TextBlock Text="Priradenie FBG snímača" FontSize="25" FontWeight="SemiBold" Foreground="#F2F5FC" VerticalAlignment="Center"/></StackPanel>
<TextBlock Text="Pripájaj snímače postupne, po jednom." Foreground="#A6B8D9" Margin="0,8,0,24"/>
<Grid Margin="0,0,0,24">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Height="1" Background="#687C9F" VerticalAlignment="Top" Margin="60,21,60,0" Grid.ColumnSpan="3"/>
<StackPanel><Border x:Name="Step1" Width="42" Height="42" CornerRadius="21" Background="#608EF3"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource ScanIcon}" Stroke="White"/></Border><TextBlock Text="1 · Zadaj SN" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#B7C8E5"/></StackPanel>
<StackPanel Grid.Column="1"><Border x:Name="Step2" Width="42" Height="42" CornerRadius="21" Background="#1E2435" BorderBrush="#687C9F" BorderThickness="1"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource PlugIcon}"/></Border><TextBlock Text="2 · Pripoj snímač" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#B7C8E5"/></StackPanel>
<StackPanel Grid.Column="2"><Border x:Name="Step3" Width="42" Height="42" CornerRadius="21" Background="#1E2435" BorderBrush="#687C9F" BorderThickness="1"><Path x:Name="Step3Icon" Style="{StaticResource PairingIcon}" Data="{StaticResource CheckIcon}"/></Border><TextBlock Text="3 · Priradené" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#B7C8E5"/></StackPanel>
</Grid>
<StackPanel x:Name="Entry">
<TextBlock Text="Sériové číslo (SN)" FontSize="17" FontWeight="SemiBold" Foreground="#F2F5FC" Margin="0,0,0,8"/>
<Grid><TextBox x:Name="SerialInput" MinHeight="64" FontSize="22" Padding="14,4" VerticalContentAlignment="Center"/><TextBlock Text="Naskenuj alebo zadaj SN" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#A6B8D9" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SerialInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<TextBlock Text="Poznámka" Foreground="#A6B8D9" Margin="0,12,0,6"/><TextBox x:Name="NoteInput" MinHeight="40" MaxHeight="90" AcceptsReturn="True" TextWrapping="Wrap"/>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Button x:Name="Prepare" Content="Vytvoriť zapojenie snímača     Enter ↵" Style="{DynamicResource AccentButton}" Padding="12,12" Margin="0,0,10,0"/><Button x:Name="CloseAction" Grid.Column="1" Content="Dokončiť zapájanie" Padding="12,12"/></Grid>
</StackPanel>
<StackPanel x:Name="Waiting" Visibility="Collapsed" Margin="0,4,0,8">
<TextBlock Text="Teraz pripoj snímač" FontSize="18" HorizontalAlignment="Center" Foreground="#A6B8D9"/>
<TextBlock x:Name="PendingSerial" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" Margin="0,14"/>
<ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,12"/>
<Border Background="#172B40" BorderBrush="#506E94" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12"><TextBlock x:Name="Candidates" TextWrapping="Wrap" Foreground="#F2F5FC" FontSize="20" FontWeight="SemiBold" LineHeight="30" LineStackingStrategy="BlockLineHeight"/></Border><Button x:Name="ConfirmPeaks" Content="Potvrdiť priradenie peakov" IsEnabled="False" Style="{DynamicResource AccentButton}" Margin="0,8"/><Button x:Name="ChangeSerial" Content="Zmeniť SN" HorizontalAlignment="Left" Style="{DynamicResource GhostButton}"/>
</StackPanel>
<DockPanel Margin="0,16,0,16"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource InfoIcon}" Width="16" Height="16" Stroke="#91A6C6" Margin="0,1,8,0" VerticalAlignment="Top"/><TextBlock x:Name="Status" Text="Po potvrdení SN pripoj snímač do voľného kanála." Foreground="#A6B8D9" TextWrapping="Wrap"/></DockPanel>
<Border x:Name="ResultCard" Visibility="Collapsed" Background="#192F34" BorderBrush="#386963" BorderThickness="1" CornerRadius="9" Padding="18">
<StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource CheckIcon}" Width="18" Height="18" Stroke="#5BE0AF" Margin="0,0,10,0"/><TextBlock Text="Posledný snímač bol priradený" Foreground="#5BE0AF" FontSize="16"/></StackPanel>
<TextBlock x:Name="Result" FontSize="24" FontWeight="SemiBold" Foreground="#F2F5FC" Margin="0,10,0,12" TextWrapping="Wrap"/>
<Border x:Name="ApiBadge" BorderBrush="#EAB947" BorderThickness="1" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Path x:Name="ApiIcon" Style="{StaticResource PairingIcon}" Width="16" Height="16" Stroke="#EAB947" Data="M 12,2 A 10,10 0 1 1 11.99,2 M 12,6 L 12,12 16,14" Margin="0,0,7,0"/><TextBlock x:Name="ApiStatus" Text="API zatiaľ neoverené" Foreground="#EAB947" VerticalAlignment="Center"/></StackPanel></Border>
</StackPanel></Border>
<StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource InfoIcon}" Width="16" Height="16" Stroke="#91A6C6" Margin="0,0,8,0"/><TextBlock Text="Párovanie funguje aj bez API." Foreground="#91A6C6" VerticalAlignment="Center"/></StackPanel>
</StackPanel></Border></UserControl>
