<UserControl Language="sk-SK" x:Class="VotschVc3.App.Views.SensorPairingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
    <Style x:Key="PairingIcon" TargetType="Path">
        <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
        <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#DCE8FF"/>
        <Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Geometry x:Key="ScanIcon">M 7,3 L 3,3 3,7 M 17,3 L 21,3 21,7 M 3,17 L 3,21 7,21 M 21,17 L 21,21 17,21 M 7,8 L 7,16 M 10,8 L 10,16 M 14,8 L 14,16 M 17,8 L 17,16</Geometry>
    <Geometry x:Key="PlugIcon">M 8,3 L 8,8 M 16,3 L 16,8 M 6,8 L 18,8 18,11 C 18,15 15,17 12,17 C 9,17 6,15 6,11 Z M 12,17 L 12,21</Geometry>
    <Geometry x:Key="CheckIcon">M 4,12 L 9,17 20,6</Geometry>
    <Geometry x:Key="InfoIcon">M 12,2 A 10,10 0 1 1 11.99,2 M 12,10 L 12,17 M 12,6 L 12,6.2</Geometry>
    <Style x:Key="PairingProgress" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                <Grid x:Name="PART_Track" ClipToBounds="True">
                    <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}" CornerRadius="8" HorizontalAlignment="Left"/>
                    <Border x:Name="Pulse" Width="180" Background="{DynamicResource AccentBrush}" CornerRadius="8" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Pulse" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions><BeginStoryboard x:Name="LoadingAnimation"><Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="900" Duration="0:0:2.4"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="LoadingAnimation"/></Trigger.ExitActions>
            </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</UserControl.Resources>
<Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
<StackPanel>
    <DockPanel>
        <Button x:Name="CloseHeader" DockPanel.Dock="Right" Content="✕" Style="{DynamicResource GhostButton}" ToolTip="Zavrieť párovanie" AutomationProperties.Name="Zavrieť párovanie"/>
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" Background="#2B3B60" BorderBrush="#425F96" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource PlugIcon}" Stroke="#98BBFF" Width="25" Height="25"/></Border>
            <TextBlock Text="Priradenie FBG snímača" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </DockPanel>
    <TextBlock Text="Pripájaj snímače postupne, po jednom." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,20"/>
    <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Height="1" Background="#687C9F" VerticalAlignment="Top" Margin="60,21,60,0" Grid.ColumnSpan="3"/>
        <StackPanel><Border x:Name="Step1" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentBrush}"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource ScanIcon}"/></Border><TextBlock Text="1 · Zadaj SN" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
        <StackPanel Grid.Column="1"><Border x:Name="Step2" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource BackgroundBrush}" BorderBrush="#687C9F" BorderThickness="1"><Path Style="{StaticResource PairingIcon}" Data="{StaticResource PlugIcon}"/></Border><TextBlock x:Name="Step2Label" Text="2 · Pripoj snímač" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
        <StackPanel Grid.Column="2"><Border x:Name="Step3" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource BackgroundBrush}" BorderBrush="#687C9F" BorderThickness="1"><Path x:Name="Step3Icon" Style="{StaticResource PairingIcon}" Data="{StaticResource CheckIcon}"/></Border><TextBlock Text="3 · Priradené" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    </Grid>
    <StackPanel x:Name="Entry">
        <TextBlock Text="Sériové číslo (SN)" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
        <TextBox x:Name="SerialInput" MinHeight="60" FontSize="24" Padding="14,4" VerticalContentAlignment="Center" AutomationProperties.Name="Sériové číslo snímača"/>
        <TextBlock Text="Naskenuj kód alebo zadaj SN, napr. 291875/0002." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
        <Border x:Name="IssueCard" Visibility="Collapsed" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,14,0,0">
            <StackPanel><TextBlock x:Name="IssueTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="IssueDetail" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <WrapPanel Margin="0,10,0,0"><Button x:Name="ShowDuplicate" Content="Zobraziť v tabuľke" Style="{DynamicResource AccentButton}" Visibility="Collapsed" Margin="0,0,10,0"/><Button x:Name="CorrectSerial" Content="Opraviť SN" Style="{DynamicResource GhostButton}"/></WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    <DockPanel x:Name="PendingHeader" Visibility="Collapsed" Margin="0,4,0,10">
        <Button x:Name="ChangeSerial" Content="Zmeniť SN" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" VerticalAlignment="Center"/>
        <StackPanel><TextBlock Text="PRIPÁJANÝ SNÍMAČ" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="PendingSerial" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
    <Border x:Name="MetadataCard" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,10,0,12">
        <StackPanel><TextBlock Text="Údaje podľa SN" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Zákazník" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="CustomerValue" Text="—" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Zákazka" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="OrderValue" Text="—" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Vlnové dĺžky (API)" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="WavelengthValue" Text="—" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
            </Grid>
            <TextBlock x:Name="SensorValue" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
    <Border x:Name="LoadingCard" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
        <StackPanel><TextBlock Text="Načítavam údaje snímača" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Overujem SN a načítavam údaje z API." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14"/>
            <ProgressBar x:Name="LookupProgress" Style="{StaticResource PairingProgress}" IsIndeterminate="False" AutomationProperties.Name="Načítavanie údajov snímača"/>
            <TextBlock Text="✓ Formát SN overený" Foreground="{DynamicResource OkBrush}" Margin="0,14,0,4"/>
            <TextBlock Text="Načítavam zákazníka, zákazku, vlnové dĺžky a typy FBG…" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <Button x:Name="CancelLookup" Content="Pokračovať bez API" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
    <StackPanel x:Name="Waiting" Visibility="Collapsed">
        <TextBlock x:Name="ConnectionPrompt" Text="Teraz pripoj snímač" FontSize="18" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
        <ProgressBar x:Name="ConnectionProgress" Style="{StaticResource PairingProgress}" IsIndeterminate="False" Margin="0,0,0,12" AutomationProperties.Name="Čakanie na peaky snímača"/>
        <TextBlock x:Name="Candidates" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
        <DataGrid x:Name="PeakPreview" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" MinHeight="85" MaxHeight="190" RowHeight="34" Visibility="Collapsed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Peak" Binding="{Binding Label}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Namerané [nm]" Binding="{Binding Measured, StringFormat=F3}" Width="1.2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="API [nm]" Binding="{Binding Expected}" Width="1.2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Odchýlka [nm]" Binding="{Binding Delta}" Width="1.2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Typ FBG" Binding="{Binding Type}" Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Kalibrovať" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Kalibrovať peak"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
    <Border x:Name="WavelengthCard" Visibility="Collapsed" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,12"><StackPanel><TextBlock x:Name="WavelengthTitle" FontWeight="SemiBold"/><TextBlock x:Name="WavelengthDetail" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"/><TextBlock Text="Orientačná kontrola zapojenia · tolerancia ±0,5 nm" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
    <Border x:Name="ResultCard" Visibility="Collapsed" Background="#192F34" BorderBrush="#386963" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,8,0,12">
        <WrapPanel><Path Style="{StaticResource PairingIcon}" Data="{StaticResource CheckIcon}" Width="18" Height="18" Stroke="{DynamicResource OkBrush}" Margin="0,0,10,0"/><TextBlock Text="Naposledy priradené" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock x:Name="Result" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            <Border x:Name="ApiBadge" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><Path x:Name="ApiIcon" Style="{StaticResource PairingIcon}" Width="14" Height="14" Margin="0,0,7,0"/><TextBlock x:Name="ApiStatus"/></StackPanel></Border>
        </WrapPanel>
    </Border>
    <TextBlock x:Name="Status" Text="Po potvrdení SN pripoj snímač do voľného kanála." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <StackPanel x:Name="EntryActions">
        <TextBlock Text="Poznámka" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="NoteInput" MinHeight="38" MaxHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Button x:Name="Prepare" Content="Overiť SN a pripojiť snímač  ↵" Style="{DynamicResource AccentButton}" Padding="12,12" Margin="0,0,10,0" AutomationProperties.AcceleratorKey="Enter"/><Button x:Name="CloseAction" Grid.Column="1" Content="Dokončiť zapájanie" Padding="12,12"/></Grid>
    </StackPanel>
    <Button x:Name="ConfirmPeaks" Content="Potvrdiť priradenie peakov" Visibility="Collapsed" IsEnabled="False" Style="{DynamicResource AccentButton}" MinHeight="48"/>
    <TextBlock Text="Peaky typu T sa po overení označia na kalibráciu. Výber môžeš upraviť ručne." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel>
</Border>
</UserControl>
