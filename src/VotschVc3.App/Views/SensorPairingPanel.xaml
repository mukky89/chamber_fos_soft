<UserControl x:Class="VotschVc3.App.Views.SensorPairingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Background="#1E2435" BorderBrush="#485675" BorderThickness="1" CornerRadius="12" Padding="28">
<StackPanel>
<TextBlock Text="⚗  Priradenie FBG snímača" FontSize="25" FontWeight="SemiBold" Foreground="#F2F5FC"/>
<TextBlock Text="Pripájaj snímače postupne, po jednom." Foreground="#A6B8D9" Margin="0,8,0,24"/>
<Grid Margin="0,0,0,24">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Height="1" Background="#687C9F" VerticalAlignment="Top" Margin="60,21,60,0" Grid.ColumnSpan="3"/>
<StackPanel><Border x:Name="Step1" Width="42" Height="42" CornerRadius="21" Background="#608EF3"><TextBlock Text="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border><TextBlock Text="Zadaj SN" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#B7C8E5"/></StackPanel>
<StackPanel Grid.Column="1"><Border x:Name="Step2" Width="42" Height="42" CornerRadius="21" Background="#1E2435" BorderBrush="#687C9F" BorderThickness="1"><TextBlock Text="2" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border><TextBlock Text="Pripoj snímač" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#B7C8E5"/></StackPanel>
<StackPanel Grid.Column="2"><Border x:Name="Step3" Width="42" Height="42" CornerRadius="21" Background="#1E2435" BorderBrush="#687C9F" BorderThickness="1"><TextBlock Text="3" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border><TextBlock Text="Priradené" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#B7C8E5"/></StackPanel>
</Grid>
<StackPanel x:Name="Entry">
<TextBlock Text="Sériové číslo (SN)" FontSize="17" FontWeight="SemiBold" Foreground="#F2F5FC" Margin="0,0,0,8"/>
<Grid><TextBox x:Name="SerialInput" MinHeight="64" FontSize="22" Padding="14,4" VerticalContentAlignment="Center"/><TextBlock Text="Naskenuj alebo zadaj SN" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#A6B8D9" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SerialInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<TextBlock Text="Poznámka" Foreground="#A6B8D9" Margin="0,12,0,6"/><TextBox x:Name="NoteInput" MinHeight="40" MaxHeight="90" AcceptsReturn="True" TextWrapping="Wrap"/>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Button x:Name="Prepare" Content="Pripraviť snímač     Enter ↵" Style="{DynamicResource AccentButton}" Padding="12,12" Margin="0,0,10,0"/><Button x:Name="CloseAction" Grid.Column="1" Content="Dokončiť zapájanie" Padding="12,12"/></Grid>
</StackPanel>
<StackPanel x:Name="Waiting" Visibility="Collapsed" Margin="0,4,0,8">
<TextBlock Text="Teraz pripoj snímač" FontSize="18" HorizontalAlignment="Center" Foreground="#A6B8D9"/>
<TextBlock x:Name="PendingSerial" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" Margin="0,14"/>
<ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,12"/>
<TextBlock x:Name="Candidates" TextWrapping="Wrap" Foreground="#A6B8D9" Margin="0,8"/><Button x:Name="ConfirmPeaks" Content="Potvrdiť priradenie peakov" IsEnabled="False" Style="{DynamicResource AccentButton}" Margin="0,8"/><Button x:Name="ChangeSerial" Content="Zmeniť SN" HorizontalAlignment="Left" Style="{DynamicResource GhostButton}"/>
</StackPanel>
<TextBlock x:Name="Status" Text="ⓘ  Po potvrdení SN pripoj snímač do voľného kanála." Foreground="#A6B8D9" TextWrapping="Wrap" Margin="0,16,0,16"/>
<Border x:Name="ResultCard" Visibility="Collapsed" Background="#192F34" BorderBrush="#386963" BorderThickness="1" CornerRadius="9" Padding="18">
<StackPanel><TextBlock Text="✓  Posledný snímač bol priradený" Foreground="#5BE0AF" FontSize="16"/>
<TextBlock x:Name="Result" FontSize="24" FontWeight="SemiBold" Foreground="#F2F5FC" Margin="0,10,0,12" TextWrapping="Wrap"/>
<Border x:Name="ApiBadge" BorderBrush="#EAB947" BorderThickness="1" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left"><TextBlock x:Name="ApiStatus" Text="API zatiaľ neoverené" Foreground="#EAB947"/></Border>
</StackPanel></Border>
<TextBlock Text="ⓘ  Párovanie funguje aj bez API." Foreground="#91A6C6" Margin="0,16,0,0"/>
</StackPanel></Border></UserControl>
