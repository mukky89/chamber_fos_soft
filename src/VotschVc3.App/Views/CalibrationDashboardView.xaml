<UserControl x:Class="VotschVc3.App.Views.CalibrationDashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:VotschVc3.App.Views"
 Background="#0D1420" Foreground="#EAF1FA" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <views:FbgStabilitySeriesConverter x:Key="FbgStabilitySeriesConverter"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#EAF1FA"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#99ACC3"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#141F2F"/><Setter Property="BorderBrush" Value="#283A50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Node" TargetType="Border" BasedOn="{StaticResource Panel}">
   <Setter Property="Width" Value="153"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="Active"><Setter Property="BorderBrush" Value="#589EFF"/><Setter Property="Background" Value="#193253"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="BorderBrush" Value="#3CB990"/><Setter Property="Background" Value="#15312F"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Waiting"><Setter Property="BorderBrush" Value="#E5AA54"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Warning"><Setter Property="BorderBrush" Value="#E5AA54"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="BorderBrush" Value="#FA6F79"/><Setter Property="Background" Value="#412631"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WorkflowNode" TargetType="Border" BasedOn="{StaticResource Node}">
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#203C60"/>
     <Setter Property="BorderBrush" Value="#8CC2FF"/>
     <Setter Property="BorderThickness" Value="2"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WorkflowHelpBadge" TargetType="Border">
   <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="CornerRadius" Value="10"/>
   <Setter Property="Background" Value="#203650"/><Setter Property="BorderBrush" Value="#609DE8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Help"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#2E6FB5"/>
     <Setter Property="BorderBrush" Value="#D6EAFF"/>
     <Setter Property="BorderThickness" Value="2"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Foreground" Value="#589EFF"/><Setter Property="Background" Value="#26364B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style x:Key="CriterionPill" TargetType="Border">
   <Setter Property="Background" Value="#1B2A3D"/><Setter Property="BorderBrush" Value="#40536A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,4,0,0"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Done"><Setter Property="Background" Value="#15352E"/><Setter Property="BorderBrush" Value="#45C99A"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Waiting">
     <Setter Property="Background" Value="#332B1D"/><Setter Property="BorderBrush" Value="#D8A24E"/>
     <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.72" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CardStateBadge" TargetType="Border">
   <Setter Property="Background" Value="#202D3E"/><Setter Property="BorderBrush" Value="#40536A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,4"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active"><Setter Property="Background" Value="#193253"/><Setter Property="BorderBrush" Value="#589EFF"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Done"><Setter Property="Background" Value="#15352E"/><Setter Property="BorderBrush" Value="#45C99A"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Waiting"><Setter Property="Background" Value="#332B1D"/><Setter Property="BorderBrush" Value="#D8A24E"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error"><Setter Property="Background" Value="#412631"/><Setter Property="BorderBrush" Value="#FA6F79"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="FbgPeakCard" TargetType="Border">
   <Setter Property="Width" Value="700"/><Setter Property="Background" Value="#0B1420"/><Setter Property="BorderBrush" Value="#29415D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="13"/><Setter Property="Margin" Value="0,0,12,12"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#101D2D"/>
     <Setter Property="BorderBrush" Value="#5B9BE8"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="StepTemplate"><Border Style="{StaticResource WorkflowNode}"><Border.ToolTip><ToolTip MaxWidth="560" Placement="Mouse"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" LineHeight="20" Padding="3"/></ToolTip></Border.ToolTip><StackPanel><Grid><TextBlock Text="{Binding Number}" Style="{StaticResource Muted}"/><Border HorizontalAlignment="Right" Style="{StaticResource WorkflowHelpBadge}"><TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D6EAFF" FontWeight="Bold" FontSize="12"/></Border></Grid><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,7" MinHeight="36"/><TextBlock Text="{Binding Badge}" FontSize="10"/></StackPanel></Border></DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20">
   <Border Style="{StaticResource Panel}" Background="#17283E" BorderBrush="#385A82" Padding="24">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="FBG KALIBRÁCIA / LIVE PREHĽAD" Style="{StaticResource Muted}"/>
      <TextBlock Text="{Binding Profile}" ToolTip="{Binding ProfileDescription}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/>
      <WrapPanel>
       <TextBlock Text="{Binding Chamber}" Style="{StaticResource Muted}" Margin="0,0,18,0"/>
       <TextBlock Text="{Binding RunId, StringFormat=ID kalibrácie: {0}}" Foreground="#BBD8FF" FontWeight="SemiBold"/>
      </WrapPanel>
      <TextBlock Text="{Binding Plateau}" FontSize="18" Margin="0,18,0,2"/>
      <TextBlock Text="{Binding Target}" FontSize="36" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Phase}" Foreground="#9CC6FF" FontSize="16" Margin="0,5,0,12"/>
      <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Height="12" Margin="0,8,26,8"/>
      <TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="20,0,0,0">
      <Border CornerRadius="7" Padding="12,8" HorizontalAlignment="Left">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#284C78"/><Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Waiting"><Setter Property="Background" Value="#674C24"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Done"><Setter Property="Background" Value="#205A47"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Background" Value="#782F40"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Pending"><Setter Property="Background" Value="#374255"/></DataTrigger>
       </Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="ODHAD ZOSTÁVAJÚCEHO ČASU" Style="{StaticResource Muted}" Margin="0,22,0,0"/>
      <TextBlock Text="{Binding Eta}" Style="{StaticResource Metric}"/>
      <TextBlock Text="{Binding Finish, StringFormat=Predpokladaný koniec / koniec: {0}}"/>
      <TextBlock Text="{Binding Started, StringFormat=Štart: {0}}" Margin="0,10,0,3"/>
      <TextBlock Text="{Binding Elapsed, StringFormat=Čas od štartu: {0}}"/>
      <TextBlock Text="{Binding EtaBasis}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Style="{StaticResource Panel}" Background="#111D2C"><StackPanel>
    <TextBlock Text="Čo sa deje práve teraz" Style="{StaticResource Title}"/>
    <Grid Margin="2,2,2,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" CornerRadius="11" Background="#142A28" BorderBrush="#3CB990" BorderThickness="1" Padding="14">
      <StackPanel><TextBlock Text="DOKONČENÉ" Foreground="#64D5A8" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding TimelinePreviousNumber}" Foreground="#64D5A8" FontSize="22" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="{Binding TimelinePreviousTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding TimelinePreviousDetail}" Style="{StaticResource Muted}" Margin="0,7,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Border>
     <Grid Grid.Column="1"><Border Height="2" Background="#3CB990" VerticalAlignment="Center"/><Ellipse Width="10" Height="10" Fill="#3CB990" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
     <Border Grid.Column="2" CornerRadius="12" Background="#193253" BorderBrush="#589EFF" BorderThickness="2" Padding="16">
      <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="Waiting"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.82" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel><TextBlock Text="PRÁVE PREBIEHA" Foreground="#8BBAFF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding TimelineCurrentNumber}" Foreground="#8BBAFF" FontSize="25" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="{Binding TimelineCurrentTitle}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding TimelineCurrentDetail}" Foreground="#C8DDFA" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Grid Grid.Column="3"><Border Height="2" Background="#40536A" VerticalAlignment="Center"/><Ellipse Width="10" Height="10" Fill="#40536A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
     <Border Grid.Column="4" CornerRadius="11" Background="#151F2E" BorderBrush="#40536A" BorderThickness="1" Padding="14">
      <StackPanel>
       <TextBlock Text="NASLEDUJE" Foreground="#99ACC3" FontSize="11" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding TimelineNextNumber}" Foreground="#99ACC3" FontSize="22" FontWeight="Bold" Margin="0,8,0,2"/>
       <TextBlock Text="{Binding TimelineNextTitle}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding TimelineNextDetail}" Style="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
       <Border Background="#172A3E" BorderBrush="#405D7A" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,9,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding TimelineNextTiming}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding TimelineNextTiming}" Foreground="#9CC6FF" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </Border>
      </StackPanel>
     </Border>
    </Grid>
    <Border CornerRadius="9" Background="#251F17" BorderBrush="#68542F" BorderThickness="1" Padding="13,10"><StackPanel><TextBlock Text="AKTUÁLNE PODMIENKY" Foreground="#E8BB79" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationDetail}" TextWrapping="Wrap" FontSize="15" Margin="0,5,0,0" Foreground="#FFE1A6"/></StackPanel></Border>
    <WrapPanel Margin="0,14,0,8"><TextBlock Text="{Binding PhaseElapsed, StringFormat=Čas fázy: {0}}" Margin="0,0,24,6"/><TextBlock Text="{Binding PointElapsed, StringFormat=Čas bodu: {0}}" Margin="0,0,24,6"/><TextBlock Text="{Binding Freshness}" Margin="0,0,24,6"/><TextBlock Text="{Binding LastUpdate, StringFormat=Posledné dáta: {0}}"/></WrapPanel>
    <TextBlock Text="{Binding ActivePeak, StringFormat=Aktívny peak: {0}}" Style="{StaticResource Muted}"/>
    <TextBlock Text="{Binding Alert}" Margin="0,12,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64D5A8"/><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding AlertTone}" Value="Waiting"><Setter Property="Foreground" Value="#E8BB79"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Foreground" Value="#FF8892"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Expander Header="Pravidlá stability a merania" Margin="0,10,0,0" Foreground="#99ACC3"><TextBlock Text="{Binding Rules}" Style="{StaticResource Muted}" Margin="0,12,0,0"/></Expander>
   </StackPanel></Border>
   <TextBlock Text="Workflow aktuálneho bodu" Style="{StaticResource Title}"/>
   <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
   <ProgressBar Value="{Binding PointProgress, Mode=OneWay}" ToolTip="Dokončené fázy aktuálneho bodu. Stabilizácia a meranie peakov prebiehajú paralelne." Margin="0,0,0,18"/>
   <TextBlock Text="Poradie brán: WIKA referencia → stabilita každého FBG peaku → meranie peaku · Komora sa iba monitoruje · Peaky postupujú paralelne" Style="{StaticResource Muted}" Margin="0,0,0,9"/>
   <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}" Margin="0,0,10,14"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="01 / KOMORA" Style="{StaticResource Muted}"/><Border Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CardStateBadge}" Tag="{Binding ChamberCardTone}"><TextBlock Text="{Binding ChamberCardState}" FontSize="10" FontWeight="SemiBold"/></Border></Grid><TextBlock Text="{Binding Actual}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding Delta}"/>
      <Grid Margin="0,10,0,2" ToolTip="Zelená = teplota sa približuje k cieľu · červená = vzďaľuje sa · modrá = drží">
       <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="32" Height="32" CornerRadius="16" BorderThickness="1.5" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#183349"/><Setter Property="BorderBrush" Value="#5AA9E6"/><Style.Triggers>
         <DataTrigger Binding="{Binding TrendTone}" Value="Closer"><Setter Property="Background" Value="#173A31"/><Setter Property="BorderBrush" Value="#45D6A4"/></DataTrigger>
         <DataTrigger Binding="{Binding TrendTone}" Value="Farther"><Setter Property="Background" Value="#42242B"/><Setter Property="BorderBrush" Value="#FF6673"/></DataTrigger>
         <DataTrigger Binding="{Binding TrendTone}" Value="Closer"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.58" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
         <DataTrigger Binding="{Binding TrendTone}" Value="Farther"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <Viewbox Margin="8"><Path Stretch="Uniform" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
         <Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#5AA9E6"/><Setter Property="Data" Value="M 2,8 L 14,8 M 10,4 L 14,8 L 10,12"/><Style.Triggers>
          <DataTrigger Binding="{Binding Trend}" Value="↗ Rastie"><Setter Property="Data" Value="M 2,13 L 13,2 M 7,2 L 13,2 L 13,8"/></DataTrigger>
          <DataTrigger Binding="{Binding Trend}" Value="↘ Klesá"><Setter Property="Data" Value="M 2,2 L 13,13 M 7,13 L 13,13 L 13,7"/></DataTrigger>
          <DataTrigger Binding="{Binding TrendTone}" Value="Closer"><Setter Property="Stroke" Value="#63E6B6"/></DataTrigger>
          <DataTrigger Binding="{Binding TrendTone}" Value="Farther"><Setter Property="Stroke" Value="#FF7A85"/></DataTrigger>
         </Style.Triggers></Style></Path.Style>
        </Path></Viewbox>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Trend}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Foreground" Value="#7DBDF0"/><Style.Triggers><DataTrigger Binding="{Binding TrendTone}" Value="Closer"><Setter Property="Foreground" Value="#63E6B6"/></DataTrigger><DataTrigger Binding="{Binding TrendTone}" Value="Farther"><Setter Property="Foreground" Value="#FF7A85"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock FontSize="10" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Teplota drží smer"/><Setter Property="Foreground" Value="#7D94AE"/><Style.Triggers><DataTrigger Binding="{Binding TrendTone}" Value="Closer"><Setter Property="Text" Value="Približuje sa k cieľu"/><Setter Property="Foreground" Value="#4FBF98"/></DataTrigger><DataTrigger Binding="{Binding TrendTone}" Value="Farther"><Setter Property="Text" Value="Vzďaľuje sa od cieľa"/><Setter Property="Foreground" Value="#E06A75"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
      </Grid>
      <TextBlock Text="Iba monitorovanie; neblokuje FBG fázu." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,10,14">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#17263A"/><GradientStop Color="#112A30" Offset="1"/></LinearGradientBrush></Border.Background>
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="02 / WIKA REFERENCIA" Style="{StaticResource Muted}"/><Border Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CardStateBadge}" Tag="{Binding ReferenceCardTone}"><TextBlock Text="{Binding ReferenceCardState}" FontSize="10" FontWeight="SemiBold"/></Border></Grid>
      <TextBlock Text="{Binding Reference}" Style="{StaticResource Metric}"/>
      <TextBlock Text="{Binding ReferenceStatus}" Style="{StaticResource Muted}"/>
      <Border Style="{StaticResource CriterionPill}" Tag="{Binding ReferenceToleranceTone}"><TextBlock Text="{Binding ReferenceToleranceLabel}" FontSize="11.5"/></Border>
      <Border Style="{StaticResource CriterionPill}" Tag="{Binding ReferenceDriftTone}"><TextBlock Text="{Binding ReferenceDriftLabel}" FontSize="11.5"/></Border>
      <Border Style="{StaticResource CriterionPill}" Tag="{Binding ReferenceTimeTone}"><StackPanel><TextBlock Text="{Binding ReferenceTimeLabel}" FontSize="11.5"/><ProgressBar Value="{Binding TemperatureProgress, Mode=OneWay}" Margin="0,5,0,0" Height="5"/></StackPanel></Border>
      <TextBlock Text="Zelené = splnené · oranžové = čaká" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,0,10,14"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="03 / FBG PEAKY" Style="{StaticResource Muted}"/><Border Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CardStateBadge}" Tag="{Binding PeakCardTone}"><TextBlock Text="{Binding PeakCardState}" FontSize="10" FontWeight="SemiBold"/></Border></Grid><TextBlock Text="{Binding PeakSummary}" FontSize="20" Margin="0,12,0,4"/><ProgressBar Value="{Binding StabilityProgress, Mode=OneWay}"/><TextBlock Text="{Binding PeakDetail}" Style="{StaticResource Muted}"/></StackPanel></Border>
    <Border Grid.Column="3" Style="{StaticResource Panel}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="04 / MERANIE VZORIEK" Style="{StaticResource Muted}"/><Border Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CardStateBadge}" Tag="{Binding MeasurementCardTone}"><TextBlock Text="{Binding MeasurementCardState}" FontSize="10" FontWeight="SemiBold"/></Border></Grid><TextBlock Text="{Binding SampleSummary}" Style="{StaticResource Metric}"/><ProgressBar Value="{Binding SampleProgress, Mode=OneWay}"/><TextBlock Text="Spolu za všetky peaky" Style="{StaticResource Muted}"/></StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource Panel}">
    <Expander IsExpanded="True" Foreground="#EEF5FF" HorizontalContentAlignment="Stretch">
     <Expander.Header><StackPanel><TextBlock Text="Stabilita jednotlivých FBG peakov" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Každý peak sa vyhodnocuje samostatne · graf posledných 180 vzoriek" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Expander.Header>
     <ItemsControl ItemsSource="{Binding FbgStabilityCharts}" Margin="0,14,0,0">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource FbgPeakCard}">
        <StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Wavelength}" Foreground="#8BBAFF" FontSize="17" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#172A3E" BorderBrush="{Binding StateBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" FontSize="11"/></Border></Grid>
         <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,5"/>
         <TextBlock Text="{Binding Samples}" Foreground="#BBD8FF"/>
         <WrapPanel Margin="0,7,0,6"><TextBlock Text="{Binding Range}" Style="{StaticResource Muted}" Margin="0,0,18,4"/><TextBlock Text="{Binding StandardDeviation}" Style="{StaticResource Muted}" Margin="0,0,18,4"/><TextBlock Text="{Binding Drift}" Style="{StaticResource Muted}"/></WrapPanel>
         <views:ChartView Series="{Binding ChartPoints, Converter={StaticResource FbgStabilitySeriesConverter}}" Height="205" Unit="nm" MinimumYDecimals="4" ChartTitle="Stabilita FBG peaku" EmptyText="Čaká sa na vzorky peaku..."/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
   </Expander>
  </Border>
   <Border Style="{StaticResource Panel}">
    <Expander IsExpanded="True" Foreground="#EEF5FF" HorizontalContentAlignment="Stretch">
     <Expander.Header><StackPanel><TextBlock Text="Finálne meranie jednotlivých FBG peakov" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Iba nové výsledkové vzorky po potvrdení stability · graf posledných 180 vzoriek" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Expander.Header>
     <ItemsControl ItemsSource="{Binding FbgStabilityCharts}" Margin="0,14,0,0">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource FbgPeakCard}">
        <StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Wavelength}" Foreground="#8BBAFF" FontSize="17" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#172A3E" BorderBrush="{Binding MeasurementStateBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="{Binding MeasurementState}" Foreground="{Binding MeasurementStateBrush}" FontWeight="SemiBold" FontSize="11"/></Border></Grid>
         <ProgressBar Value="{Binding MeasurementProgress, Mode=OneWay}" Margin="0,10,0,5"/>
         <TextBlock Text="{Binding MeasurementSamples}" Foreground="#BBD8FF"/>
         <TextBlock Text="Stabilizačné vzorky sa v tomto grafe nezobrazujú." Style="{StaticResource Muted}" Margin="0,7,0,6"/>
         <views:ChartView Series="{Binding MeasurementChartPoints, Converter={StaticResource FbgStabilitySeriesConverter}}" Height="205" Unit="nm" MinimumYDecimals="4" ChartTitle="Finálne meranie FBG peaku" EmptyText="Čaká sa na potvrdenie stability a prvú finálnu vzorku..."/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Expander>
   </Border>
   <Border Style="{StaticResource Panel}"><StackPanel>
    <TextBlock Text="WIKA referencia / ustáľovanie" Style="{StaticResource Title}"/>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="TYP" Style="{StaticResource Muted}"/><TextBlock x:Name="ReferenceTypeText" Text="WIKA CTH7000" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="PORT / KANÁL" Style="{StaticResource Muted}"/><TextBlock x:Name="ReferencePortText" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="AKTUÁLNA TEPLOTA" Style="{StaticResource Muted}"/><TextBlock x:Name="ReferenceCurrentTemperatureText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <views:ChartView x:Name="ReferenceTraceChart" Height="230" Unit="°C" MinimumYDecimals="3" ChartTitle="Ustáľovanie WIKA referencie · aktuálne plato" EmptyText="Čaká sa na dáta WIKA referencie aktuálneho plata..."/>
   </StackPanel></Border>
   <Border Style="{StaticResource Panel}">
    <Expander Foreground="#EEF5FF" HorizontalContentAlignment="Stretch">
     <Expander.Header>
      <StackPanel>
       <TextBlock Text="{Binding TemperatureStatus}" FontWeight="SemiBold"/>
       <ProgressBar Value="{Binding TemperatureProgress, Mode=OneWay}" ToolTip="Skóre stability WIKA referencie." Margin="0,9,0,0"/>
       <TextBlock Text="{Binding TemperatureScore}" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
       <TextBlock Text="Kliknutím zobrazíte posledné WIKA vzorky a detailný graf." Foreground="#6F91B8" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
     </Expander.Header>
     <Grid Margin="0,16,0,2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Background="#0B1420" BorderBrush="#29415D" BorderThickness="1" CornerRadius="9" Padding="10">
       <StackPanel><TextBlock Text="PRIEBEH POSLEDNÝCH 50 VZORIEK" Foreground="#8BBAFF" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/><views:ChartView x:Name="StabilitySamplesChart" Height="245" Unit="°C" MinimumYDecimals="3" ChartTitle="Vzorky WIKA použité pri stabilizácii" EmptyText="Čaká sa na vzorky WIKA..."/></StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#0B1420" BorderBrush="#29415D" BorderThickness="1" CornerRadius="9" Padding="10">
       <StackPanel><TextBlock Text="POSLEDNÉ VZORKY" Foreground="#8BBAFF" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/>
        <Grid Margin="3,0,3,5"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Čas" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="Teplota" Style="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="Odchýlka" Style="{StaticResource Muted}"/></Grid>
        <ListBox x:Name="StabilitySamplesList" Height="220" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
         <ListBox.ItemTemplate><DataTemplate><Grid Margin="3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#99ACC3"/><TextBlock Grid.Column="1" Text="{Binding Temperature}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Delta}" Foreground="{Binding DeltaBrush}"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </StackPanel>
      </Border>
     </Grid>
    </Expander>
   </Border>

   <TextBlock Text="Kalibračný plán / roadmap" Style="{StaticResource Title}"/>
   <ItemsControl ItemsSource="{Binding Points}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Node}" Width="174"><StackPanel><TextBlock Text="{Binding Number, StringFormat=PLATO {0}}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Title}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding Badge}" FontSize="11"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="Udalosti kalibrácie" Style="{StaticResource Title}"/>
    <TextBlock Text="Najnovšie udalosti hore · posledných 250 udalostí tohto behu" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
    <ListBox ItemsSource="{Binding Activity}" MaxHeight="300" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Level}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8BBAFF"/><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="SUCCESS"><Setter Property="Foreground" Value="#64D5A8"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="#FF8892"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="WARNING"><Setter Property="Foreground" Value="#E8BB79"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <StackPanel Grid.Column="2">
       <WrapPanel Margin="0,0,0,3"><Border Background="#15283D" BorderBrush="#31577D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"><TextBlock Text="{Binding Plateau}" Foreground="#8BBAFF" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding Temperatures}" Foreground="#9FB7D3" FontSize="11" VerticalAlignment="Center"/></WrapPanel>
       <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
