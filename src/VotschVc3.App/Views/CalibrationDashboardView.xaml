<UserControl x:Class="VotschVc3.App.Views.CalibrationDashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0D1420" Foreground="#EAF1FA" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#EAF1FA"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#99ACC3"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#141F2F"/><Setter Property="BorderBrush" Value="#283A50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Node" TargetType="Border" BasedOn="{StaticResource Panel}">
   <Setter Property="Width" Value="153"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="Active"><Setter Property="BorderBrush" Value="#589EFF"/><Setter Property="Background" Value="#193253"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="BorderBrush" Value="#3CB990"/><Setter Property="Background" Value="#15312F"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Waiting"><Setter Property="BorderBrush" Value="#E5AA54"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Warning"><Setter Property="BorderBrush" Value="#E5AA54"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="BorderBrush" Value="#FA6F79"/><Setter Property="Background" Value="#412631"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Foreground" Value="#589EFF"/><Setter Property="Background" Value="#26364B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <DataTemplate x:Key="StepTemplate"><Border Style="{StaticResource Node}" ToolTip="{Binding Detail}"><StackPanel><TextBlock Text="{Binding Number}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,7" MinHeight="36"/><TextBlock Text="{Binding Badge}" FontSize="10"/></StackPanel></Border></DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20">
   <Border Style="{StaticResource Panel}" Background="#17283E" BorderBrush="#385A82" Padding="24">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="FBG KALIBRÁCIA / LIVE PREHĽAD" Style="{StaticResource Muted}"/>
      <TextBlock Text="{Binding Profile}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/>
      <TextBlock Text="{Binding Chamber}" Style="{StaticResource Muted}"/>
      <TextBlock Text="{Binding Plateau}" FontSize="18" Margin="0,18,0,2"/>
      <TextBlock Text="{Binding Target}" FontSize="36" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Phase}" Foreground="#9CC6FF" FontSize="16" Margin="0,5,0,12"/>
      <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Height="12" Margin="0,8,26,8"/>
      <TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="20,0,0,0">
      <Border CornerRadius="7" Padding="12,8" HorizontalAlignment="Left">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#284C78"/><Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Waiting"><Setter Property="Background" Value="#674C24"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Done"><Setter Property="Background" Value="#205A47"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Background" Value="#782F40"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Pending"><Setter Property="Background" Value="#374255"/></DataTrigger>
       </Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="ODHAD ZOSTÁVAJÚCEHO ČASU" Style="{StaticResource Muted}" Margin="0,22,0,0"/>
      <TextBlock Text="{Binding Eta}" Style="{StaticResource Metric}"/>
      <TextBlock Text="{Binding Finish, StringFormat=Predpokladaný koniec / koniec: {0}}"/>
      <TextBlock Text="{Binding Started, StringFormat=Štart: {0}}" Margin="0,10,0,3"/>
      <TextBlock Text="{Binding Elapsed, StringFormat=Čas od štartu: {0}}"/>
      <TextBlock Text="Odhad vychádza z dokončených bodov. Nábeh a stabilita sa môžu líšiť." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Style="{StaticResource Panel}"><StackPanel>
    <TextBlock Text="Čo sa deje práve teraz" Style="{StaticResource Title}"/>
    <TextBlock Text="{Binding Now}" TextWrapping="Wrap" FontSize="20" Foreground="#BBD8FF"/>
    <TextBlock Text="{Binding OperationDetail}" TextWrapping="Wrap" FontSize="17" Margin="0,10,0,0" Foreground="#FFE1A6"/>
    <WrapPanel Margin="0,14,0,8"><TextBlock Text="{Binding PhaseElapsed, StringFormat=Čas fázy: {0}}" Margin="0,0,24,6"/><TextBlock Text="{Binding PointElapsed, StringFormat=Čas bodu: {0}}" Margin="0,0,24,6"/><TextBlock Text="{Binding Freshness}" Margin="0,0,24,6"/><TextBlock Text="{Binding LastUpdate, StringFormat=Posledné dáta: {0}}"/></WrapPanel>
    <TextBlock Text="{Binding ActivePeak, StringFormat=Aktívny peak: {0}}" Style="{StaticResource Muted}"/>
    <TextBlock Text="{Binding Alert}" Margin="0,12,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64D5A8"/><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding AlertTone}" Value="Waiting"><Setter Property="Foreground" Value="#E8BB79"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Foreground" Value="#FF8892"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Expander Header="Pravidlá stability a merania" Margin="0,10,0,0" Foreground="#99ACC3"><TextBlock Text="{Binding Rules}" Style="{StaticResource Muted}" Margin="0,12,0,0"/></Expander>
   </StackPanel></Border>
   <TextBlock Text="Workflow aktuálneho bodu" Style="{StaticResource Title}"/>
   <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
   <ProgressBar Value="{Binding PointProgress, Mode=OneWay}" ToolTip="Dokončené fázy aktuálneho bodu. Stabilizácia a meranie peakov prebiehajú paralelne." Margin="0,0,0,18"/>
   <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}" Margin="0,0,10,14"><StackPanel><TextBlock Text="01 / KOMORA" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Actual}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding Delta}"/><TextBlock Text="{Binding Trend}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,10,14"><StackPanel><TextBlock Text="02 / WIKA REFERENCIA" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Reference}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding ReferenceStatus}" Style="{StaticResource Muted}"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,0,10,14"><StackPanel><TextBlock Text="03 / FBG PEAKY" Style="{StaticResource Muted}"/><TextBlock Text="{Binding PeakSummary}" FontSize="20" Margin="0,12,0,4"/><ProgressBar Value="{Binding StabilityProgress, Mode=OneWay}"/><TextBlock Text="{Binding PeakDetail}" Style="{StaticResource Muted}"/></StackPanel></Border>
    <Border Grid.Column="3" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="04 / MERANIE VZORIEK" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SampleSummary}" Style="{StaticResource Metric}"/><ProgressBar Value="{Binding SampleProgress, Mode=OneWay}"/><TextBlock Text="Spolu za všetky peaky" Style="{StaticResource Muted}"/></StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource Panel}"><StackPanel>
    <TextBlock Text="{Binding TemperatureStatus}" FontWeight="SemiBold"/>
    <ProgressBar Value="{Binding TemperatureProgress, Mode=OneWay}" ToolTip="Skóre stability z runnera. Dosiahnutie 100 % ešte vyžaduje potvrdenie teplotnej brány v ďalšom bloku."/>
    <TextBlock Text="{Binding TemperatureScore}" Style="{StaticResource Muted}"/>
   </StackPanel></Border>

   <TextBlock Text="Kalibračný plán / roadmap" Style="{StaticResource Title}"/>
   <ItemsControl ItemsSource="{Binding Points}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Node}" Width="174"><StackPanel><TextBlock Text="{Binding Number, StringFormat=PLATO {0}}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Title}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding Badge}" FontSize="11"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="Udalosti kalibrácie" Style="{StaticResource Title}"/>
    <TextBlock Text="Najnovšie udalosti hore · posledných 250 udalostí tohto behu" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
    <ListBox ItemsSource="{Binding Activity}" MaxHeight="300" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Level}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8BBAFF"/><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="SUCCESS"><Setter Property="Foreground" Value="#64D5A8"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="#FF8892"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="WARNING"><Setter Property="Foreground" Value="#E8BB79"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="2" Text="{Binding Message}"/>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
