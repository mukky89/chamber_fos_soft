<UserControl x:Class="VotschVc3.App.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Compact square button for the zoom bar floating over the plot. -->
        <Style x:Key="ChartZoomButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="6">
        <Grid>
            <Canvas x:Name="PlotCanvas" ClipToBounds="True" Background="Transparent" />

            <!-- Zoom controls, so priblíženie does not depend on a scroll gesture. Top-right,
                 the same place as in the profile preview – along the bottom they sat on top
                 of the time-axis label. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,2,4,0" Opacity="0.92">
                <Button Content="－" Style="{StaticResource ChartZoomButton}" Click="OnZoomOutClick"
                        ToolTip="Oddialiť (koliesko myši nadol)" />
                <Button Content="＋" Style="{StaticResource ChartZoomButton}" Click="OnZoomInClick"
                        ToolTip="Priblížiť (koliesko myši nahor)" />
                <Button Content="⤢" Style="{StaticResource ChartZoomButton}" Click="OnZoomResetClick"
                        ToolTip="Zobraziť celý rozsah (dvojklik) · ľavým ťahom označíte oblasť" />
                <Button x:Name="ZoomButton" Content="⛶" Style="{StaticResource ChartZoomButton}"
                        Visibility="Collapsed"
                        ToolTip="Zväčšiť graf na celú obrazovku"
                        Click="OnZoomClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
