<UserControl x:Class="VotschVc3.App.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Readable zoom controls: large enough for a touchpad/operator workstation. -->
        <Style x:Key="ChartZoomButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="6">
        <Grid>
            <Canvas x:Name="PlotCanvas" ClipToBounds="True" Background="Transparent" />

            <!-- Zoom controls, so priblíženie does not depend on a scroll gesture. Top-right,
                 the same place as in the profile preview – along the bottom they sat on top
                 of the time-axis label. -->
            <Border x:Name="ZoomControls" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,5,0"
                    Background="#E6121B2A" BorderBrush="#425B78" BorderThickness="1"
                    CornerRadius="7" Padding="4" Opacity="0.97">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ZoomStateText" Text="Celý rozsah" Foreground="#AFC7E2"
                               FontSize="10.5" VerticalAlignment="Center" Margin="5,0,7,0" />
                    <Button Content="−" Style="{StaticResource ChartZoomButton}" Click="OnZoomOutClick"
                            ToolTip="Oddialiť graf (koliesko myši nadol)" />
                    <Button Content="+" Style="{StaticResource ChartZoomButton}" Click="OnZoomInClick"
                            ToolTip="Priblížiť graf (koliesko myši nahor)" />
                    <Button Content="Celý graf" MinWidth="78" Style="{StaticResource ChartZoomButton}"
                            Click="OnZoomResetClick"
                            ToolTip="Zrušiť priblíženie a zobraziť všetky dáta · funguje aj dvojklik" />
                    <Button x:Name="ZoomButton" Content="⛶" Style="{StaticResource ChartZoomButton}"
                            Visibility="Collapsed" ToolTip="Zväčšiť graf na celú obrazovku" Click="OnZoomClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
