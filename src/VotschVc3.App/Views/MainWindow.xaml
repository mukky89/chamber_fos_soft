<Window x:Class="VotschVc3.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VotschVc3.App.ViewModels"
        xmlns:views="clr-namespace:VotschVc3.App.Views"
        Title="{Binding WindowTitle}"
        Height="820" Width="1240" MinHeight="640" MinWidth="1040"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChamberViewModel}"><views:ChamberView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThermometersViewModel}"><views:ThermometersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordingViewerViewModel}"><views:RecordingViewerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileLibraryViewModel}"><views:ProfileLibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuickProfileViewModel}"><views:QuickProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><views:AuditView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppLogViewModel}"><views:AppLogView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangelogViewModel}"><views:ChangelogView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}"><views:AdminView /></DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <!-- The home dashboard lives here permanently and is only hidden/shown on navigation. -->
        <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
        <ContentControl Content="{Binding DetailView}" />

        <!-- FBG calibration is opened per device, from the button on each device card
             (see HomeView / ChamberView) – every device can have its own calibration.
             The workspace itself is a separate window so it can keep its long-running
             live tables open without rebuilding the home dashboard. -->
    </Grid>
</Window>
