<Window x:Class="VotschVc3.App.Views.ChamberRunExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ukončiť FBG kalibráciu"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Margin="18" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="560">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="TitleText" FontSize="18" FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="MessageText" Margin="0,9,0,0" MaxWidth="510"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            <Border Margin="0,18,0,16" Padding="13,10" CornerRadius="8"
                    Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                           Text="Ponechanie výkonu odošle iba ukončenie kalibrácie a odpojí aplikáciu. Regulátor komory zostane na poslednom nastavenom setpointe." />
            </Border>
            <Grid>
                <Button Content="Zrušiť" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        MinWidth="90" Padding="16,8" Click="Cancel_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Ponechať komoru v chode" Style="{StaticResource AccentOutlineButton}"
                            MinWidth="185" Padding="16,8" Margin="0,0,10,0" Click="KeepRunning_Click" />
                    <Button Content="STOP komory" Style="{StaticResource DangerButton}"
                            MinWidth="120" Padding="16,8" Click="StopChamber_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
