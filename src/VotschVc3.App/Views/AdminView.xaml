<UserControl x:Class="VotschVc3.App.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VotschVc3.App.Views">
    <UserControl.Resources>
        <Style x:Key="MiniField" TargetType="StackPanel">
            <Setter Property="Width" Value="150" />
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>
        <Style x:Key="CalibrationHelpButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="#91BEFF" />
            <Setter Property="BorderBrush" Value="#648CC8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="ToolTip" Value="Kliknutím zobrazíte vysvetlenie nastavenia." />
            <EventSetter Event="Click" Handler="CalibrationHelp_Click" />
        </Style>
    </UserControl.Resources>

    <!-- All content binds against the shell, which owns the actual settings and commands. -->
    <Grid DataContext="{Binding Shell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2,6,8">
            <Button Content="← Domov" Command="{Binding GoHomeCommand}" />
            <TextBlock Text="Administrácia" FontSize="17" FontFamily="Segoe UI Semibold"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ukladanie a záloha FBG kalibrácií" Style="{StaticResource Heading}" />
                    <TextBlock Text="Merania sa najprv bezpečne zapisujú na PC. Sieťová kópia sa dopĺňa na pozadí; výpadok siete neblokuje lokálny záznam. Obe úložiská používajú rok / mesiac / beh, napr. 2026 / 09_September."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <TextBlock Text="Lokálny priečinok na PC (povinný)" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Admin.StorageSettings.LocalDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                    <CheckBox Content="Vytvárať aj sieťovú kópiu nových behov" IsChecked="{Binding Admin.StorageSettings.NetworkCopyEnabled}" Margin="0,0,0,8" />
                    <TextBlock Text="Sieťový priečinok" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Admin.StorageSettings.NetworkDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Interval synchronizácie [s]" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <views:NumericStepper Width="150" Value="{Binding Admin.StorageSettings.SynchronizationIntervalSeconds, Mode=TwoWay}" Minimum="1" Maximum="3600" Step="1" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="Uložiť ukladanie" Style="{StaticResource AccentButton}" Command="{Binding Admin.SaveStorageSettingsCommand}" Margin="0,0,8,0" />
                        <Button Content="Overiť zápis" Command="{Binding Admin.CheckStoragePathsCommand}" Margin="0,0,8,0" />
                        <Button Content="Synchronizovať teraz" Command="{Binding Admin.SyncStorageNowCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Admin.StorageSettingsStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Border Background="#332919" BorderBrush="#D99C37" BorderThickness="1" Padding="10" CornerRadius="6" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Admin.StorageSyncStatus}" Foreground="#FFD27D" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
            <!-- ===== FBG calibration defaults ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Predvolené nastavenia FBG kalibrácie" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="Kliknite na ? pri parametri pre vysvetlenie. Zmeny potvrďte tlačidlom Uložiť predvolené nastavenia. Spoločný základ pre všetky budúce nové kalibračné zapojenia. Interval odberu FBG aj interval trace logu sa použijú pri každom novom behu aj pre uložené zapojenie. Ostatné uložené hodnoty a nastavenia rozbehnutých či obnovených behov sa zachovajú." />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Ako rýchlo aplikácia posúva požadovanú teplotu pri zapnutej rampe. Napríklad zmena o 10 °C pri 2 °C/min trvá 5 minút. Skutočné dosiahnutie teploty a ustálenie WIKA môže trvať dlhšie. Komora reguluje podľa vlastného snímača." AutomationProperties.Name="Vysvetlenie: Rýchlosť setpointu [°C/min]" /><TextBlock Text="Rýchlosť setpointu [°C/min]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.SetpointRampCPerMinute, Mode=TwoWay}" Step="0.1" Minimum="0.1" Maximum="50" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Povolená odchýlka referencie od cieľa na obe strany. Pri cieli 20 °C a tolerancii 1 °C musí byť WIKA medzi 19 a 21 °C. Samotné splnenie tolerancie nestačí: musia prejsť aj podmienky stability." AutomationProperties.Name="Vysvetlenie: Teplotná tolerancia [°C]" /><TextBlock Text="Teplotná tolerancia [°C]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.ChamberToleranceC, Mode=TwoWay}" Step="0.1" Minimum="0.01" Maximum="20" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Ako dlho musí referencia spĺňať podmienky teplotnej stability pred vyhodnocovaním FBG. Nestabilita obnoví čakanie na stabilitu. Dlhší čas zvyšuje nároky na ustálenie a predlžuje meranie." AutomationProperties.Name="Vysvetlenie: Stabilný čas [min]" /><TextBlock Text="Stabilný čas [min]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.ChamberStableMinutes, Mode=TwoWay}" Step="1" Minimum="0" Maximum="1440" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Najväčšia prípustná rýchlosť zmeny referenčnej teploty. Hodnotí sa trend v čase vrátane krátkodobého driftu. Nižší limit je prísnejší a môže predĺžiť čakanie. Hodnota 0 vypína toto kritérium." AutomationProperties.Name="Vysvetlenie: Max. drift teploty [°C/min]" /><TextBlock Text="Max. drift teploty [°C/min]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.MaxChamberDriftCPerMinute, Mode=TwoWay}" Step="0.01" Minimum="0" Maximum="10" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Najväčší rozdiel medzi najvyššou a najnižšou teplotou v hodnotenom okne WIKA. Menší limit vyžaduje pokojnejšiu teplotu. Hodnota 0 vypína toto kritérium." AutomationProperties.Name="Vysvetlenie: Max. rozsah WIKA [°C]" /><TextBlock Text="Max. rozsah WIKA [°C]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.MaxChamberRangeC, Mode=TwoWay}" Step="0.01" Minimum="0" Maximum="10" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Maximálna smerodajná odchýlka teploty WIKA: vyjadruje rozptyl vzoriek okolo priemeru. Menšie číslo vyžaduje menšie kolísanie. Hodnota 0 vypína toto kritérium." AutomationProperties.Name="Vysvetlenie: Max. StdDev WIKA [°C]" /><TextBlock Text="Max. StdDev WIKA [°C]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.MaxChamberStdDevC, Mode=TwoWay}" Step="0.01" Minimum="0" Maximum="10" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Základný limit čakania na stabilitu teploty. Pri priradenej WIKA rozhoduje referencia, teplota komory je informatívna. Nie je to pevná dĺžka plata. Automatické predĺženia sú obmedzené; pri vyčerpaní sa bod odloží na jeden opakovaný pokus alebo sa vyžiada zásah podľa režimu dohľadu. Nestabilný bod sa nepovažuje za úspešný." AutomationProperties.Name="Vysvetlenie: Timeout komory [min]" /><TextBlock Text="Timeout komory [min]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.ChamberStabilityTimeoutMinutes, Mode=TwoWay}" Step="5" Minimum="1" Maximum="1440" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Odstup odberov používaných na stabilitu a finálne meranie FBG. Menší interval skráti čas potrebný na rovnaký počet vzoriek; pomalá komunikácia ho môže predĺžiť. Senzory sa vyhodnocujú súbežne. Tento interval sa použije pri každom novom behu aj pre uložené zapojenie." AutomationProperties.Name="Vysvetlenie: Interval odberu FBG [s]" /><TextBlock Text="Interval odberu FBG [s]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.SampleAcquisitionIntervalSeconds, Mode=TwoWay}" Step="1" Minimum="1" Maximum="30" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}" ToolTip="Interval priebežného zápisu wavelength, SN a posledných teplôt do wavelength-trace.csv. Nezávisí od stability. Použije sa pri každom novom behu; predvolene 1 s.">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Odstup priebežného zápisu vlnových dĺžok, SN a posledných dostupných teplôt do wavelength-trace.csv od spustenia až po koniec behu, nezávisle od stabilizácie. Predvolene 1 s. Nezrýchľuje odber pre stabilitu a nezaručuje novú teplotnú vzorku každú sekundu. Platí pri každom novom behu; menší interval vytvára viac dát." AutomationProperties.Name="Vysvetlenie: Interval trace logu [s]" /><TextBlock Text="Interval trace logu [s]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.WavelengthTraceIntervalSeconds, Mode=TwoWay}" Step="1" Minimum="1" Maximum="86400" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Počet vzoriek, na ktorých musí každý peak samostatne splniť limity rozsahu, smerodajnej odchýlky a driftu. Nevyhovujúce plné okno sa začne zbierať znova. Po úspechu nasledujú finálne vzorky." AutomationProperties.Name="Vysvetlenie: Vzorky pre stabilitu" /><TextBlock Text="Vzorky pre stabilitu" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.RequiredStableSamples, Mode=TwoWay}" Step="1" Minimum="2" Maximum="10000" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Počet vzoriek výsledného merania po potvrdení stability peaku. Pri strate stability sa nedokončené meranie opakuje. Viac vzoriek predĺži odber; automatický časový limit zostáva obmedzený." AutomationProperties.Name="Vysvetlenie: Finálne vzorky" /><TextBlock Text="Finálne vzorky" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.RequiredMeasurementSamples, Mode=TwoWay}" Step="1" Minimum="1" Maximum="10000" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Maximálny rozdiel medzi najvyššou a najnižšou vlnovou dĺžkou v okne jedného peaku. 1 pm = 0,001 nm; 5 pm = 0,005 nm. Nižší limit je prísnejší. Hodnota 0 vypína toto kritérium." AutomationProperties.Name="Vysvetlenie: Max. range [pm]" /><TextBlock Text="Max. range [pm]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.MaxWavelengthRangePm, Mode=TwoWay}" Step="0.1" Minimum="0" Maximum="10000" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Maximálna smerodajná odchýlka vlnovej dĺžky jedného peaku. Vyjadruje kolísanie vzoriek okolo priemeru. Nižší limit vyžaduje pokojnejší signál. Hodnota 0 vypína toto kritérium. 1 pm = 0,001 nm." AutomationProperties.Name="Vysvetlenie: Max. StdDev [pm]" /><TextBlock Text="Max. StdDev [pm]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.MaxWavelengthStdDevPm, Mode=TwoWay}" Step="0.1" Minimum="0" Maximum="10000" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Maximálna rýchlosť posunu vlnovej dĺžky jedného peaku za minútu. Aj málo rozptýlené vzorky môžu byť nestabilné, ak sa sústavne posúvajú. Nižší limit je prísnejší. Hodnota 0 vypína toto kritérium." AutomationProperties.Name="Vysvetlenie: Max. drift FBG [pm/min]" /><TextBlock Text="Max. drift FBG [pm/min]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.CalibrationDefaults.MaxWavelengthDriftPmPerMinute, Mode=TwoWay}" Step="0.1" Minimum="0" Maximum="10000" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <DockPanel MinHeight="36"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CalibrationHelpButton}" Tag="Základ pre časový limit FBG fázy. Automatika zohľadní stabilizačné aj finálne vzorky a skutočný interval s 20 % rezervou. Pri pokroku môže pridávať po 10 minútach, najviac do 90 minút automatického čakania. Reset okien tento čas nevynuluje. Po vyčerpaní nasleduje ohraničený finálny odber aj bez stabilnej wavelength. Platné dáta sa vyhodnotia s označením problému; tento odber predĺži čas plata." AutomationProperties.Name="Vysvetlenie: Timeout peaku [min]" /><TextBlock Text="Timeout peaku [min]" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <views:NumericStepper Value="{Binding Admin.SensorStabilityTimeoutMinutes, Mode=TwoWay}" Step="5" Minimum="1" Maximum="1440" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10"><CheckBox Content="Plynulo posúvať setpoint" IsChecked="{Binding Admin.CalibrationDefaults.EnableSetpointRamp, Mode=TwoWay}" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource CalibrationHelpButton}" AutomationProperties.Name="Vysvetlenie: Plynulo posúvať setpoint" Tag="Zapnuté: aplikácia mení požadovanú teplotu postupne podľa rýchlosti setpointu. Vypnuté: odošle cieľ priamo. V oboch prípadoch sa čaká na stabilitu referencie a FBG; vypnutie rampy neznamená okamžité ustálenie." /></StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Uložiť predvolené nastavenia" Style="{StaticResource AccentButton}" Command="{Binding Admin.SaveCalibrationDefaultsCommand}" />
                        <TextBlock Text="{Binding Admin.CalibrationDefaultsStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== FOS Dashboard Bridge ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Prepojenie s FOS Dashboardom" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding BridgeStatusTitle}" FontFamily="Segoe UI Semibold" FontSize="15"
                               Margin="0,8,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BridgeStatusDetail}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,0,0,5" />
                    <TextBlock Text="{Binding BridgeConfigurationStatus}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Desktopová aplikácia a Lab Control Bridge sú dva samostatné procesy. Aby zariadenia bolo vidieť na webe, musí byť Bridge nakonfigurovaný, spustený a jeho heartbeat musí byť online." />
                    <WrapPanel>
                        <Button Content="Obnoviť stav" Command="{Binding RefreshBridgeStatusCommand}" />
                        <Button Content="Spustiť Bridge" Style="{StaticResource AccentButton}" Command="{Binding StartBridgeCommand}" />
                        <Button Content="Otvoriť priečinok konfigurácie" Command="{Binding OpenBridgeFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== Sylex FOS API ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sylex FOS API" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="Centrálne API pre načítanie výrobných údajov pri FBG kalibrácii. Použi hostname namiesto číselnej IP adresy, napr. http://FOS-API-PC:5080." />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="330">
                            <TextBlock Text="API URL alebo hostname" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SylexFosApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Príklad: http://FOS-API-PC:5080. Ak protokol vynecháš, použije sa http://." />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="260">
                            <TextBlock Text="API kľúč" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SylexFosApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Kľúč klienta chamber-fos so scope calibrations.read." />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Nastavenie sa uloží do Dokumenty\Lab Control\sylex-fos-api.json a načíta automaticky pri otvorení kalibrácie. Ak URL nie je uložená, zostáva kompatibilná premenná SYLEX_FOS_API_URL a predvolený hostname syx260421n01:5080." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Uložiť API" Style="{StaticResource AccentButton}" Command="{Binding SaveSylexFosApiSettingsCommand}" />
                        <Button Content="Otestovať spojenie" Command="{Binding TestSylexFosApiCommand}" />
                        <TextBlock Text="{Binding SylexFosApiStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Add chamber ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Pridať komoru:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Width="200" Margin="0,0,10,0">
                        <TextBlock Text="Názov" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding NewChamberName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,10,0">
                        <TextBlock Text="Protokol" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding ChamberProtocols}" SelectedItem="{Binding NewChamberProtocol}"
                                  ToolTip="Vötsch ASCII-2 (TCP) · POL-EKO LabDesk RPC (AES/Eneter, port 56506, len teplota) · SIKA RestApi (TP Premium REST-API)." />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,10,0">
                        <TextBlock Text="Typ" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding ChamberKinds}" SelectedItem="{Binding NewChamberKind}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,0">
                        <TextBlock Text="IP adresa" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding NewChamberHost, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="Pridať" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom"
                            Command="{Binding AddChamberCommand}" />
                </StackPanel>
            </Border>

            <!-- ===== Vzhľad a ovládanie: Klasický / Profesionálny / Kompaktný ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Vzhľad a ovládanie zariadení" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Vyber rozloženie nástenky pre všetkých používateľov. Zmena sa uloží a prejaví okamžite pri ďalšom zobrazení domovskej obrazovky." />

                    <TextBlock Text="Režim ovládania" Style="{StaticResource Label}" />
                    <RadioButton GroupName="ControlMode" Margin="0,2,0,7"
                                 IsChecked="{Binding ControlMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Classic}">
                        <StackPanel>
                            <TextBlock Text="Klasické rozhranie" FontFamily="Segoe UI Semibold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Pôvodné, priestranné karty zariadení. Predvolené — nič sa nemení pre existujúcich používateľov." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ControlMode" Margin="0,0,0,7"
                                 IsChecked="{Binding ControlMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Professional}">
                        <StackPanel>
                            <TextBlock Text="Profesionálne rozhranie" FontFamily="Segoe UI Semibold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Kompaktný operačný dashboard: prehľad stavu flotily, alarm center, hustejší grid kariet zariadení s rovnakým ovládaním." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ControlMode" Margin="0,0,0,4"
                                 IsChecked="{Binding ControlMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Compact}">
                        <StackPanel>
                            <TextBlock Text="Kompaktné rozhranie" FontFamily="Segoe UI Semibold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Klasické karty, ale vždy zmenšené (rovnaké ako zapnutý „Kompaktný režim nástenky“ nižšie), aby sa zmestilo viac zariadení." />
                        </StackPanel>
                    </RadioButton>

                    <Separator Margin="0,10,0,10" Background="{StaticResource BorderBrush}" />

                    <TextBlock Text="Profesionálny režim — bezpečnostné potvrdenia" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <CheckBox Content="Potvrdenie pred zastavením zariadenia / profilu (STOP)" IsChecked="{Binding ConfirmStopAction}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,2,0,8"
                               Text="Platí len pre profesionálny dashboard. Klasické tlačidlo Stop sa nemení." />
                    <CheckBox Content="Potvrdenie pred spustením profilu" IsChecked="{Binding ConfirmProfileStart}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,2,0,8"
                               Text="Pred štartom sa zobrazí zariadenie, rozsah, trvanie a počet cyklov na potvrdenie. Platí len pre profesionálny dashboard." />
                    <CheckBox Content="Zobraziť alarm center na profesionálnom dashboarde" IsChecked="{Binding ShowAlarmCenter}" />
                </StackPanel>
            </Border>

            <!-- ===== Dashboard layout ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Rozloženie nástenky" Style="{StaticResource Heading}" />
                    <CheckBox Content="Povoliť presúvanie komôr (šípky ◀ ▶ na kartách)"
                              IsChecked="{Binding AllowChamberReorder}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,2,0,0"
                               Text="Keď je zapnuté, na kartách komôr sa adminovi zobrazia šípky na zmenu poradia. Vypnuté = poradie sa nedá omylom prehodiť." />
                    <CheckBox Content="Kompaktný režim nástenky (menšie karty a text)" Margin="0,12,0,0"
                              IsChecked="{Binding CompactMode}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,2,0,0"
                               Text="Zmenší karty, grafiku a text, aby sa na obrazovku zmestilo viac zariadení. Vypnuté = pôvodné, priestrannejšie zobrazenie." />
                    <CheckBox Content="Zobraziť sušiareň POL-EKO" Margin="0,12,0,0"
                              IsChecked="{Binding ShowPolEko}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,2,0,0"
                               Text="Sušiareň POL-EKO je po aktivácii LabDesk TCP predvolene zobrazená a automaticky sa pripája. Vypnutím ju môžeš dočasne skryť aj odpojiť." />
                    <TextBlock Text="ID programu POL-EKO pre manuálne ovládanie" Style="{StaticResource Label}" Margin="0,14,0,0" />
                    <views:NumericStepper Width="130" HorizontalAlignment="Left"
                                          Value="{Binding PolEkoManualProgramId, Mode=TwoWay}"
                                          Step="1" Minimum="1" Maximum="2147483647"
                                          ToolTip="ID existujúceho programu FOS LAB, ktorý aplikácia upraví a spustí pri manuálnom nastavení teploty." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Predvolene 11. Zmena sa uloží a začne platiť pre ďalší príkaz Nastaviť; zadané ID musí patriť existujúcemu programu FOS LAB v LabDesk." />
                </StackPanel>
            </Border>

            <!-- ===== Záznam teplôt profilu ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Záznam teplôt profilu" Style="{StaticResource Heading}" />
                    <TextBlock Text="Interval zápisu do súboru (sekundy)" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <views:NumericStepper Width="130" HorizontalAlignment="Left"
                                          Value="{Binding ProfileLogIntervalSeconds, Mode=TwoWay}"
                                          Step="5" Minimum="1" Maximum="3600"
                                          ToolTip="Ako často sa počas behu profilu zapisuje riadok do CSV záznamu teplôt." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Ako často sa počas behu profilu zapisuje riadok do CSV záznamu teplôt (Dokumenty\Lab Control\Profilelog). Predvolene 30 s. Platí pre všetky komory a zmena sa prejaví hneď." />
                </StackPanel>
            </Border>

            <!-- ===== SIKA – garantovaná výdrž (soak) ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SIKA – garantovaná výdrž" Style="{StaticResource Heading}" />
                    <TextBlock Text="Tolerancia dosiahnutia teploty (°C)" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <views:NumericStepper Width="130" HorizontalAlignment="Left"
                                          Value="{Binding SikaSoakToleranceC, Mode=TwoWay}"
                                          Step="0.1" Minimum="0.1" Maximum="10"
                                          ToolTip="Ako presne (± °C) musí kúpeľ dosiahnuť cieľovú teplotu, kým sa začne počítať čas výdrže." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Na zariadeniach SIKA sa pri každej výdrži najprv počká, kým kúpeľ dosiahne cieľovú teplotu s touto toleranciou (± °C), a až potom sa začne odpočítavať nastavený čas výdrže. Menšie číslo = presnejšie. Predvolene 0,3 °C." />
                </StackPanel>
            </Border>

            <!-- ===== SIKA – odhad času ustálenia ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SIKA – odhad času ustálenia" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="SIKA profil nemá rampy – kúpeľ si na každý setpoint nabehne sám a čas výdrže sa začne počítať až keď na teplote je. Súčet výdrží preto nie je skutočný čas behu. Z týchto rýchlostí sa dopočíta čas nábehu na každý setpoint a pripočíta sa k plánovanému trvaniu profilu (v rýchlom profile, v zozname profilov, na karte aj na časovej osi)." />
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,10">
                            <TextBlock Text="Ohrev (°C/min)" Style="{StaticResource Label}" />
                            <views:NumericStepper Width="130" HorizontalAlignment="Left"
                                                  Value="{Binding SikaHeatingCPerMin, Mode=TwoWay}"
                                                  Step="0.5" Minimum="0.1" Maximum="60"
                                                  ToolTip="Priemerná rýchlosť ohrevu kúpeľa smerom nahor." />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,10">
                            <TextBlock Text="Chladenie nad 0 °C (°C/min)" Style="{StaticResource Label}" />
                            <views:NumericStepper Width="130" HorizontalAlignment="Left"
                                                  Value="{Binding SikaCoolingCPerMin, Mode=TwoWay}"
                                                  Step="0.5" Minimum="0.1" Maximum="60"
                                                  ToolTip="Priemerná rýchlosť chladenia v kladných teplotách." />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,10">
                            <TextBlock Text="Chladenie pod 0 °C (°C/min)" Style="{StaticResource Label}" />
                            <views:NumericStepper Width="130" HorizontalAlignment="Left"
                                                  Value="{Binding SikaCoolingBelowZeroCPerMin, Mode=TwoWay}"
                                                  Step="0.5" Minimum="0.1" Maximum="60"
                                                  ToolTip="Chladenie pod nulou je výrazne pomalšie – kompresor pracuje proti rastúcemu rozdielu voči okoliu." />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Dorovnanie na teplotu (min)" Style="{StaticResource Label}" />
                            <views:NumericStepper Width="130" HorizontalAlignment="Left"
                                                  Value="{Binding SikaStabilizeMinutes, Mode=TwoWay}"
                                                  Step="1" Minimum="0" Maximum="120"
                                                  ToolTip="Pevná rezerva na posledné desatiny stupňa, ktoré už žiadna rýchlosť dobre nepopíše. Pripočíta sa ku každej zmene setpointu." />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Predvolené hodnoty (8 / 5 / 2,5 °C/min, 5 min) sú štartovací odhad, nie údaj z merania tvojich kúpeľov – závisia od náplne bloku, vložky a teploty v miestnosti. Skutočný čas ustálenia každého kroku sa počas behu profilu zapisuje do aplikačného logu („ustálenie na … °C trvalo …“), takže sa dajú podľa neho opraviť." />
                </StackPanel>
            </Border>

            <!-- ===== Users ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Používatelia" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Vytvor používateľov a priraď im rolu. Rolu existujúceho zmeníš v zozname a uložíš tlačidlom „Uložiť zmeny“." />
                    <WrapPanel>
                        <StackPanel Width="200" Margin="0,0,10,8">
                            <TextBlock Text="Prihlasovacie meno" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,10,8">
                            <TextBlock Text="Rola" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding UserRoles}" SelectedItem="{Binding NewUserRole}" />
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,10,8">
                            <TextBlock Text="Heslo" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Počiatočné heslo používateľa." />
                        </StackPanel>
                        <Button Content="Pridať" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                Command="{Binding AddUserCommand}" />
                    </WrapPanel>

                    <ItemsControl ItemsSource="{Binding Users}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Segoe UI Semibold" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.UserRoles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Role, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Odstrániť" Style="{StaticResource DangerButton}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Uložiť zmeny" Style="{StaticResource AccentButton}" Command="{Binding SaveUsersCommand}" />
                        <TextBlock Text="{Binding UserStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Notification centre ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Notifikácie" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                        <CheckBox Content="E-maily globálne zapnuté" IsChecked="{Binding Email.Enabled}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="Na jednom mieste nastavíš, ktoré udalosti sa posielajú e-mailom a ktoré plávajúce hlásenia sa ukážu operátorovi. Vypnutie jedného typu neovplyvní ostatné." />

                    <TextBlock Text="Udalosti a e-mailové pravidlá" FontFamily="Segoe UI Semibold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Typ" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="Kedy sa odošle" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="2" Text="E-mail" Style="{StaticResource Label}"/><TextBlock Grid.Column="3" Text="Overenie" Style="{StaticResource Label}"/>
                    </Grid>
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="10" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="Alarm zariadenia" FontFamily="Segoe UI Semibold"/><TextBlock Grid.Column="1" Text="Strata spojenia, bezpečnostný zásah alebo alarm komory." Style="{StaticResource Caption}" TextWrapping="Wrap"/><CheckBox Grid.Column="2" Content="Posielať" IsChecked="{Binding Email.DeviceAlarmEmailsEnabled}"/><Button Grid.Column="3" Content="Poslať test" Command="{Binding TestNotificationEmailCommand}" CommandParameter="DeviceAlarm"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="10" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="Dokončenie profilu" FontFamily="Segoe UI Semibold"/><TextBlock Grid.Column="1" Text="Po ukončení profilu; obsahuje graf teploty a dostupné CSV." Style="{StaticResource Caption}" TextWrapping="Wrap"/><CheckBox Grid.Column="2" Content="Posielať" IsChecked="{Binding Email.ProfileCompletionEmailsEnabled}"/><Button Grid.Column="3" Content="Poslať test" Command="{Binding TestNotificationEmailCommand}" CommandParameter="ProfileCompleted"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="10" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="Varovanie FBG kalibrácie" FontFamily="Segoe UI Semibold"/><TextBlock Grid.Column="1" Text="Timeout, nestabilný peak alebo potreba zásahu operátora." Style="{StaticResource Caption}" TextWrapping="Wrap"/><CheckBox Grid.Column="2" Content="Posielať" IsChecked="{Binding Email.CalibrationWarningEmailsEnabled}"/><Button Grid.Column="3" Content="Poslať test" Command="{Binding TestNotificationEmailCommand}" CommandParameter="CalibrationWarning"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="10" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="Výsledok FBG kalibrácie" FontFamily="Segoe UI Semibold"/><TextBlock Grid.Column="1" Text="Po COMPLETED, COMPLETED WITH WARNINGS alebo FAILED; ostrá správa obsahuje výsledky a súbory." Style="{StaticResource Caption}" TextWrapping="Wrap"/><CheckBox Grid.Column="2" Content="Posielať" IsChecked="{Binding Email.CalibrationCompletionEmailsEnabled}"/><Button Grid.Column="3" Content="Poslať test" Command="{Binding TestNotificationEmailCommand}" CommandParameter="CalibrationCompleted"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="10" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="Rozdiel WIKA–komora" FontFamily="Segoe UI Semibold"/><TextBlock Grid.Column="1" Text="Po prekročení povoleného rozdielu; opakovanie obmedzuje cooldown." Style="{StaticResource Caption}" TextWrapping="Wrap"/><CheckBox Grid.Column="2" Content="Posielať" IsChecked="{Binding Email.ReferenceTemperatureMismatchEmailsEnabled}"/><Button Grid.Column="3" Content="Poslať test" Command="{Binding TestNotificationEmailCommand}" CommandParameter="ReferenceTemperatureMismatch"/></Grid></Border>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="Plávajúce hlásenia v aplikácii" FontFamily="Segoe UI Semibold" />
                            <TextBlock Text="Čas je odpočet do automatického zatvorenia. Kritické hlásenie môže operátor stále zavrieť krížikom alebo skopírovať." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,8" />
                            <WrapPanel>
                                <StackPanel Style="{StaticResource MiniField}" Width="150"><CheckBox Content="Modré · info" IsChecked="{Binding Email.InfoPopupsEnabled}"/><views:NumericStepper Value="{Binding Email.InfoPopupSeconds, Mode=TwoWay}" Step="1" Minimum="2" Maximum="120"/><TextBlock Text="sekúnd" Style="{StaticResource Caption}"/></StackPanel>
                                <StackPanel Style="{StaticResource MiniField}" Width="150"><CheckBox Content="Zelené · úspech" IsChecked="{Binding Email.SuccessPopupsEnabled}"/><views:NumericStepper Value="{Binding Email.SuccessPopupSeconds, Mode=TwoWay}" Step="1" Minimum="2" Maximum="120"/><TextBlock Text="sekúnd" Style="{StaticResource Caption}"/></StackPanel>
                                <StackPanel Style="{StaticResource MiniField}" Width="150"><CheckBox Content="Oranžové · warning" IsChecked="{Binding Email.WarningPopupsEnabled}"/><views:NumericStepper Value="{Binding Email.WarningPopupSeconds, Mode=TwoWay}" Step="1" Minimum="2" Maximum="120"/><TextBlock Text="sekúnd" Style="{StaticResource Caption}"/></StackPanel>
                                <StackPanel Style="{StaticResource MiniField}" Width="150"><CheckBox Content="Červené · critical" IsChecked="{Binding Email.ErrorPopupsEnabled}"/><views:NumericStepper Value="{Binding Email.ErrorPopupSeconds, Mode=TwoWay}" Step="1" Minimum="2" Maximum="120"/><TextBlock Text="sekúnd" Style="{StaticResource Caption}"/></StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="E-mailové pripojenie" FontFamily="Segoe UI Semibold" Margin="0,0,0,6" />

                    <WrapPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="220">
                            <TextBlock Text="Adresáti (komu)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.Recipient, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Viac adries oddeľ bodkočiarkou alebo čiarkou." />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <TextBlock Text="Spôsob" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding EmailMethods}" SelectedItem="{Binding Email.Method}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="220">
                            <TextBlock Text="Odosielateľ (from)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.From, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="SMTP · predvolené podľa sylex_fos_dashboard (Brevo relay)" Style="{StaticResource Caption}" Margin="0,6,0,4" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="200">
                            <TextBlock Text="Host" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="80">
                            <TextBlock Text="Port" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="70">
                            <TextBlock Text="SSL" Style="{StaticResource Label}" />
                            <CheckBox IsChecked="{Binding Email.SmtpUseSsl}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <TextBlock Text="Používateľ" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.SmtpUser, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}">
                            <TextBlock Text="Heslo" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.SmtpPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Brevo HTTP API (odporúčané podľa FOS Dashboard; HTTPS/443)" Style="{StaticResource Caption}" Margin="0,6,0,4" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="320">
                            <TextBlock Text="Endpoint URL" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.HttpEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource MiniField}" Width="220">
                            <TextBlock Text="Brevo API kľúč" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email.HttpApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Vygeneruje sa v Brevo → SMTP &amp; API → API Keys. Do repozitára sa neukladá." />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding EmailApiKeyHint}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />

                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Kontrola WIKA CTH7000 vs. komora" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                                <CheckBox Content="Kontrola zapnutá"
                                          IsChecked="{Binding Email.ReferenceTemperatureMismatchAlertsEnabled}"
                                          DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock Text="Pri prekročení povoleného rozdielu sa v kalibrácii zobrazí chyba a odošle e-mail na adresáty uvedené vyššie."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,6" />
                            <WrapPanel>
                                <StackPanel Style="{StaticResource MiniField}" Width="190">
                                    <TextBlock Text="Max. rozdiel [°C]" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding Email.ReferenceTemperatureMismatchLimitC, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Predvolená hodnota je ±10 °C." />
                                </StackPanel>
                                <StackPanel Style="{StaticResource MiniField}" Width="220">
                                    <TextBlock Text="Opakovať e-mail najskôr [min]" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding Email.ReferenceTemperatureMismatchEmailCooldownMinutes, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Chráni pred opakovaným posielaním rovnakého upozornenia." />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#122237" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel><TextBlock Text="Náhľad šablóny" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="15"/><ComboBox DockPanel.Dock="Right" Width="250" ItemsSource="{Binding NotificationTemplates}" SelectedItem="{Binding SelectedNotificationTemplate}" DisplayMemberPath="Title"/></DockPanel>
                            <TextBlock Text="SYLEX · LAB CONTROL" Foreground="#A9BED8" FontSize="11" FontFamily="Segoe UI Semibold" Margin="0,18,0,4"/>
                            <TextBlock Text="{Binding SelectedNotificationTemplate.Subject}" Foreground="White" FontSize="20" FontFamily="Segoe UI Semibold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedNotificationTemplate.Trigger}" Foreground="#A9BED8" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <Border Background="#FFFFFF" CornerRadius="7" Padding="14"><TextBlock Text="{Binding SelectedNotificationTemplate.Body}" Foreground="#24364D" TextWrapping="Wrap"/></Border>
                            <TextBlock Text="Test používa rovnakú farebnú HTML šablónu; ostré dokončovacie správy navyše obsahujú grafy, tabuľky a prílohy." Foreground="#A9BED8" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Says up front what is still missing – previously the only way to find
                         out was to press "Poslať test" and read the failure. -->
                    <TextBlock Text="{Binding EmailReadinessText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontFamily="Segoe UI Semibold" Foreground="{StaticResource WarnBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Uložiť nastavenia" Style="{StaticResource AccentButton}" Command="{Binding SaveEmailSettingsCommand}" />
                        <Button Content="Test pripojenia" Command="{Binding TestEmailCommand}" />
                        <TextBlock Text="{Binding EmailStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
