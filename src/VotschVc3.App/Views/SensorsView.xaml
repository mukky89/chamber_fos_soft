<UserControl x:Class="VotschVc3.App.Views.SensorsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer Margin="18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid MinHeight="720" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="2*" MinHeight="60"/><RowDefinition Height="7"/>
   <RowDefinition Height="3*" MinHeight="60"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button DockPanel.Dock="Left" Content="← Späť" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
    Command="{Binding DataContext.GoHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
   <Button DockPanel.Dock="Right" Content="Obnoviť" Command="{Binding RefreshCommand}"/>
   <TextBlock Text="Snímače" FontSize="25" FontFamily="Segoe UI Semibold"/>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
   <StackPanel Margin="0,0,8,4"><TextBlock Text="Názov alebo SN"/><TextBox Width="170" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,8,4"><TextBlock Text="Komora"/><TextBox Width="130" Text="{Binding Chamber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,8,4"><TextBlock Text="Cieľ °C"/><TextBox Width="75" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,8,4"><TextBlock Text="Od"/><DatePicker Width="130" SelectedDate="{Binding From}"/></StackPanel>
   <StackPanel Margin="0,0,8,4"><TextBlock Text="Do"/><DatePicker Width="130" SelectedDate="{Binding Until}"/></StackPanel>
   <StackPanel Margin="0,0,8,4"><TextBlock Text="Kritériá obsahujú"/><TextBox Width="170" Text="{Binding Criteria, UpdateSourceTrigger=PropertyChanged}" ToolTip="Napr. rozsah 5 pm alebo interval 30 s. Presné kritériá sú v detaile."/></StackPanel>
   <Button Content="Filtrovať" Command="{Binding FilterCommand}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
  </WrapPanel>
  <Expander Grid.Row="2" Header="Ako sa počítajú časy a priemery" Margin="0,0,0,8">
   <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto"><TextBlock TextWrapping="Wrap" Margin="8" Text="Komora: od vstupu do stabilizácie plata po splnenie jej podmienky. WIKA: od začiatku referenčnej kontroly (po vstupnej podmienke komory, ak je zapnutá) po otvorenie teplotnej brány. FBG: súčet období stabilizácie od otvorenia teplotnej brány po kvalifikáciu peaku; finálne vzorkovanie sa nezapočítava. Fázy sa nesčítavajú. N/A znamená vypnutú, nedokončenú alebo nedoloženú fázu. Priemery (n = počet hodnôt) zahŕňajú iba úspešné peaky dokončených behov bez manuálneho preskočenia a zmeny kritérií. Spoločné časy komory/WIKA sa rátajú raz na pokus. Staršie časy sa neodhadujú."/></ScrollViewer>
  </Expander>
  <DataGrid Grid.Row="3" ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
   IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Názov snímača" Binding="{Binding Name}" Width="160"/>
    <DataGridTextColumn Header="Kalibrácie" Binding="{Binding Count}" Width="80"/>
    <DataGridTextColumn Header="Posledná" Binding="{Binding Last, StringFormat=dd.MM.yyyy HH:mm}" Width="135"/>
    <DataGridTextColumn Header="Komora posledná" Binding="{Binding LastChamber}" Width="140"/>
    <DataGridTextColumn Header="Komora priemer (n)" Binding="{Binding AverageChamber}" Width="155"/>
    <DataGridTextColumn Header="WIKA posledná" Binding="{Binding LastWika}" Width="140"/>
    <DataGridTextColumn Header="WIKA priemer (n)" Binding="{Binding AverageWika}" Width="155"/>
    <DataGridTextColumn Header="FBG posledný peak" Binding="{Binding LastFbg}" Width="155"/>
    <DataGridTextColumn Header="FBG priemer (n)" Binding="{Binding AverageFbg}" Width="155"/>
   </DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="4" Height="7" HorizontalAlignment="Stretch" Background="Transparent"/>
  <Grid Grid.Row="5">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,6,0,8">
    <Button DockPanel.Dock="Right" Content="Otvoriť pôvodnú kalibráciu" Command="{Binding OpenRunCommand}"/>
    <TextBlock Text="História vybraného snímača · jednotlivé peaky a pokusy" VerticalAlignment="Center" FontSize="16"/>
   </DockPanel>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Details}" SelectedItem="{Binding SelectedDetail}" AutoGenerateColumns="False"
    IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Dátum" Binding="{Binding Started, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
     <DataGridTextColumn Header="SN" Binding="{Binding Data.Peak.Sensor.SerialNumber}" Width="120"/>
     <DataGridTextColumn Header="Kanál" Binding="{Binding Data.Peak.Sensor.Channel}" Width="60"/>
     <DataGridTextColumn Header="Peak" Binding="{Binding Data.Peak.Sensor.PeakId}" Width="55"/>
     <DataGridTextColumn Header="Komora" Binding="{Binding Data.Run.ChamberName}" Width="130"/>
     <DataGridTextColumn Header="Profil" Binding="{Binding Data.Run.ProfileName}" Width="130"/>
     <DataGridTextColumn Header="Cieľ °C" Binding="{Binding Data.Attempt.TargetTemperatureC}" Width="75"/>
     <DataGridTextColumn Header="Smer" Binding="{Binding Data.Direction}" Width="80"/>
     <DataGridTextColumn Header="Komora čas" Binding="{Binding ChamberTime}" Width="140"/>
     <DataGridTextColumn Header="WIKA čas" Binding="{Binding WikaTime}" Width="140"/>
     <DataGridTextColumn Header="FBG čas" Binding="{Binding FbgTime}" Width="140"/>
     <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="260"/>
    </DataGrid.Columns>
   </DataGrid>
   <Expander Grid.Row="2" Header="Kritériá a časové referencie vybraného záznamu" Margin="0,8,0,0">
    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="8"><TextBlock Text="{Binding SelectedDetail.Criteria}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding SelectedDetail.PhaseDetails}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    </ScrollViewer>
   </Expander>
  </Grid>
  <TextBlock Grid.Row="6" Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
 </ScrollViewer>
</UserControl>
