<UserControl x:Class="VotschVc3.App.Views.ProfilePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VotschVc3.App.ViewModels"
             xmlns:core="clr-namespace:VotschVc3.Core.Profiles;assembly=VotschVc3.Core"
             xmlns:views="clr-namespace:VotschVc3.App.Views">
    <Grid>
        <!-- Closed state: a combo-like button showing the current selection (name + caption). -->
        <ToggleButton x:Name="ToggleBtn" Cursor="Hand" HorizontalContentAlignment="Stretch"
                      Checked="OnToggleChecked">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" MinHeight="46">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedCaption, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="{StaticResource MutedBrush}"
                                       Visibility="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <Path Grid.Column="1" VerticalAlignment="Center" Margin="8,0,2,0"
                                  Data="M0,0 L9,0 L4.5,5 Z" Fill="{StaticResource MutedBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- Open state: profile tree on the left, live preview on the right. Hovering or
             keyboard navigation only previews; clicking a leaf / Enter confirms it. -->
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=ToggleBtn}" Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=ToggleBtn}" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False"
               MinWidth="{Binding ActualWidth, ElementName=ToggleBtn}" Closed="OnPopupClosed">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,8,8"
                    MaxHeight="700" MinWidth="980" MaxWidth="1180">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" MinWidth="520" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== Profile list ===== -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox" Padding="28,7,8,7" TextChanged="OnSearchChanged"
                                     Background="{StaticResource SurfaceAltBrush}"
                                     ToolTip="Hľadaj podľa názvu, snímača, zákazníka, projektu alebo tagu." />
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                            <TextBlock Text="Hľadať profil…" VerticalAlignment="Center" Margin="30,0,0,0"
                                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="2,6,2,0"
                                   Text="{Binding ResultSummary, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <TreeView x:Name="Tree"
                                  ItemsSource="{Binding Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Background="Transparent" BorderThickness="0" MaxHeight="610"
                                  SelectedItemChanged="OnTreeSelectedItemChanged"
                                  PreviewMouseLeftButtonUp="OnTreeMouseLeftButtonUp"
                                  KeyDown="OnTreeKeyDown"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:ProfileTreeGroupViewModel}"
                                                          ItemsSource="{Binding Profiles}">
                                    <TextBlock Text="{Binding DisplayHeader}" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type core:TestProfile}">
                                    <StackPanel Margin="0,2" MouseEnter="OnProfileMouseEnter"
                                                ToolTip="Prejdi myšou = náhľad · klik = vybrať profil.">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Device family the profile was authored for, so a SIKA profile is
                                                 never mistaken for a Vötsch one in a mixed list. -->
                                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="5"
                                                    Padding="6,1" Margin="0,1,7,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceKindLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding PickerCaption}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />

                    <!-- ===== Live preview ===== -->
                    <Grid Grid.Column="2" Margin="14,0,0,0">
                        <StackPanel x:Name="PreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="▤" FontSize="34" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Prejdi na profil" FontFamily="Segoe UI Semibold" FontSize="15"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="Vpravo sa zobrazí priebeh, teploty a dĺžky plat."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="PreviewContent" Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="EditButton" DockPanel.Dock="Right" Content="✎ Upraviť v rýchlom profile"
                                        Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                                        Margin="10,0,0,0" VerticalAlignment="Top" Click="OnEditProfileClick"
                                        ToolTip="Otvorí tento profil v rýchlom vytvárači profilov, kde sa dá hneď upraviť a uložiť." />
                                <TextBlock x:Name="PreviewName" FontFamily="Segoe UI Semibold" FontSize="17"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <!-- Which device this profile is meant for: a Vötsch profile ramps between
                                     the plateaus, a SIKA one only holds setpoints. -->
                                <Border x:Name="PreviewKindBadge" Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="6" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PreviewKindText" FontSize="11.5" FontFamily="Segoe UI Semibold" />
                                </Border>
                                <TextBlock x:Name="PreviewCaption" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>

                            <views:ChartView x:Name="PreviewChart" Height="245" Unit=" °C"
                                             EmptyText="Profil nemá segmenty" ShowStages="True"
                                             AllowZoom="False" />

                            <UniformGrid Columns="6" Margin="0,10,0,8">
                                <StackPanel Margin="3">
                                    <TextBlock Text="MIN" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="MinTemperatureText" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="3">
                                    <TextBlock Text="MAX" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="MaxTemperatureText" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="3">
                                    <TextBlock Text="CELKOM" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TotalDurationText" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="3">
                                    <TextBlock Text="CYKLY" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CyclesText" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="3">
                                    <TextBlock Text="PLATÁ" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PlateauCountText" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="3">
                                    <TextBlock Text="TEPLOTY" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TemperatureLevelsText" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" />
                                </StackPanel>
                            </UniformGrid>

                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="Prehľad plat" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                    <!-- A long profile has dozens of plateaus – without its own
                                         scroller the list simply ran past the bottom of the popup. -->
                                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                        <ItemsControl x:Name="PlateauList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding TemperatureText}"
                                                                   FontFamily="Segoe UI Semibold" MinWidth="82" />
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DurationText}" Margin="10,0,0,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RepeatText}"
                                                                   Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI Semibold" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="NoPlateausText" Text="Profil neobsahuje žiadne plato (iba rampy)."
                                               Style="{StaticResource Caption}" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Hover v grafe: teplota, čas a typ kroku · klik na profil potvrdí výber · „✎ Upraviť“ otvorí profil v rýchlom vytvárači"
                                       Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
