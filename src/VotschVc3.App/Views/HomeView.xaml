<UserControl x:Class="VotschVc3.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VotschVc3.App.Views">
    <UserControl.Resources>
        <!-- Grouped sub-panel inside a chamber card. -->
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Lock glyph: closed padlock in red while the controls are blocked, open padlock in
             green while they are free. Drawn as a vector (not the 🔒 emoji, which renders in
             its own colour font and ignores Foreground) and with a heavier stroke, so the
             state is readable across the room. -->
        <Style x:Key="LockGlyphPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StrokeThickness" Value="2.1" />
            <Setter Property="Data" Value="{StaticResource Icon.Unlock}" />
            <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Data" Value="{StaticResource Icon.Lock}" />
                    <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LockGlyphSmall" TargetType="Path" BasedOn="{StaticResource LockGlyphPath}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style x:Key="LockBadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Small pill badge (kind / state). -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="7" />
            <!-- Tight on purpose: four badges have to fit on one line of a 470 px card, and
                 the bottom margin only shows when the row does have to wrap. -->
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,5,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Dashboard metric tile: two wide tiles on temperature-only devices,
             three compact tiles on humidity devices. The widths deliberately fit
             one fixed row so cards below never shift vertically. -->
        <Style x:Key="DashboardMetricTile" TargetType="Border">
            <Setter Property="Width" Value="194" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SupportsHumidity}" Value="True">
                    <Setter Property="Width" Value="128" />
                    <Setter Property="Padding" Value="7,5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Vertical navigation button in the sidebar: full width, left-aligned label,
             transparent at rest, subtle surface fill + accent glyph bar on hover. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root switches between the original Classic layout and the new Professional
         dashboard (Administrácia → Vzhľad a ovládanie → Režim ovládania). Both live
         in the same cell; only one is ever visible, so nothing below this point in
         the Classic branch changed to make room for the new mode. -->
    <Grid>

    <!-- ===== Classic: sidebar (left) + main content (right) ===== -->
    <Grid Visibility="{Binding IsProfessionalMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="6,4,10,4" Padding="14,16">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="/Assets/sylex-logo-red.png" Height="30" HorizontalAlignment="Left"
                           Margin="0,0,0,10" />
                    <TextBlock Text="Riadenie laboratórnych zariadení" FontFamily="Segoe UI Semibold"
                               FontSize="16" TextWrapping="Wrap" TextTrimming="None" />
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="8,3"
                            Margin="0,8,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}"
                                   ToolTip="Verzia aplikácie — pozri CHANGELOG.md" />
                    </Border>
                    <Separator Margin="0,14,0,10" Background="{StaticResource BorderBrush}" />
                </StackPanel>

                <!-- User + logout pinned to the bottom -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,10,0,10" Background="{StaticResource BorderBrush}" />
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="10,7">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                            <Run Text=" · " />
                            <Run Text="{Binding CurrentRoleLabel, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Button Style="{StaticResource NavButton}" Margin="0,6,0,0" Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Logout}" />
                            <TextBlock Text="Odhlásiť" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Margin="0,6,0,0"
                            Foreground="{StaticResource DangerBrush}" Click="Exit_Click"
                            ToolTip="Úplne ukončí aplikáciu (s potvrdením). Krížik okno len skryje do oznamovacej oblasti.">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Power}" />
                            <TextBlock Text="Ukončiť aplikáciu" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel VerticalAlignment="Top">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="FBG KALIBRÁCIA" Style="{StaticResource Caption}" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding FbgCalibration.StateText}" DockPanel.Dock="Right"
                                           FontFamily="Segoe UI Semibold" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FbgCalibration.IsRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding FbgCalibration.DetailText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,4,0,5" />
                            <ProgressBar Height="5" Minimum="0" Maximum="100"
                                         Value="{Binding FbgCalibration.ProgressPercent}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenProfileLibraryCommand}"
                            ToolTip="Prehľad uložených profilov s náhľadom priebehu. Upraviť sa dajú tlačidlom v náhľade (otvorí sa rýchly profil).">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.List}" />
                            <TextBlock Text="Zoznam profilov" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenQuickProfileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Bolt}" />
                            <TextBlock Text="Rýchly profil" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenThermometersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Thermometer}" />
                            <TextBlock Text="Teplomery ASL F100" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenRecordingViewerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Chart}" />
                            <TextBlock Text="Prehliadač záznamov" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenAuditCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.List}" />
                            <TextBlock Text="Audit trail" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenAppLogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Document}" />
                            <TextBlock Text="App log" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenChangelogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Book}" />
                            <TextBlock Text="Changelog" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenAdminCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Gear}" />
                            <TextBlock Text="Administrácia" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>

                    <!-- Priečinky s dátami (otvoria sa v prieskumníkovi Windows) -->
                    <Separator Margin="0,10,0,8" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="PRIEČINKY" Style="{StaticResource Caption}" Margin="12,0,0,4" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenProfilesFolderCommand}"
                            ToolTip="Otvorí priečinok s profilmi (Dokumenty\Lab Control\Profiles).">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="Profily" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenProfileLogFolderCommand}"
                            ToolTip="Otvorí priečinok so záznamami teplôt z bežiacich profilov (Dokumenty\Lab Control\Profilelog).">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="Záznamy teplôt" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenAppLogFolderCommand}"
                            ToolTip="Otvorí priečinok s logmi aplikácie (Dokumenty\Lab Control\App log).">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="Logy aplikácie" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenDataFolderCommand}"
                            ToolTip="Otvorí koreňový priečinok všetkých dát (Dokumenty\Lab Control).">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="Všetky dáta" Style="{StaticResource IconLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main content ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="0,4,0,0">

            <!-- ===== Timeline (Gantt) of every device: running profiles od–do,
                 manual runs fade out to ∞ (run until switched off). ===== -->
            <Border Style="{StaticResource Card}" Margin="7,7,7,0">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Časová os zariadení" Style="{StaticResource Heading}" DockPanel.Dock="Left" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12"
                                VerticalAlignment="Center" Command="{Binding ToggleTimelineCommand}"
                                Content="{Binding TimelineToggleText}"
                                ToolTip="Skryť / zobraziť časovú os (šetrí miesto na obrazovke)." />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="■" Foreground="{StaticResource AccentBrush}" /><Run Text=" profil (od–do)    " />
                            <Run Text="■" Foreground="{StaticResource OkBrush}" /><Run Text=" manuálny beh · ∞ = kým sa nevypne" />
                        </TextBlock>
                    </DockPanel>
                    <views:FleetGanttView Chambers="{Binding VisibleChambers}" Margin="0,10,0,0"
                                          Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibility}}"
                                          ToolTip="Prejdi myšou po pruhu – ukáže profil a časy od–do." />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding VisibleChambers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Compact mode shrinks the whole card (graphic + text + spacing) via a
                             layout-scale, so more devices fit; toggled by the admin, reverts to the
                             original roomy layout when off. -->
                        <Grid Width="470" Margin="7">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.EffectiveCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Hover glow, drawn behind the card (see DeviceCardGlow). -->
                            <Border Style="{StaticResource DeviceCardGlow}" />

                            <Border Style="{StaticResource DeviceCard}" Margin="0">
                            <StackPanel>

                                <!-- ===== Top bar: local card actions + FBG calibration ===== -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.IsReorderAllowed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="◀" Style="{StaticResource GhostButton}" Padding="7,2"
                                                    ToolTip="Posunúť doľava (admin)"
                                                    Command="{Binding DataContext.MoveChamberUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="▶" Style="{StaticResource GhostButton}" Padding="7,2"
                                                    ToolTip="Posunúť doprava (admin)"
                                                    Command="{Binding DataContext.MoveChamberDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <!-- Lock toggle: always enabled so a locked device can be unlocked. -->
                                        <Button Margin="0,0,6,0" Padding="9,8"
                                                Style="{StaticResource GhostButton}" Command="{Binding ToggleLockCommand}"
                                                ToolTip="{Binding LockButtonText, Mode=OneWay}">
                                            <Path Style="{StaticResource LockGlyphPath}" />
                                        </Button>
                                        <Button Style="{StaticResource AccentOutlineButton}" Padding="9,8"
                                                Command="{Binding DataContext.OpenChamberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Upraviť nastavenia a otvoriť plné ovládanie zariadenia.">
                                            <Path Style="{StaticResource IconPath}" Width="16" Height="16"
                                                  Data="{StaticResource Icon.Edit}" />
                                        </Button>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentOutlineButton}"
                                            Padding="10,7" FontSize="12.5"
                                            Click="Calibration_Click"
                                            ToolTip="Otvorí PeakLogger FBG teplotnú kalibráciu s týmto zariadením predvoleným.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPath}" Width="15" Height="15"
                                                  Data="{StaticResource Icon.Signal}" />
                                            <TextBlock Text="FBG Kalibrácia" Style="{StaticResource IconLabel}" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                                <!-- Inline unlock prompt (kept outside the disabled body). It only appears
                                     while the operator is actually unlocking: that the device is locked is
                                     already said by the lock badge and the red padlock in this very row, so a
                                     standing "Zamknuté / Ovládanie je uzamknuté" banner was the third copy of
                                     the same fact and pushed the whole card down. -->
                                <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,10"
                                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                        Visibility="{Binding IsUnlockPromptOpen, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Heslo:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <PasswordBox x:Name="UnlockPass" Width="150" Height="32" VerticalContentAlignment="Center"
                                                         Background="{StaticResource SurfaceAltBrush}" Padding="8,0"
                                                         KeyDown="UnlockPassword_KeyDown" />
                                            <Button Content="Odomknúť" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="12,4"
                                                    Tag="{Binding ElementName=UnlockPass}" Click="Unlock_Click" />
                                            <Button Content="Zrušiť" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,4"
                                                    Command="{Binding CancelUnlockCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ===== ① Header: graphic + name + badges + state ===== -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Top">
                                        <views:ChamberGraphic Width="108" Height="145"
                                                              IsRunning="{Binding IsActive}"
                                                              TitleText="{Binding KindLabel}"
                                                              Visibility="{Binding IsAsciiProtocol, Converter={StaticResource BoolToVisibility}}" />
                                        <views:PolEkoGraphic Width="108" Height="145"
                                                             IsRunning="{Binding IsActive}"
                                                             TemperatureText="{Binding MeasuredTemperature, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0}"
                                                             Visibility="{Binding IsPolEko, Converter={StaticResource BoolToVisibility}}" />
                                        <views:SikaThermalBathGraphic Width="108" Height="137"
                                                             IsRunning="{Binding IsActive}"
                                                             TemperatureText="{Binding MeasuredTemperature, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0}"
                                                             Visibility="{Binding IsSika, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <!-- Read-only name (editing + removal live in device settings), in its
                                             own box like every other block on the card. It keeps to a single line
                                             so all the cards line up: a long name is cut with an ellipsis and the
                                             full text stays in the tooltip. -->
                                        <Border Style="{StaticResource Section}" Margin="0,0,0,10" Padding="11,8">
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="15"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                        </Border>

                                        <!-- ===== Badges =====
                                             Ordered by how much an operator needs them, because the row wraps
                                             on a narrow card and whatever sits last is what drops to a second
                                             line: alarm, run state, lock and control mode stay together on the
                                             first line, the device kind (which the device name already says in
                                             brackets, and the chamber graphic repeats) gives way first. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                            <Border Background="{StaticResource DangerBrush}" CornerRadius="7" Padding="7,3"
                                                    Margin="0,0,5,4" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAlarm, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="⚠ ALARM" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="11.5" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                             Fill="{Binding IsActive, Converter={StaticResource BoolToBrush}}" />
                                                    <TextBlock Text="{Binding StateLabel}" Margin="5,0,0,0" FontFamily="Segoe UI Semibold" FontSize="11.5"
                                                               Foreground="{Binding IsActive, Converter={StaticResource BoolToBrush}}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Lock state, always visible in both states: an operator has to see
                                                 that the controls are free, not only be warned when they are not. -->
                                            <Border Style="{StaticResource Badge}"
                                                    ToolTip="{Binding LockButtonText, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource LockGlyphSmall}" />
                                                    <TextBlock Text="{Binding LockBadgeText, Mode=OneWay}"
                                                               Style="{StaticResource LockBadgeText}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Prominent control-mode badge: PROFIL vs MANUÁL. -->
                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="7" Padding="7,3"
                                                    Margin="0,0,5,4" VerticalAlignment="Center"
                                                    Visibility="{Binding HasControlMode, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding ControlModeBadge}" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="11.5" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock Text="{Binding KindCompactLabel}" Style="{StaticResource Caption}" FontSize="11.5"
                                                           ToolTip="{Binding KindLabel}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- ===== Stav: pripojenie + čo zariadenie práve robí =====
                                             Boxed like the live values below it: loose lines under the badges
                                             read as leftovers, a framed block reads as "toto je stav". -->
                                        <Border Style="{StaticResource Section}" Margin="0,10,0,0" Padding="11,8">
                                          <StackPanel>
                                          <StackPanel Orientation="Horizontal">
                                              <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                       Fill="{Binding IsConnected, Converter={StaticResource BoolToBrush}}" />
                                              <TextBlock Text="{Binding ConnectionState}" Margin="8,0,0,0" Style="{StaticResource Caption}" />
                                          </StackPanel>
                                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                              <TextBlock Text="IP:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                              <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Caption}"
                                                         Margin="5,0,0,0" VerticalAlignment="Center" />
                                              <Button Content="WWW ↗" Style="{StaticResource GhostButton}"
                                                      Margin="7,0,0,0" Padding="7,2" FontSize="11.5"
                                                      Command="{Binding OpenDeviceWebCommand}"
                                                      ToolTip="Otvoriť webové rozhranie zariadenia v predvolenom prehliadači." />
                                          </StackPanel>
                                          <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource Caption}"
                                                     Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                          <!-- SIKA Remote Control: shown for every SIKA device, green when the bath
                                               accepts remote writes and orange when it does not, so the operator never
                                               has to guess why a set point "did nothing". -->
                                          <StackPanel Margin="0,4,0,0" Orientation="Horizontal"
                                                      Visibility="{Binding ShowSikaRemoteControl, Converter={StaticResource BoolToVisibility}}">
                                              <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                                  <Ellipse.Style>
                                                      <Style TargetType="Ellipse">
                                                          <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding IsSikaRemoteControlOn}" Value="False">
                                                                  <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                              </DataTrigger>
                                                          </Style.Triggers>
                                                      </Style>
                                                  </Ellipse.Style>
                                              </Ellipse>
                                              <TextBlock Text="{Binding SikaRemoteControlStatus}" Margin="7,0,0,0"
                                                         FontFamily="Segoe UI Semibold" FontSize="12" TextWrapping="Wrap">
                                                  <TextBlock.Style>
                                                      <Style TargetType="TextBlock">
                                                          <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding IsSikaRemoteControlOn}" Value="False">
                                                                  <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                              </DataTrigger>
                                                          </Style.Triggers>
                                                      </Style>
                                                  </TextBlock.Style>
                                              </TextBlock>
                                              <Button Content="⇅ Zapnúť cez sieť" Style="{StaticResource GhostButton}"
                                                      Margin="10,0,0,0" Padding="8,2" FontSize="11"
                                                      Command="{Binding ForceSikaRemoteControlCommand}"
                                                      Visibility="{Binding IsSikaRemoteControlOn, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                      ToolTip="Skúsi zapnúť Remote Control priamo cez sieť (Com_ExternWriteFlag = 1). Niektoré firmvéry to dovolia len z displeja prístroja – výsledok sa overí spätným čítaním." />
                                          </StackPanel>
                                          </StackPanel>
                                        </Border>


                                        <!-- Completion (day + time + countdown) right under the profile name. -->
                                        <TextBlock Text="{Binding ProfileCompletionText}" FontFamily="Segoe UI Semibold" FontSize="12.5"
                                                   Foreground="{StaticResource OkBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasProfileCompletion, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="Predpokladané dokončenie profilu (deň, dátum a čas) a zostávajúci čas." />
                                        <!-- Slim progress bar right at the top of the device card while a profile runs. -->
                                        <Grid Margin="0,6,0,0"
                                              Visibility="{Binding IsProfileRunning, Converter={StaticResource BoolToVisibility}}">
                                            <ProgressBar Style="{StaticResource ProfileProgressBar}" Height="12"
                                                         Value="{Binding ProfileProgress, Mode=OneWay}" Maximum="100" />
                                            <TextBlock Text="{Binding ProfileProgress, StringFormat={}{0:0} %, Mode=OneWay}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Semibold" FontSize="10" Foreground="White" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- ===== ② Live values + range =====
                                     Full card width, under the graphic and the header column both: kept
                                     inside the text column it started level with the device name and left
                                     an empty block of card beside the chamber picture. -->
                                <Border Style="{StaticResource Section}" Margin="0,0,0,10" Padding="11,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- The tooltip carries the frame the number was parsed from: when a
                                                 value looks wrong or coarser than the chamber's own display, the
                                                 answer is in what the controller actually sent. -->
                                            <Border Style="{StaticResource DashboardMetricTile}"
                                                    ToolTip="{Binding LastRaw, Mode=OneWay, StringFormat=Odpoveď komory (RAW): {0}}">
                                                <StackPanel>
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                <Setter Property="Text" Value="Teplota komory" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SupportsHumidity}" Value="True">
                                                                        <Setter Property="Text" Value="Teplota" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource MetricSmall}" Foreground="{StaticResource TemperatureBrush}"
                                                                   Text="{Binding MeasuredTemperature, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0###}" />
                                                        <TextBlock Text="°C" VerticalAlignment="Bottom" Margin="4,0,0,2" FontSize="15"
                                                                   FontFamily="Segoe UI Semibold" Foreground="{StaticResource TemperatureBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashboardMetricTile}">
                                                <StackPanel>
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                <Setter Property="Text" Value="Nastavená (setpoint)" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SupportsHumidity}" Value="True">
                                                                        <Setter Property="Text" Value="Setpoint" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource MetricSub}" Foreground="{StaticResource TemperatureSetpointBrush}"
                                                                   Text="{Binding MeasuredTemperatureSetpoint, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0###}" />
                                                        <TextBlock Text="°C" VerticalAlignment="Bottom" Margin="4,0,0,2" FontSize="15"
                                                                   FontFamily="Segoe UI Semibold" Foreground="{StaticResource TemperatureSetpointBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashboardMetricTile}"
                                                    Visibility="{Binding SupportsHumidity, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="Vlhkosť" Style="{StaticResource Caption}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource MetricSmall}" Foreground="{StaticResource HumidityBrush}"
                                                                   Text="{Binding MeasuredHumidity, Converter={StaticResource ValueOrDash}, ConverterParameter=0.0###}" />
                                                        <TextBlock Text="%" VerticalAlignment="Bottom" Margin="4,0,0,2" FontSize="15"
                                                                   FontFamily="Segoe UI Semibold" Foreground="{StaticResource HumidityBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,0" TextWrapping="Wrap">
                                            <Run Text="Rozsah: " Foreground="{StaticResource MutedBrush}" />
                                            <Run Text="{Binding RangeLabel, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Control panels: disabled (greyed) while the device is locked, so a running
                                     profile / temperature can't be changed by an accidental press. Readouts above
                                     stay bright; the lock toggle lives in the top bar (always enabled). -->
                                <StackPanel IsEnabled="{Binding IsUnlocked}">

                                <!-- ===== ⑤ Quick control (manual) =====
                                     Manual and profile control are mutually exclusive: while a profile
                                     runs the manual panel is greyed out so nobody overwrites the running
                                     set point, and while the chamber is driven manually the profile panel
                                     below is greyed out until the manual run is stopped. -->
                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="Manuálne ovládanie je vypnuté, kým beží profil. Profil zastavíš tlačidlom ⏹ nižšie."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,7"
                                                   Foreground="{StaticResource WarnBrush}"
                                                   Visibility="{Binding IsProfileRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                            <TextBlock Text="Rýchle ovládanie" Style="{StaticResource Label}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Content="✎ Upraviť predvoľby" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" FontSize="12" Margin="0" Command="{Binding ToggleEditPresetsCommand}"
                                                    Visibility="{Binding IsManageAllowed, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Admin: uprav teploty rýchleho ovládania pre toto zariadenie." />
                                        </DockPanel>

                                        <!-- Admin preset editor -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsEditingPresets, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Text="{Binding QuickPresetsText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Teploty oddelené čiarkou, najviac štyri – napr. 60, 105, 150, 250" />
                                            <TextBlock Text="Teploty oddeľ čiarkou (1–4 hodnoty). Uloží sa po opustení poľa." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- The whole quick-control strip on one line. A Grid, not a DockPanel
                                             with a wrapping panel: the presets used to be the flexible part and
                                             wrapped to a second row whenever the fixed controls took more than
                                             their share. Now the row has three deterministic columns – four
                                             equal preset slots (the card never shows more, see
                                             ChamberViewModel.MaxQuickPresets), the custom set point, and the two
                                             actions – so nothing can wrap or clip. -->
                                        <StackPanel IsEnabled="{Binding IsManualControlEnabled}" Margin="0,10,0,0">
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding QuickPresets}"
                                                                  Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <!-- Exactly four equal slots in a 2x2 block. The card is
                                                                     470 px so three fit side by side; four chips in a
                                                                     single line would leave no room for the set point and
                                                                     the actions on the same row. -->
                                                                <UniformGrid Rows="2" Columns="2" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource PresetChip}" Margin="0,0,5,4"
                                                                        MinWidth="0" Padding="6,5" FontSize="12"
                                                                        Content="{Binding}" ContentStringFormat="{}{0:0.#} °C"
                                                                        ToolTip="Klikni = nastav túto teplotu a zapni komoru"
                                                                        Command="{Binding DataContext.QuickSetTemperatureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Wide enough for a four-character value ("-100"). -->
                                                        <views:NumericStepper Width="80" VerticalAlignment="Center"
                                                                              Value="{Binding QuickTemperature, Mode=TwoWay}" Step="1"
                                                                              ToolTip="Vlastná teplota v °C – šípkami ▲▼ meníš po 1 °C, potom stlač Nastaviť." />
                                                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,10,0"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                                                Height="34" Padding="8,0" FontSize="12.5"
                                                                VerticalAlignment="Center" Command="{Binding QuickSetTemperatureCommand}"
                                                                ToolTip="Zapíše zadanú vlastnú teplotu do komory a zapne reguláciu.">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                                                      Data="{StaticResource Icon.Thermometer}" />
                                                                <TextBlock Text="Nastaviť" Style="{StaticResource IconLabel}" Margin="5,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource DangerButton}" Margin="0"
                                                                Height="34" Padding="8,0" FontSize="12.5"
                                                                VerticalAlignment="Center" Command="{Binding StopChamberCommand}"
                                                                ToolTip="Vypnúť komoru (zastaví reguláciu).">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                                                      Data="{StaticResource Icon.Power}" />
                                                                <TextBlock Text="Stop" Style="{StaticResource IconLabel}" Margin="5,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Action feedback banner: pops up after an action so the operator
                                             always sees what happened / what was switched on. Auto-clears. -->
                                        <Border Margin="0,8,0,0" CornerRadius="8" Padding="11,8"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                Visibility="{Binding HasActionInfo, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding ActionInfo}" Foreground="{StaticResource TextBrush}"
                                                       FontFamily="Segoe UI Semibold" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ===== ④ Test profile: picker + play/pause/stop + preview ===== -->
                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="Testovací profil" Style="{StaticResource Label}"
                                                       VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Content="✕ Zrušiť profil" Style="{StaticResource GhostButton}"
                                                    VerticalAlignment="Center" Margin="0" Padding="10,3" FontSize="12"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding CancelProfileCommand}"
                                                    ToolTip="Zastaví spustený profil (ak beží) a odoberie ho z karty, aby nezostal svietiť ako testovací profil." />
                                        </DockPanel>

                                        <!-- Prerušený beh profilu – kompaktná ponuka pokračovania na karte. -->
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarnBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                                                Visibility="{Binding HasInterruptedRun, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding InterruptedRunInfo}" TextWrapping="Wrap"
                                                           FontFamily="Segoe UI Semibold" FontSize="12"
                                                           Foreground="{StaticResource WarnBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="▶ Pokračovať" Style="{StaticResource AccentButton}" Margin="0" Height="30"
                                                            Command="{Binding ResumeInterruptedRunCommand}"
                                                            ToolTip="Pokračuje v prerušenom profile od miesta prerušenia." />
                                                    <Button Content="✕ Zahodiť" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="30"
                                                            Command="{Binding DiscardInterruptedRunCommand}"
                                                            ToolTip="Zahodí uložený bod prerušenia." />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <!-- Hint shown while the chamber is being driven by hand: the profile
                                             controls stay greyed out until the manual run is stopped. -->
                                        <TextBlock Text="Zariadenie je ovládané manuálne. Profil spustíš až po zastavení manuálneho behu (tlačidlo Stop v „Rýchle ovládanie“)."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,7"
                                                   Foreground="{StaticResource WarnBrush}"
                                                   Visibility="{Binding IsManualActive, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- The picker gets the full card width on its own row: profile names are
                                             long and used to be squeezed next to the four run buttons. -->
                                        <StackPanel IsEnabled="{Binding IsProfileControlEnabled}">
                                            <views:ProfilePicker HorizontalAlignment="Stretch"
                                                                 ItemsSource="{Binding History}"
                                                                 SelectedProfile="{Binding SelectedHistoryProfile, Mode=TwoWay}"
                                                                 ToolTip="Vyber uložený profil – hľadaj hore a rozbaľ stromovú štruktúru (zákazník/snímač → profily), potom spusti tlačidlom ▶.&#10;V zozname sú len profily pre tento typ zariadenia (Vötsch / SIKA)." />

                                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                    <Button Style="{StaticResource TransportButton}"
                                                            Foreground="{StaticResource OkBrush}" Command="{Binding StartSelectedProfileCommand}"
                                                            ToolTip="Spustiť vybraný profil">
                                                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource Icon.Play}" />
                                                    </Button>
                                                    <Button Style="{StaticResource TransportButton}"
                                                            Foreground="{StaticResource WarnBrush}" Command="{Binding PauseResumeProfileCommand}"
                                                            ToolTip="Pozastaviť / pokračovať">
                                                        <Path>
                                                            <Path.Style>
                                                                <Style TargetType="Path" BasedOn="{StaticResource TransportIcon}">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Pause}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsProfilePaused}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource Icon.Play}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Button>
                                                    <Button Style="{StaticResource TransportButton}"
                                                            Foreground="{StaticResource AccentBrush}" Command="{Binding SkipHoldCommand}"
                                                            ToolTip="Ukončiť aktuálne plato a pokračovať na ďalší nábeh a plato. Zvyšok profilu zostáva nezmenený; počas nábehu je tlačidlo neaktívne.">
                                                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource Icon.SkipNext}" />
                                                    </Button>
                                                    <Button Style="{StaticResource TransportButton}" Margin="0"
                                                            Foreground="{StaticResource ErrorBrush}" Command="{Binding StopProfileCommand}"
                                                            ToolTip="Zastaviť profil – čas aj graf sa vynulujú">
                                                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource Icon.Stop}" />
                                                    </Button>
                                                </StackPanel>
                                                <!-- Počet cyklov sits with the run controls it belongs to; the field
                                                     only ever holds a single digit, so it needs no more room. -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Počet cyklov" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                    <views:NumericStepper Value="{Binding Cycles, Mode=TwoWay}" Step="1" Minimum="1" Maximum="9"
                                                                          Width="64" Margin="8,0,0,0"
                                                                          ToolTip="Zopakuje iba telo profilu 1–9×. Počiatočný nábeh a koncový dobeh (nábeh/dobeh na krajné teploty) prebehnú len raz. Cyklovaná časť je na grafe nižšie zvýraznená." />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="6,4" Margin="0,10,0,0"
                                                Visibility="{Binding HasProfilePreview, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="4,2,0,4">
                                                    <TextBlock Text="Graf profilu · koliesko = priblíženie" Style="{StaticResource Caption}"
                                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="Prejdi myšou po krivke – ukáže teplotu a čas v danom bode, či ide o rampu (nábeh) alebo výdrž (plato) a ako dlho ten krok trvá; celý krok sa v grafe zvýrazní.&#10;Priblíženie: tlačidlá ＋ / － / ⤢ vpravo dole v grafe, alebo koliesko myši okolo kurzora. Pri priblížení: Shift+koliesko alebo ťahanie posúva časovú os, prúžok (mini-mapa) pod grafom sa dá chytiť a ťahať, dvojklik vráti celý rozsah.&#10;Podfarbené stĺpce = výdrž. Pri cyklovaní je každé opakovanie tela profilu zvlášť podfarbené a očíslované (⟲ 2/4)." />
                                                    <Button DockPanel.Dock="Right" Content="⛶ Zväčšiť" Style="{StaticResource GhostButton}"
                                                            Padding="9,3" FontSize="13" Click="MaximizeChart_Click"
                                                            ToolTip="Zväčšiť graf profilu na celú obrazovku (zavrieš ✕ alebo klávesom Esc)." />
                                                </DockPanel>
                                                <views:ChartView Height="210" Unit=" °C" Series="{Binding ProfilePreview}" EmptyText="Vyber profil"
                                                                 ShowStages="True"
                                                                 CycleStartX="{Binding PreviewCycleStartX}"
                                                                 CycleEndX="{Binding PreviewCycleEndX}"
                                                                 CycleCount="{Binding PreviewCycleCount}" />
                                                <StackPanel Visibility="{Binding IsProfileRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                                    <Grid>
                                                        <ProgressBar Style="{StaticResource ProfileProgressBar}"
                                                                     Value="{Binding ProfileProgress, Mode=OneWay}" Maximum="100" />
                                                        <TextBlock Text="{Binding ProfileProgress, StringFormat={}{0:0} %, Mode=OneWay}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Semibold" FontSize="11" Foreground="White" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProfileStepText}" FontFamily="Segoe UI Semibold" FontSize="13"
                                                               Foreground="{StaticResource AccentBrush}" Margin="0,7,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding HasProfileStep, Converter={StaticResource BoolToVisibility}}"
                                                               ToolTip="Aktuálny krok profilu: nábeh (rampa) alebo výdrž (plato), jeho celkové trvanie a čas do konca kroku." />
                                                    <TextBlock Text="{Binding ProfileTimeRemaining}" FontFamily="Segoe UI Semibold" FontSize="16"
                                                               Foreground="{StaticResource TextBrush}" Margin="0,7,0,0" />
                                                    <TextBlock Text="{Binding ProfileScheduleText}" Style="{StaticResource Caption}"
                                                               Margin="0,2,0,0" FontFamily="Segoe UI Semibold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource Caption}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Rarely used run options, folded away at the very bottom: they used to sit
                                             between the profile picker and the chart and pushed everything the operator
                                             actually watches off the card. -->
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12"
                                                Content="{Binding AdvancedProfileOptionsGlyph}"
                                                Command="{Binding ToggleAdvancedProfileOptionsCommand}"
                                                ToolTip="Rozbalí rad profilov (až 3 profily za sebou) a odložený štart." />
                                        <StackPanel Visibility="{Binding ShowAdvancedProfileOptions, Converter={StaticResource BoolToVisibility}}"
                                                    IsEnabled="{Binding IsProfileControlEnabled}">
                                        <!-- Rad profilov: až 3 uložené profily spustené za sebou -->
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Caption}">
                                                        <Run Text="Rad profilov " /><Run Text="{Binding ChainCountText, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                                                    </TextBlock>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="＋ Pridať do radu" Style="{StaticResource GhostButton}" Padding="9,3"
                                                                Command="{Binding AddToChainCommand}"
                                                                ToolTip="Pridá profil vybraný v zozname vyššie na koniec radu (max 3 profily za sebou)." />
                                                        <Button Content="▶ Spustiť rad" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="12,4"
                                                                Command="{Binding StartChainCommand}"
                                                                ToolTip="Spustí profily v rade za sebou, v poradí zľava doprava." />
                                                    </StackPanel>
                                                </DockPanel>

                                                <ItemsControl ItemsSource="{Binding ProfileChain}" Margin="0,8,0,0"
                                                              Visibility="{Binding HasChainedProfiles, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="10,5" Margin="0,0,7,7">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock VerticalAlignment="Center" TextTrimming="None">
                                                                        <Run Text="▸ " Foreground="{StaticResource OkBrush}" FontFamily="Segoe UI Semibold" /><Run Text="{Binding Name, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <Button Content="✕" Style="{StaticResource GhostButton}" Padding="7,0" Margin="7,0,0,0"
                                                                            Foreground="{StaticResource DangerBrush}"
                                                                            Command="{Binding DataContext.RemoveFromChainCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Odobrať z radu" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="{Binding ChainDurationText}"
                                                           Visibility="{Binding HasChainedProfiles, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Vyber profil v zozname vyššie a pridaj ho do radu – profily pobežia za sebou (max 3)." />
                                            </StackPanel>
                                        </Border>
                                        <!-- Odložený štart (pre toto zariadenie): keď je zapnuté, spustenie profilu sa naplánuje -->
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                            <StackPanel>
                                                <CheckBox Content="Odložený štart" IsChecked="{Binding UseDelayedStart}"
                                                          ToolTip="Keď je zapnuté, spustenie profilu (▶ alebo rýchle tlačidlo) sa naplánuje na zadaný dátum a čas." />
                                                <!-- Keep the fields IsEnabled=true (dim via Opacity + block hit-testing when
                                                     the checkbox is off) so the NumericStepper's custom-templated TextBox always
                                                     renders its value; a control that starts inside a disabled subtree shows blank
                                                     text until focused, which is why the hour/minute used to look empty. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UseDelayedStart}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Dátum" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <DatePicker Width="140" VerticalAlignment="Center"
                                                                SelectedDate="{Binding ScheduledStartDate, Mode=TwoWay}"
                                                                ToolTip="Vyber dátum z kalendára." />
                                                    <TextBlock Text="Čas" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,6,0" />
                                                    <views:NumericStepper Width="74" VerticalAlignment="Center"
                                                                          Value="{Binding ScheduledStartHour, Mode=TwoWay}" Step="1" Minimum="0" Maximum="23"
                                                                          ToolTip="Hodina (0–23)" />
                                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{StaticResource MutedBrush}" />
                                                    <views:NumericStepper Width="74" VerticalAlignment="Center"
                                                                          Value="{Binding ScheduledStartMinute, Mode=TwoWay}" Step="1" Minimum="0" Maximum="59"
                                                                          ToolTip="Minúta (0–59)" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ProfileScheduleText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding UseDelayedStart, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                                <!-- Pripojenie (IP/port), referenčný teplomer, odobratie a premenovanie
                                     zariadenia sú v obrazovke „Nastaviť / ovládať →" (hore na karte). -->
                            </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- ===== Professional dashboard ===== -->
    <views:ProfessionalHomeView Visibility="{Binding IsProfessionalMode, Converter={StaticResource BoolToVisibility}}" />

    </Grid>
</UserControl>
